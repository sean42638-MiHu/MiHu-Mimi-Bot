NODE_ENV=production
APP_ENV=production
# Set MIHU_RUNTIME_ROLE=web or bot in the individual service env file; omit from a shared Web/Bot env file.
PORT=3000
WEB_LISTEN_HOST=127.0.0.1
PUBLIC_BASE_URL=
TRUST_PROXY_HOPS=
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=
PRODUCTION_DATA_DIR=/var/lib/mihu/data
SQLITE_BUSY_TIMEOUT_MS=5000
# Platform break-glass principal; defaults to the existing platform user ID.
PLATFORM_SUPERUSER_ID=
# Set only after verifying the Production runtime and persistent database storage externally.
PRODUCTION_IDENTITY_VERIFIED=NO
PRODUCTION_STORAGE_VERIFIED=NO
# One-command confirmations; never place these in a committed Production env file.
PRODUCTION_PREFLIGHT_CONFIRM=
PRODUCTION_WRITES_DISABLED=NO
MIGRATION_CONFIRM=
MIGRATION_BACKUP_MANIFEST=
BACKUP_CONFIRM=
BACKUP_STORAGE_VERIFIED=NO
DATABASE_BACKUP_DIR=
RESTORE_CONFIRM=
RESTORE_BACKUP_MANIFEST=
PRE_RESTORE_BACKUP_MANIFEST=
# Generate a 32-byte key in a secret provider (for example: openssl rand -base64 32).
# Startup fails closed if existing payroll PII is present and this key is missing/invalid.
PAYROLL_DATA_ENCRYPTION_KEY=

DISCORD_ENABLED=false
DISCORD_COMMAND_REGISTRATION_ENABLED=false
DISCORD_COMMAND_CLEAR_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=
GUILD_MAIN_ID=
GUILD_STAFF_ID=
GUILD_REVIEW_ID=
GUILD_DEV_ID=
DEV_MANAGER_DISCORD_ID=
DEV_STAFF_DISCORD_ID=
DEV_MEMBER_DISCORD_ID=
DEV_STAFF_CHANNEL_ID=
DEV_MEMBER_STARTING_BALANCE=100000

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
