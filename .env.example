NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=
# Generate a 32-byte key in a secret provider (for example: openssl rand -base64 32).
# Startup fails closed if existing payroll PII is present and this key is missing/invalid.
PAYROLL_DATA_ENCRYPTION_KEY=

DISCORD_ENABLED=false
DISCORD_COMMAND_REGISTRATION_ENABLED=false
DISCORD_COMMAND_CLEAR_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
GUILD_MAIN_ID=
GUILD_STAFF_ID=
GUILD_DEV_ID=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
