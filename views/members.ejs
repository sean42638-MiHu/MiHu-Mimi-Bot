<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>會員管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        img { max-width: 100%; height: auto; }

        /* 🚀 右側主內容區域自適應寬度 */
        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            min-width: 0;
        }

        .content-body { 
            padding: 20px 36px 32px; 
            flex-grow: 1; 
        }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 14px;
            width: 100%;
        }

        .page-title-text {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
        }

        .search-box-wrap {
            position: relative;
            width: 280px;
            flex-shrink: 0;
        }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
            transition: all 0.2s ease;
        }
        .search-input-glass::placeholder { color: #94a3b8 !important; }
        .search-input-glass:focus {
            background-color: #171326 !important;
            color: #ffffff !important;
            border-color: var(--mihu-purple-light);
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }
        .search-icon-left {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.88rem;
            pointer-events: none;
        }
        .search-clear-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.82rem;
            cursor: pointer;
            display: none;
            border: none;
            background: transparent;
            padding: 0;
        }
        .search-clear-btn:hover { color: #ffffff; }

        .glass-table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(15px);
        }

        .action-btns-group {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }
        .btn-circle-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            font-size: 0.88rem;
            transition: all 0.2s ease;
        }
        .btn-circle-icon:hover { transform: scale(1.08); }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97) !important;
            border: 1px solid rgba(168, 85, 247, 0.35) !important;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25) !important;
            backdrop-filter: blur(25px);
            color: #fff !important;
        }
        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.18) !important;
            color: #ffffff !important;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.95rem;
            font-weight: 600;
        }
        .form-control-glass::placeholder { color: #94a3b8 !important; }
        .form-control-glass:focus {
            background-color: #171326 !important;
            color: #ffffff !important;
            border-color: #c084fc !important;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3) !important;
            outline: none !important;
        }

        .info-detail-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .info-detail-label { font-size: 0.74rem; color: #94a3b8; margin-bottom: 4px; }
        .info-detail-val { font-size: 0.95rem; font-weight: 700; color: #ffffff; font-family: monospace; }
    </style>
</head>
<body>

<div class="app-layout">

<!-- 🚀 1. 引入側邊欄 (Sidebar) -->
<%- include('partials/sidebar', { activePage: 'members' }) %>

<div class="main-wrapper">
    <!-- 🚀 2. 引入頂部導覽列 (Navbar) -->
    <%- include('partials/navbar', { activePage: 'members' }) %>

    <div class="content-body admin-page-content">
        <div class="page-header-content">
            <div>
                <div class="page-title-text">
                    <i class="fa-solid fa-users text-info"></i>
                    <span>會員管理</span>
                </div>
                <p class="text-secondary small mb-0">管理工作室註冊會員資產、進行手動帳務調帳與全後台 VIP 身分同步</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="memberSearchInput" class="search-input-glass" placeholder="搜尋暱稱 / Discord / ID...">
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

            </div>
        </div>

        <div id="flashStatus" 
             data-success="<%= typeof success !== 'undefined' && success ? '1' : '0' %>"
               data-warning="<%= typeof warningMsg !== 'undefined' && warningMsg ? warningMsg : '' %>"
             data-error="<%= typeof errorMsg !== 'undefined' && errorMsg ? errorMsg : '' %>"
             style="display:none;"></div>

        <!-- 📊 3. 獨立模組：會員清單表格 -->
        <%- include('partials/members_table', { members: members, userPerms: typeof userPerms !== 'undefined' ? userPerms : [], currentUser: typeof currentUser !== 'undefined' ? currentUser : null }) %>
    </div>
</div>
</div>

<!-- 🚀 4. 獨立模組：會員相關 Modal 群組 -->
<%- include('modals/member_modals') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const roleBadgeConfig = Object.freeze(<%- JSON.stringify({
            classMap: typeof roleBadgeClassMap !== 'undefined' ? roleBadgeClassMap : {},
            inlineStyleMap: typeof roleBadgeInlineStyleMap !== 'undefined' ? roleBadgeInlineStyleMap : {},
            defaultInlineStyle: typeof roleBadgeDefaultInlineStyle !== 'undefined' ? roleBadgeDefaultInlineStyle : ''
        }).replace(/</g, "\\u003c") %>);
        const ROLE_BADGE_CLASS_MAP = Object.freeze(roleBadgeConfig.classMap || {});
        const ROLE_BADGE_INLINE_STYLE_MAP = Object.freeze(roleBadgeConfig.inlineStyleMap || {});
        const ROLE_BADGE_DEFAULT_INLINE_STYLE = String(roleBadgeConfig.defaultInlineStyle || '');
        const DEFAULT_ROLE_BADGE_CLASS = 'role-badge role-badge-default';

        function resolveRoleBadgeClass(roleKey) {
            const key = String(roleKey || '').trim().toLowerCase();
            return ROLE_BADGE_CLASS_MAP[key] || DEFAULT_ROLE_BADGE_CLASS;
        }

        function resolveRoleBadgeInlineStyle(roleKey) {
            const key = String(roleKey || '').trim().toLowerCase();
            return ROLE_BADGE_INLINE_STYLE_MAP[key] || ROLE_BADGE_DEFAULT_INLINE_STYLE;
        }

        function applyRoleBadge(element, roleKey, roleName) {
            if (!element) return;
            element.className = resolveRoleBadgeClass(roleKey);
            element.setAttribute('style', resolveRoleBadgeInlineStyle(roleKey));
            const safeName = String(roleName || '會員');
            element.textContent = safeName;
            element.title = safeName;
        }

        const memberDetailModalEl = document.getElementById('memberDetailModal');
        const adjustBalanceModalEl = document.getElementById('adjustBalanceModal');
        const vipModalEl = document.getElementById('vipModal');
        const notifyModalEl = document.getElementById('notifyModal');
        const negativeErrorModalEl = document.getElementById('negativeErrorModal');

        const memberDetailModal = memberDetailModalEl ? bootstrap.Modal.getOrCreateInstance(memberDetailModalEl) : null;
        const adjustBalanceModal = adjustBalanceModalEl ? bootstrap.Modal.getOrCreateInstance(adjustBalanceModalEl) : null;
        const vipModal = vipModalEl ? bootstrap.Modal.getOrCreateInstance(vipModalEl) : null;
        const notifyModal = notifyModalEl ? bootstrap.Modal.getOrCreateInstance(notifyModalEl) : null;
        const negativeErrorModal = negativeErrorModalEl ? bootstrap.Modal.getOrCreateInstance(negativeErrorModalEl) : null;

        window.currentMemberBalance = 0;
        window.currentMemberBonus = 0;

        function generateBalanceOperationId() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                return `mba_${window.crypto.randomUUID().replace(/-/g, '')}`;
            }
            return `mba_${Date.now()}_${Math.random().toString(16).slice(2, 14)}`;
        }

        function showMemberDetail(data) {
            if (!data) return;
            document.getElementById('detailAvatar').src = data.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png';
            document.getElementById('detailDisplayName').textContent = data.displayName || '--';
            const detailRoleBadge = document.getElementById('detailRoleBadge');
            applyRoleBadge(detailRoleBadge, data.roleKey, data.roleName || '會員');
            document.getElementById('detailUsername').textContent = `@${data.username || ''}`;
            document.getElementById('detailId').textContent = `ID: ${data.id || ''}`;
            document.getElementById('detailVip').textContent = `VIP ${data.vip !== undefined ? data.vip : 0}`;
            
            // 🚀 關鍵修復：精準對齊後端傳來的 manual_spent 與 manual_deposited
            document.getElementById('detailTotalBalance').textContent = `$${Number(data.total_balance || data.totalBalance || 0).toLocaleString()} NTD`;
            document.getElementById('detailSpent').textContent = `$${Number(data.manual_spent || 0).toLocaleString()} NTD`;
            document.getElementById('detailDeposited').textContent = `$${Number(data.manual_deposited || 0).toLocaleString()} NTD`;
            
            document.getElementById('detailVipGap').textContent = data.vipGap || '已達頂級';
            document.getElementById('detailBirthday').textContent = data.birthday || '未填寫';
            document.getElementById('detailCreatedAt').textContent = String(data.createdAt || '').slice(0, 16);
            if (memberDetailModal) memberDetailModal.show();
        }

        // 🚀 關鍵修復：帳務 Modal 開啟時，絕不預填 value，並將提示 Placeholder 綁定至 manual 變數！
        function showBalanceEdit(data) {
            if (!data) return;
            
            window.currentMemberBalance = Number(data.balance || 0);
            window.currentMemberBonus = Number(data.bonus_balance || data.bonus || 0);

            const form = document.getElementById('adjustBalanceForm');
            if (form) form.action = `/management/members/update-balance/${data.id}`;

            const nameEl = document.getElementById('balanceTargetName');
            if (nameEl) nameEl.textContent = data.displayName || '--';

            // 寫入隱藏欄位作為後端加減基底
            const hiddenBal = document.getElementById('hiddenCurrentBalance');
            if (hiddenBal) hiddenBal.value = window.currentMemberBalance;
            const hiddenBonus = document.getElementById('hiddenCurrentBonus');
            if (hiddenBonus) hiddenBonus.value = window.currentMemberBonus;

            const currentBalanceText = document.getElementById('modalCurrentBalanceText');
            if (currentBalanceText) currentBalanceText.textContent = `$${window.currentMemberBalance.toLocaleString()}`;
            const currentBonusText = document.getElementById('modalCurrentBonusText');
            if (currentBonusText) currentBonusText.textContent = `$${window.currentMemberBonus.toLocaleString()}`;
            const currentTotalText = document.getElementById('modalCurrentTotalText');
            if (currentTotalText) currentTotalText.textContent = `$${(window.currentMemberBalance + window.currentMemberBonus).toLocaleString()}`;

            const operationIdInput = document.getElementById('balanceOperationId');
            if (operationIdInput) operationIdInput.value = generateBalanceOperationId();

            // 🚨 清空欄位！防填入舊資料導致覆蓋
            document.getElementById('modalAddAmount').value = '';
            document.getElementById('modalBonusBalance').value = '';
            document.getElementById('modalBalance').value = ''; 
            
            const modalSpentInput = document.getElementById('modalSpent');
            modalSpentInput.value = '';
            modalSpentInput.placeholder = `不修改請留空 (目前: $${data.manual_spent || 0})`;

            const modalDepositedInput = document.getElementById('modalDeposited');
            modalDepositedInput.value = '';
            modalDepositedInput.placeholder = `不修改請留空 (目前: $${data.manual_deposited || 0})`;

            if (adjustBalanceModal) adjustBalanceModal.show();
        }

        let roleOptionsRequest = null;
        let roleOptionsRequestId = 0;

        function replaceRoleOptions(select, roles, currentRole) {
            select.replaceChildren();
            roles.forEach(role => {
                const option = document.createElement('option');
                option.value = role.role_key;
                option.textContent = `${role.name || role.role_key} (Lv.${role.tier_level})`;
                select.appendChild(option);
            });
            const currentOption = roles.find(role => role.role_key === currentRole);
            if (!currentOption) {
                const unavailable = document.createElement('option');
                unavailable.value = currentRole;
                unavailable.textContent = `${currentRole || '未知身分'}（已刪除或不可指派）`;
                unavailable.disabled = true;
                unavailable.selected = true;
                select.appendChild(unavailable);
                return false;
            }
            select.value = currentRole;
            return true;
        }

        async function showVipEdit(data) {
            if (!data) return;
            const form = document.getElementById('vipForm');
            if (form) form.action = `/management/members/update-vip/${data.id}`;

            const nameEl = document.getElementById('vipTargetName');
            if (nameEl) nameEl.textContent = data.displayName || '--';

            document.getElementById('inputVipOnly').value = data.vip !== undefined ? data.vip : 0;
            const roleSelect = document.getElementById('inputRoleSelect');
            const submitButton = document.getElementById('submitVipRoleButton');
            const feedback = document.getElementById('roleOptionsFeedback');
            const requestId = ++roleOptionsRequestId;
            if (roleOptionsRequest) roleOptionsRequest.abort();
            roleOptionsRequest = new AbortController();
            roleSelect.replaceChildren(new Option('正在載入身分角色...', ''));
            roleSelect.disabled = true;
            submitButton.disabled = true;
            feedback.textContent = '正在取得最新身分角色...';
            if (vipModal) vipModal.show();
            try {
                const response = await fetch('/management/members/role-options', {
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin',
                    signal: roleOptionsRequest.signal
                });
                const result = await response.json();
                if (requestId !== roleOptionsRequestId) return;
                if (!response.ok || !result.success || !Array.isArray(result.roles)) throw new Error(result.message || '身分角色載入失敗');
                const currentAvailable = replaceRoleOptions(roleSelect, result.roles, data.roleKey || 'member');
                roleSelect.disabled = false;
                submitButton.disabled = !currentAvailable;
                feedback.textContent = currentAvailable ? '' : '目前身分已刪除或不可指派，請選擇可用身分後再提交。';
            } catch (error) {
                if (error.name === 'AbortError' || requestId !== roleOptionsRequestId) return;
                roleSelect.replaceChildren(new Option('身分角色載入失敗', ''));
                roleSelect.disabled = true;
                submitButton.disabled = true;
                feedback.textContent = '無法取得最新身分角色，請稍後再試。';
            }
        }

        document.getElementById('inputRoleSelect')?.addEventListener('change', event => {
            const selected = event.target.selectedOptions[0];
            document.getElementById('submitVipRoleButton').disabled = !selected || selected.disabled || !selected.value;
            document.getElementById('roleOptionsFeedback').textContent = selected && !selected.disabled ? '' : '請選擇可指派的身分角色。';
        });

        document.getElementById('vipForm')?.addEventListener('submit', event => {
            const roleSelect = document.getElementById('inputRoleSelect');
            const selected = roleSelect && roleSelect.selectedOptions[0];
            if (!selected || roleSelect.disabled || selected.disabled || !selected.value) {
                event.preventDefault();
                document.getElementById('roleOptionsFeedback').textContent = '請先取得並選擇可指派的身分角色。';
            }
        });

        // 🚀 帳務表單提交負數防呆攔截 (跳出負數獨立 Modal)
        const adjustForm = document.getElementById('adjustBalanceForm');
        if (adjustForm) {
            adjustForm.addEventListener('submit', function (e) {
                const submitButton = adjustForm.querySelector('button[type="submit"]');
                const operationIdInput = document.getElementById('balanceOperationId');
                const currBalance = Number(window.currentMemberBalance || 0);
                const currBonus = Number(window.currentMemberBonus || 0);

                const addAmountVal = document.getElementById('modalAddAmount').value.trim();
                const bonusChangeVal = document.getElementById('modalBonusBalance').value.trim();
                const directBalanceVal = document.getElementById('modalBalance').value.trim();
                const totalSpentVal = document.getElementById('modalSpent').value.trim();
                const totalDepositedVal = document.getElementById('modalDeposited').value.trim();
                const hasTotalOverride = directBalanceVal !== '';
                const hasAddAmount = addAmountVal !== '';
                const hasBonusChange = bonusChangeVal !== '';

                let finalBalance = currBalance;
                let finalBonus = currBonus;

                if (hasTotalOverride && (hasAddAmount || hasBonusChange)) {
                    e.preventDefault();
                    if (submitButton) submitButton.disabled = false;
                    const errTextEl = document.getElementById('negativeErrorText');
                    if (errTextEl) errTextEl.textContent = '「設定目前總餘額」不可與「本次充值金額」或「贈送金調整」同時輸入，請擇一操作。';
                    if (negativeErrorModal) negativeErrorModal.show();
                    return;
                }

                if (hasTotalOverride) {
                    const targetTotal = Number(directBalanceVal);
                    const currentTotal = currBalance + currBonus;
                    if (targetTotal > currentTotal) {
                        finalBalance = currBalance + (targetTotal - currentTotal);
                        finalBonus = currBonus;
                    } else if (targetTotal < currentTotal) {
                        const needDeduct = currentTotal - targetTotal;
                        const deductBonus = Math.min(currBonus, needDeduct);
                        const remainDeduct = needDeduct - deductBonus;
                        finalBonus = currBonus - deductBonus;
                        finalBalance = currBalance - remainDeduct;
                    }
                } else if (addAmountVal !== '') {
                    finalBalance = currBalance + Number(addAmountVal);
                }

                if (bonusChangeVal !== '') {
                    finalBonus = currBonus + Number(bonusChangeVal);
                }

                let errorMsg = '';
                if (finalBalance < 0) {
                    errorMsg = `當前餘額為 $${currBalance}，扣除後最終餘額為 $${finalBalance}，數目不得為負數！`;
                } else if (finalBonus < 0) {
                    errorMsg = `當前贈送金為 $${currBonus}，扣除後最終贈送金為 $${finalBonus}，數目不得為負數！`;
                } else if (totalSpentVal !== '' && Number(totalSpentVal) < 0) {
                    errorMsg = '「累積消費」不得設定為負數！';
                } else if (totalDepositedVal !== '' && Number(totalDepositedVal) < 0) {
                    errorMsg = '「累積實充」不得設定為負數！';
                }

                if (errorMsg) {
                    e.preventDefault();
                    const errTextEl = document.getElementById('negativeErrorText');
                    if (errTextEl) errTextEl.textContent = errorMsg;
                    if (negativeErrorModal) negativeErrorModal.show();
                    if (submitButton) submitButton.disabled = false;
                    return;
                }

                if (!operationIdInput || !String(operationIdInput.value || '').trim()) {
                    e.preventDefault();
                    if (submitButton) submitButton.disabled = false;
                    const errTextEl = document.getElementById('negativeErrorText');
                    if (errTextEl) errTextEl.textContent = '操作識別遺失，請重新開啟調帳視窗再試。';
                    if (negativeErrorModal) negativeErrorModal.show();
                    return;
                }

                if (submitButton) submitButton.disabled = true;
            });
        }

        // 🚀 操作成功 / 失敗提示彈窗
        const flash = document.getElementById('flashStatus');
        if (flash) {
            const isSuccess = flash.getAttribute('data-success') === '1';
            const warningMsg = flash.getAttribute('data-warning');
            const errorMsg = flash.getAttribute('data-error');

            if (isSuccess && warningMsg && warningMsg.trim() !== '') {
                const icon = document.getElementById('notifyIcon');
                if (icon) icon.className = 'fa-solid fa-triangle-exclamation text-warning fs-1';
                const title = document.getElementById('notifyTitle');
                if (title) title.textContent = '帳務已更新，VIP 待同步';
                const msg = document.getElementById('notifyMessage');
                if (msg) msg.textContent = warningMsg;
                if (notifyModal) notifyModal.show();
            } else if (isSuccess) {
                const icon = document.getElementById('notifyIcon');
                if (icon) icon.className = 'fa-solid fa-circle-check text-success fs-1';
                const title = document.getElementById('notifyTitle');
                if (title) title.textContent = '操作成功';
                const msg = document.getElementById('notifyMessage');
                if (msg) msg.textContent = '會員帳務與全後台身分已成功同步更新！';
                if (notifyModal) notifyModal.show();
            } else if (errorMsg && errorMsg.trim() !== '') {
                const icon = document.getElementById('notifyIcon');
                if (icon) icon.className = 'fa-solid fa-circle-xmark text-danger fs-1';
                const title = document.getElementById('notifyTitle');
                if (title) title.textContent = '操作失敗';
                const msg = document.getElementById('notifyMessage');
                if (msg) msg.textContent = errorMsg;
                if (notifyModal) notifyModal.show();
            }
        }

        // 🚀 關鍵字搜尋與清空邏輯
        const rows = document.querySelectorAll('.member-row');
        const searchInput = document.getElementById('memberSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                if (query.length > 0) {
                    if (clearBtn) clearBtn.style.display = 'block';
                } else {
                    if (clearBtn) clearBtn.style.display = 'none';
                }

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    if (searchData.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    searchInput.value = '';
                    clearBtn.style.display = 'none';
                    rows.forEach(row => row.style.display = '');
                    if (noMatchRow) noMatchRow.style.display = 'none';
                    searchInput.focus();
                });
            }
        }

        // 🚀 表格列與 4 個獨立按鈕觸發監聽 (含 stopPropagation 防誤觸)
        rows.forEach(row => {
            let data = null;
            try {
                data = JSON.parse(row.getAttribute('data-member'));
            } catch (e) {}

            if (!data) return;

            // 點擊整列預設開啟詳細內容 Modal
            row.addEventListener('click', () => {
                showMemberDetail(data);
            });

            // 按鈕 1：詳細內容
            const detailBtn = row.querySelector('.btn-detail-trigger');
            if (detailBtn) {
                detailBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showMemberDetail(data);
                });
            }

            // 按鈕 2：🪙 會員帳務調整
            const balanceBtn = row.querySelector('.btn-balance-trigger');
            if (balanceBtn) {
                balanceBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showBalanceEdit(data);
                });
            }

            // 按鈕 3：👑 手動 VIP 與身分調整
            const vipBtn = row.querySelector('.btn-vip-trigger');
            if (vipBtn) {
                vipBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showVipEdit(data);
                });
            }
        });
    });
</script>
</body>
</html>
