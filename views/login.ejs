<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#090710">
    <title>米胡電競 MiHu Gaming · 後台管理系統</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page-body">
    <div class="login-page">
        <%- include('partials/login_background') %>

        <% if (typeof authTransition !== 'undefined' && authTransition) { %>
            <main class="login-main login-main--transition">
                <%- include('partials/login_transition', { transitionDestination }) %>
            </main>
        <% } else { %>
            <header class="login-topbar">
                <div class="login-brand">
                    <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
                    <span>MiHu Gaming</span>
                </div>
            </header>

            <main class="login-main">
                <div class="login-layout">
                    <%- include('partials/login_hero') %>
                    <%- include('partials/login_card', { error: typeof error !== 'undefined' ? error : null }) %>
                </div>
            </main>

            <footer class="login-footer">MIHU GAMING · 覓狐娛樂工作室 © 2026 ALL RIGHTS RESERVED</footer>
        <% } %>
    </div>
    <script src="/js/login.js" defer></script>
</body>
</html>
