        <section class="glass-table-card admin-panel" aria-labelledby="rolesTableTitle">
            <div class="admin-panel-header">
                <h2 id="rolesTableTitle" class="admin-section-title">角色清單</h2>
                <p class="admin-section-description">管理角色層級與功能權限</p>
            </div>
            <div class="table-responsive roles-scroll-container">
                <table class="mihu-table admin-table">
                    <thead>
                        <tr>
                            <th style="width: 130px;">階級分類</th>
                            <th style="width: 120px;">職位名稱</th>
                            <th style="width: 100px;">權重等級</th>
                            <th>職位職責說明（點擊整行看可見項目清單）</th>
                            <th style="width: 240px; min-width: 220px;" class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%
                            const roleList = (typeof rolesData !== 'undefined' && rolesData) ? rolesData : ((typeof roles !== 'undefined' && roles) ? roles : []);
                            const rolePermissions = role => {
                                try { return typeof role.permissions === 'string' ? JSON.parse(role.permissions) : (role.permissions || []); }
                                catch (error) { return []; }
                            };
                            if (roleList && roleList.length > 0) {
                        %>
                            <% roleList.forEach(r => { %>
                                <% const roleInfo = (typeof getRoleInfo === 'function') ? getRoleInfo(r.role_key) : { badgeClass: 'role-badge role-badge-default' }; %>
                                <tr class="role-row"
                                    data-id="<%= r.id %>"
                                    data-unknown-permissions="<%= JSON.stringify(r.unknownPermissions || {}) %>"
                                    data-rolekey="<%= r.role_key %>"
                                    data-name="<%= r.name %>"
                                    data-category="<%= r.category %>"
                                    data-tier="<%= r.tier_level %>"
                                    data-desc="<%= r.description || '' %>"
                                    data-perms='<%- JSON.stringify(rolePermissions(r)).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>'>
                                    <td>
                                        <div class="category-text-wrap">
                                            <span class="category-dot dot-<%= r.category %>"></span>
                                            <span><%= r.category %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="role-pill-badge <%= roleInfo.badgeClass %>"><%= r.name %></span>
                                    </td>
                                    <td><span class="font-monospace text-warning fw-bold small">Lv.<%= r.tier_level %></span></td>
                                    <td>
                                        <span class="text-light"><%= r.description || '無特別說明' %></span>
                                    </td>
                                    <td class="text-end" onclick="event.stopPropagation();">
                                        <% if (hasPerm('action_role_manage') && r.canManageRole) { %>
                                        <div class="action-btns-group">
                                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill action-btn-clean btn-edit-info">
                                                <i class="fa-solid fa-user-pen me-1"></i>編輯資料
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill action-btn-clean text-white fw-semibold btn-edit-perms" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                                                <i class="fa-solid fa-lock-open me-1"></i>編輯權限
                                            </button>
                                            <form method="POST" action="/system/roles/delete/<%= r.id %>" data-admin-confirm data-confirm-title="刪除身分組" data-confirm-message="確定要刪除「<%= r.name %>」嗎？仍有使用者的身分不允許刪除。" data-confirm-confirm-text="刪除" data-confirm-variant="danger">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill action-btn-clean"><i class="fa-solid fa-trash me-1"></i>刪除</button>
                                            </form>
                                        </div>
                                        <% } else if (hasPerm('action_role_manage')) { %>
                                            <span class="admin-badge admin-badge-muted"><%= r.roleProtectionMessage %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5">
                                    <div class="admin-empty-state">
                                        <div class="admin-empty-state__icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
                                        <p class="admin-empty-state__title">目前沒有角色</p>
                                        <p class="admin-empty-state__description">建立第一個角色後，便能設定角色層級與功能權限。</p>
                                        <% if (hasPerm('action_role_manage')) { %><button type="button" class="admin-btn admin-btn-primary admin-empty-state__action" data-bs-toggle="modal" data-bs-target="#addRoleModal">新增角色</button><% } %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
