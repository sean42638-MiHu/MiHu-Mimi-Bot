<%
    const fallbackVipColor = '#A855F7';
    const cardMode = ['default', 'compact', 'preview'].includes(typeof mode === 'string' ? mode : '') ? mode : 'default';
    const cardUser = cardMode === 'preview' ? {} : (typeof user !== 'undefined' && user ? user : {});
    const sourceVipInfo = typeof vipInfo !== 'undefined' && vipInfo && typeof vipInfo === 'object' ? vipInfo : {};
    const rawLevel = sourceVipInfo.level ?? cardUser.vip_level ?? 1;
    const levelText = String(rawLevel ?? '').trim();
    const levelMatch = levelText.match(/^(?:VIP\s*)?(\d+)$/i);
    const parsedLevel = levelMatch ? Number(levelMatch[1]) : Number(levelText);
    const numericVipLevel = Number.isSafeInteger(parsedLevel) && parsedLevel >= 1 ? parsedLevel : 1;
    const rawName = String(sourceVipInfo.name ?? '').trim();
    const vipName = rawName && rawName.toLowerCase() !== 'null' ? rawName : `VIP ${numericVipLevel}`;
    const rawColor = String(sourceVipInfo.color ?? '').trim();
    const vipColor = /^#[0-9A-Fa-f]{6}$/.test(rawColor) ? rawColor.toUpperCase() : fallbackVipColor;
    const colorRgb = [1, 3, 5].map(index => parseInt(vipColor.slice(index, index + 2), 16)).join(', ');
    const rawTheme = String(sourceVipInfo.theme ?? '').trim();
    const fallbackTheme = numericVipLevel <= 3 ? 'cyber' : (numericVipLevel <= 5 ? 'titanium' : 'royal');
    const vipTheme = /^[a-z][a-z0-9-]*$/i.test(rawTheme) ? rawTheme : fallbackTheme;
    const visual = sourceVipInfo.visual && typeof sourceVipInfo.visual === 'object' ? sourceVipInfo.visual : {};
    const getVisualValue = (name, fallback) => {
        const value = Number(visual[name]);
        return Number.isFinite(value) && value >= 0 && value <= 1 ? value : fallback;
    };
    const vipGlowStrength = getVisualValue('glowStrength', 0.16);
    const vipBorderAlpha = getVisualValue('borderAlpha', 0.58);
    const vipHighlightAlpha = getVisualValue('highlightAlpha', 0.14);
    const vipWatermarkOpacity = getVisualValue('watermarkOpacity', 0.08);
    const rawCardId = typeof cardId === 'string' ? cardId : '';
    const safeCardId = rawCardId.replace(/[^A-Za-z0-9_-]/g, '');
    const cardHolder = String(cardUser.custom_nickname || cardUser.nickname || cardUser.global_name || cardUser.username || 'Member');
    const rawUserId = cardUser.id === undefined || cardUser.id === null ? '' : String(cardUser.id);
    const memberId = rawUserId ? `•••• ${rawUserId.slice(-4)}` : '';
    const rawBalance = Number(cardUser.balance || 0);
    const totalBalance = Number.isFinite(rawBalance) ? rawBalance : 0;
%>
<div class="vip-premium-card-frame vip-premium-card-frame--<%= cardMode %>">
<div<% if (safeCardId) { %> id="<%= safeCardId %>"<% } %> class="vip-premium-card vip-premium-card--<%= cardMode %>" data-vip-card data-vip-level="<%= numericVipLevel %>" data-vip-theme="<%= vipTheme %>" style="--vip-color: <%= vipColor %>; --vip-rgb: <%= colorRgb %>; --vip-glow-strength: <%= vipGlowStrength %>; --vip-border-alpha: <%= vipBorderAlpha %>; --vip-highlight-alpha: <%= vipHighlightAlpha %>; --vip-watermark-opacity: <%= vipWatermarkOpacity %>;" aria-label="<%= vipName %> VIP card">
    <span class="vip-card-particles" aria-hidden="true"></span>
    <div class="vip-premium-card__top">
        <div class="vip-card-chip-wrap" aria-hidden="true">
            <span class="vip-card-chip"><span class="vip-card-chip__lines"></span></span>
            <span class="vip-card-contactless"><i class="fa-solid fa-wifi"></i></span>
        </div>
        <%- include('vip_badge', { level: vipName, color: vipColor, extraClass: 'vip-badge--card' }) %>
    </div>

    <% if (cardMode === 'preview') { %>
        <div class="vip-premium-card__main">
            <div class="vip-card-eyebrow">VIP MATERIAL SHOWCASE</div>
            <div class="vip-card-preview-name" data-vip-card-name><%= vipName %></div>
        </div>
        <div class="vip-premium-card__footer">
            <div class="vip-card-footer-block">
                <div class="vip-card-footer-label">MATERIAL TIER</div>
                <div class="vip-card-footer-value" data-vip-card-theme><%= vipTheme.toUpperCase() %></div>
            </div>
            <div class="vip-card-footer-brand">MIHU GAMING</div>
        </div>
    <% } else { %>
        <div class="vip-premium-card__main">
            <div class="vip-card-eyebrow">TOTAL BALANCE</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="vip-card-balance"><%= totalBalance.toLocaleString() %></span>
                <span class="vip-card-currency">NTD</span>
            </div>
        </div>
        <div class="vip-premium-card__footer">
            <div class="vip-card-footer-block">
                <div class="vip-card-footer-label">CARD HOLDER</div>
                <div class="vip-card-footer-value"><%= cardHolder %></div>
            </div>
            <% if (memberId) { %>
                <div class="vip-card-footer-block text-end">
                    <div class="vip-card-footer-label">MEMBER ID</div>
                    <div class="vip-card-footer-value font-monospace"><%= memberId %></div>
                </div>
            <% } %>
        </div>
    <% } %>

    <div class="vip-card-watermark" aria-hidden="true">
        <img src="/images/logo.png" alt="" onerror="this.onerror=null; this.src='/images/logo2.png';">
        <span>MIHU GAMING</span>
    </div>
</div>
</div>