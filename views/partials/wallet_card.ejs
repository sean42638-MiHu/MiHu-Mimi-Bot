<!-- 💳 模組化：頂級奢華黑金尊榮 VIP 電競信用卡組件 (帶品牌 Logo) -->
<% 
    const vipLevel = user.vip_level || 'VIP 3';
    const cardHolder = user.nickname || user.global_name || user.username || 'XiaoMi';
    const memberId = user.id ? `•••• ${user.id.slice(-4)}` : '•••• 6746';
    const totalBalance = Number(user.balance || 0);
    const resolvedVipColor = user.vip_color || (typeof vipColor !== 'undefined' ? vipColor : null) || '#A855F7';
%>

<style>
    .credit-card-container {
        position: relative;
        width: 100%;
        max-width: 520px;
        height: 290px;
        border-radius: 24px;
        padding: 28px 32px;
        /* 極致深邃黑金紫霓虹漸層 */
        background: linear-gradient(135deg, #130d24 0%, #1a1033 40%, #0c1829 80%, #06111f 100%);
        border: 1px solid rgba(168, 85, 247, 0.35);
        box-shadow: 
            0 20px 45px rgba(0, 0, 0, 0.75), 
            0 0 30px rgba(168, 85, 247, 0.15),
            inset 0 1px 2px rgba(255, 255, 255, 0.3),
            inset 0 -1px 2px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        user-select: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .credit-card-container:hover {
        transform: translateY(-6px) rotateX(2deg) rotateY(-2deg);
        border-color: rgba(245, 158, 11, 0.6);
        box-shadow: 
            0 28px 60px rgba(0, 0, 0, 0.85), 
            0 0 40px rgba(245, 158, 11, 0.25),
            inset 0 1px 3px rgba(255, 255, 255, 0.4);
    }

    /* 光對角掃過閃爍質感 */
    .credit-card-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.12), transparent 45%);
        pointer-events: none;
    }

    /* 晶片樣式 (立體擬真黃金質感) */
    .sim-chip-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .sim-chip {
        width: 50px;
        height: 38px;
        background: linear-gradient(135deg, #fef08a 0%, #f59e0b 40%, #b45309 80%, #78350f 100%);
        border-radius: 8px;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.6);
        overflow: hidden;
    }
    /* 晶片內部金屬線條 */
    .sim-chip::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
            linear-gradient(to right, transparent 48%, rgba(0,0,0,0.2) 48%, rgba(0,0,0,0.2) 52%, transparent 52%),
            linear-gradient(to bottom, transparent 48%, rgba(0,0,0,0.2) 48%, rgba(0,0,0,0.2) 52%, transparent 52%);
        border-radius: 6px;
    }

    /* VIP 勳章 Badge (高質感黑金漸層) */
    /* 右下水印 Logo 圖片 (質感微光與立體浮雕) */
    .card-watermark {
        position: absolute;
        right: -15px;
        bottom: -20px;
        opacity: 0.18;
        pointer-events: none;
        z-index: 1;
        transition: opacity 0.3s ease;
    }
    .credit-card-container:hover .card-watermark {
        opacity: 0.28;
    }
    .card-watermark img {
        width: 190px;
        height: auto;
        filter: drop-shadow(0 0 12px rgba(168, 85, 247, 0.6)) brightness(1.3);
    }
</style>

<div class="credit-card-container">
    <!-- 上排：金屬晶片與尊榮 VIP 勳章 -->
    <div class="d-flex justify-content-between align-items-center" style="position: relative; z-index: 2;">
        <div class="sim-chip-wrap">
            <div class="sim-chip"></div>
            <i class="fa-solid fa-wifi text-light" style="transform: rotate(90deg); font-size: 1.2rem; opacity: 0.75; text-shadow: 0 0 8px rgba(255,255,255,0.4);"></i>
        </div>
        <%- include('vip_badge', { level: vipLevel, color: resolvedVipColor, extraClass: 'vip-badge--card' }) %>
    </div>

    <!-- 中排：總餘額大字展示 -->
    <div class="my-auto pt-3" style="position: relative; z-index: 2;">
        <div class="text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 2px; color: #a1a1aa;">TOTAL BALANCE</div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
            <span class="fs-1 fw-bold text-white font-monospace" style="line-height: 1; text-shadow: 0 0 15px rgba(255,255,255,0.3);"><%= totalBalance.toLocaleString() %></span>
            <span class="fw-bold font-monospace" style="font-size: 0.9rem; letter-spacing: 1.5px; color: #f59e0b;">NTD</span>
        </div>
    </div>

    <!-- 下排：持卡人與 Member ID (銀箔字體) -->
    <div class="d-flex justify-content-between align-items-end pt-2 border-top border-white border-opacity-10" style="position: relative; z-index: 2;">
        <div>
            <div class="text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 1.2px; color: #71717a;">CARD HOLDER</div>
            <div class="fw-bold text-white mt-1" style="font-size: 1.05rem; letter-spacing: 0.8px; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><%= cardHolder %></div>
        </div>
        <div class="text-end">
            <div class="text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 1.2px; color: #71717a;">MEMBER ID</div>
            <div class="fw-bold text-white font-monospace mt-1" style="font-size: 1rem; letter-spacing: 1.5px; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><%= memberId %></div>
        </div>
    </div>

    <!-- 🚀 右下水印：保有專案實體 Logo 圖片 -->
    <div class="card-watermark">
        <img src="/images/logo.png" alt="MiHu Logo" onerror="this.src='/images/logo2.png';">
    </div>
</div>