<div class="login-transition-overlay" id="login-transition-overlay" data-destination="<%= transitionDestination %>" role="status" aria-live="polite" aria-hidden="true" hidden>
    <span class="login-transition-grid" aria-hidden="true"></span>
    <div class="login-transition-card">
        <div class="login-transition-logo-wrap">
            <span class="login-transition-ring" aria-hidden="true"></span>
            <img src="/images/logo.png" alt="米胡電競 MiHu Gaming" class="login-transition-logo" onerror="this.style.display='none'">
        </div>
        <div class="login-transition-verified">
            <div class="login-transition-discord"><span class="login-transition-check" aria-hidden="true">✓</span><span>DISCORD VERIFIED</span></div>
            <h1 class="login-transition-title">驗證成功</h1>
            <p class="login-transition-subtitle">正在登入米胡電競控制台...</p>
        </div>
        <div class="login-transition-status-row" aria-live="polite">
            <span class="login-transition-status">AUTHENTICATING...</span>
            <span class="login-transition-access" aria-hidden="true">✓</span>
        </div>
        <div class="login-transition-progress" aria-hidden="true"><span class="login-transition-progress-bar"></span></div>
    </div>
</div>
