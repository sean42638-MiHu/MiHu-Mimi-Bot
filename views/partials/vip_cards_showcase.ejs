<!-- VIP tier selector backed by the canonical wallet card preview component. -->
<%
    const fallbackVipColor = '#A855F7';
    const normalizeShowcaseColor = value => {
        const color = String(value || '').trim();
        return /^#[0-9A-Fa-f]{6}$/.test(color) ? color.toUpperCase() : fallbackVipColor;
    };
    const configuredVipTiers = (typeof vipTiers !== 'undefined' && Array.isArray(vipTiers) ? vipTiers : [])
        .map(tier => ({
            level: Number(tier.level),
            name: String(tier.name || '').trim(),
            color: normalizeShowcaseColor(tier.color),
            theme: /^[a-z][a-z0-9-]*$/i.test(String(tier.theme || '').trim())
                ? String(tier.theme).trim()
                : (Number(tier.level) <= 3 ? 'cyber' : (Number(tier.level) <= 5 ? 'titanium' : 'royal')),
            visual: tier.visual && typeof tier.visual === 'object' ? tier.visual : {}
        }))
        .filter(tier => Number.isSafeInteger(tier.level) && tier.level > 0)
        .sort((left, right) => left.level - right.level);
    const showcaseVipTiers = configuredVipTiers;
    showcaseVipTiers.forEach(tier => {
        if (!tier.name) tier.name = `VIP ${tier.level}`;
    });
    const initialVip = showcaseVipTiers[0] || null;
    const initialVipInfo = initialVip ? {
        level: initialVip.level,
        name: initialVip.name,
        color: initialVip.color,
        theme: initialVip.theme,
        visual: initialVip.visual
    } : null;
%>

<style>
    .vip-showcase-shell {
        width: 100%;
        min-width: 0;
    }
    .vip-showcase-header { text-align: left; }
    .vip-showcase-content {
        width: 100%;
        max-width: 860px;
        min-width: 0;
        margin-inline: auto;
    }
    .vip-showcase-tabs {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
        max-width: 100%;
    }
    .vip-showcase-tabs .btn-vip-preview-tab {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #94a3b8;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }
    .vip-showcase-tabs .btn-vip-preview-tab:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.3);
    }
    .vip-showcase-tabs .btn-vip-preview-tab.active {
        color: var(--vip-color, #A855F7);
        background: rgba(var(--vip-rgb, 168, 85, 247), 0.1);
        border-color: var(--vip-color, #A855F7);
        box-shadow: 0 0 8px rgba(var(--vip-rgb, 168, 85, 247), 0.42), inset 0 0 12px rgba(var(--vip-rgb, 168, 85, 247), 0.12);
    }
    .vip-showcase-stage {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-width: 0;
    }
    .vip-showcase-card-wrap {
        display: flex;
        justify-content: center;
        width: min(100%, 480px);
        max-width: 480px;
        min-width: 0;
        margin-inline: auto;
    }
    .vip-showcase-card-wrap > .vip-premium-card-frame { width: 100%; }

    @media (min-width: 576px) and (max-width: 1199px) {
        .vip-showcase-card-wrap { width: min(100%, 460px); max-width: 460px; }
    }
    @media (max-width: 575px) {
        .vip-showcase-shell { padding: 16px !important; }
        .vip-showcase-content { max-width: 100%; }
        .vip-showcase-card-wrap { width: 100%; max-width: 100%; }
        .vip-showcase-tabs { gap: 8px; margin-bottom: 18px; }
        .vip-showcase-tabs .btn-vip-preview-tab { padding: 7px 11px; }
    }
</style>

<div class="vip-showcase-content">
<div class="vip-showcase-tabs" id="vipShowcaseContainer" role="group" aria-label="VIP preview">
    <% showcaseVipTiers.forEach((tier, index) => {
        const visual = tier.visual || {};
        const glowStrength = Number(visual.glowStrength);
        const borderAlpha = Number(visual.borderAlpha);
        const highlightAlpha = Number(visual.highlightAlpha);
        const watermarkOpacity = Number(visual.watermarkOpacity);
    %>
        <button type="button"
                class="btn-vip-preview-tab <%= index === 0 ? 'active' : '' %>"
                data-vip-level="<%= tier.level %>"
                data-vip-name="<%= tier.name %>"
                data-vip-color="<%= tier.color %>"
                data-vip-theme="<%= tier.theme %>"
                data-vip-glow-strength="<%= Number.isFinite(glowStrength) && glowStrength >= 0 && glowStrength <= 1 ? glowStrength : 0.16 %>"
                data-vip-border-alpha="<%= Number.isFinite(borderAlpha) && borderAlpha >= 0 && borderAlpha <= 1 ? borderAlpha : 0.58 %>"
                data-vip-highlight-alpha="<%= Number.isFinite(highlightAlpha) && highlightAlpha >= 0 && highlightAlpha <= 1 ? highlightAlpha : 0.14 %>"
                data-vip-watermark-opacity="<%= Number.isFinite(watermarkOpacity) && watermarkOpacity >= 0 && watermarkOpacity <= 1 ? watermarkOpacity : 0.08 %>"
                style="--vip-color: <%= index === 0 ? tier.color : fallbackVipColor %>; --vip-rgb: <%= index === 0 ? tier.color.slice(1).match(/.{2}/g).map(value => parseInt(value, 16)).join(', ') : '168, 85, 247' %>;"
                aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
            <i class="fa-solid fa-crown me-1" style="font-size: 0.75rem;"></i><%= tier.name %>
        </button>
    <% }) %>
</div>

<div class="vip-showcase-stage">
<div class="vip-showcase-card-wrap">
    <% if (initialVipInfo) { %>
        <%- include('wallet_card', { user: null, vipInfo: initialVipInfo, mode: 'preview', cardId: 'vip-showcase-card' }) %>
    <% } else { %>
        <div class="vip-showcase-empty" role="status">目前尚無 VIP 等級設定</div>
    <% } %>
</div>
</div>
</div>

<script>
    (() => {
        const fallbackVipColor = '#A855F7';
        const container = document.getElementById('vipShowcaseContainer');
        const card = document.getElementById('vip-showcase-card');

        function normalizeVipColor(value) {
            const color = String(value || '').trim();
            return /^#[0-9A-Fa-f]{6}$/.test(color) ? color.toUpperCase() : fallbackVipColor;
        }

        function hexToRgb(hex) {
            const color = normalizeVipColor(hex).slice(1);
            return [0, 2, 4].map(index => parseInt(color.slice(index, index + 2), 16)).join(', ');
        }

        function normalizeVisualValue(value, fallback) {
            const number = Number(value);
            return Number.isFinite(number) && number >= 0 && number <= 1 ? number : fallback;
        }

        function switchVipCardPreview(buttonEl) {
            if (!container || !card || !(buttonEl instanceof HTMLButtonElement)
                || !buttonEl.matches('.btn-vip-preview-tab') || !container.contains(buttonEl)) return;

            const level = Number(buttonEl.dataset.vipLevel);
            if (!Number.isSafeInteger(level) || level < 1) return;
            const name = String(buttonEl.dataset.vipName || `VIP ${level}`).trim() || `VIP ${level}`;
            const color = normalizeVipColor(buttonEl.dataset.vipColor);
            const rawTheme = String(buttonEl.dataset.vipTheme || 'cyber').trim();
            const theme = /^[a-z][a-z0-9-]*$/i.test(rawTheme) ? rawTheme : 'cyber';
            const rgb = hexToRgb(color);

            container.querySelectorAll('.btn-vip-preview-tab').forEach(tab => {
                const isActive = tab === buttonEl;
                tab.classList.toggle('active', isActive);
                tab.setAttribute('aria-pressed', String(isActive));
                tab.style.removeProperty('--vip-color');
                tab.style.removeProperty('--vip-rgb');
                if (isActive) {
                    tab.style.setProperty('--vip-color', color);
                    tab.style.setProperty('--vip-rgb', rgb);
                }
            });

            card.dataset.vipLevel = String(level);
            card.dataset.vipTheme = theme;
            card.style.setProperty('--vip-color', color);
            card.style.setProperty('--vip-rgb', rgb);
            card.style.setProperty('--vip-glow-strength', normalizeVisualValue(buttonEl.dataset.vipGlowStrength, 0.16));
            card.style.setProperty('--vip-border-alpha', normalizeVisualValue(buttonEl.dataset.vipBorderAlpha, 0.58));
            card.style.setProperty('--vip-highlight-alpha', normalizeVisualValue(buttonEl.dataset.vipHighlightAlpha, 0.14));
            card.style.setProperty('--vip-watermark-opacity', normalizeVisualValue(buttonEl.dataset.vipWatermarkOpacity, 0.08));

            const badge = card.querySelector('[data-vip-badge]');
            if (badge) badge.style.setProperty('--vip-color', color);
            const badgeLabel = card.querySelector('[data-vip-badge-label]');
            if (badgeLabel) badgeLabel.textContent = name;
            const cardName = card.querySelector('[data-vip-card-name]');
            if (cardName) cardName.textContent = name;
            const themeLabel = card.querySelector('[data-vip-card-theme]');
            if (themeLabel) themeLabel.textContent = theme.toUpperCase();
        }

        container?.addEventListener('click', event => {
            const button = event.target.closest('.btn-vip-preview-tab');
            if (button) switchVipCardPreview(button);
        });

        const firstButton = container?.querySelector('.btn-vip-preview-tab');
        if (firstButton) switchVipCardPreview(firstButton);
    })();
</script>