<%
    const currentVip = Number(user.vip_level || 0);
    const spent = Number(user.manual_spent !== undefined ? user.manual_spent : (stats ? stats.total_spent : 0));
    const deposited = Number(user.manual_deposited !== undefined ? user.manual_deposited : (stats ? stats.total_deposited : 0));
    const pct = parseFloat(progressPercent || 0);
    const resolvedVipColor = typeof vipColor !== 'undefined' && vipColor ? vipColor : '#A855F7';
%>

<style>
    .vip-progress-card {
        background: linear-gradient(135deg, rgba(23, 19, 38, 0.9), rgba(15, 11, 28, 0.95)) !important;
        border: 1px solid rgba(168, 85, 247, 0.25) !important;
        border-radius: 20px;
        padding: 22px 28px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, border-color 0.25s ease;
    }
    .vip-progress-card:hover {
        border-color: rgba(192, 132, 252, 0.45) !important;
        transform: translateY(-2px);
    }

    /* 頂部 VIP 徽章 */
    /* 霓虹主進度條槽 */
    .vip-progress-track {
        height: 12px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
        position: relative;
    }

    /* 流光動態進度填充條 (由 CSS 變數 --progress-pct 控制寬度) */
    .vip-progress-fill {
        height: 100%;
        border-radius: 10px;
        width: var(--progress-pct, 0%);
        background: linear-gradient(90deg, #8b5cf6, #d946ef, #f43f5e);
        background-size: 200% 100%;
        animation: gradientShimmer 3s linear infinite;
        box-shadow: 0 0 12px rgba(217, 70, 239, 0.6);
        transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes gradientShimmer {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* 數據統計指標方塊 */
    .stat-badge-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 12px;
        padding: 8px 14px;
    }
</style>

<div class="vip-progress-card">
    <!-- 1. 標題與當前進度 % 數 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-crown text-warning fs-5"></i>
            <span class="fw-bold text-white fs-6">VIP 尊榮解鎖進度</span>
            <%- include('vip_badge', { level: `VIP ${currentVip}`, color: resolvedVipColor }) %>
        </div>

        <div class="d-flex align-items-baseline gap-1">
            <span class="small text-secondary fw-semibold">最高達成進度</span>
            <span class="fs-4 fw-extrabold font-monospace text-warning ms-1" style="text-shadow: 0 0 10px rgba(253, 224, 71, 0.3);"><%= pct %>%</span>
        </div>
    </div>

    <!-- 2. 主進度條 (透過 CSS Variable 傳遞數據) -->
    <div class="vip-progress-track mb-3">
        <div class="vip-progress-fill" style="--progress-pct: <%= pct %>%;"></div>
    </div>

    <!-- 3. 雙軌資訊與升級差距（消費與預存雙數據對比） -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <!-- 左側：距離下一階差距說明 -->
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1" style="font-size: 0.75rem;">
                <i class="fa-solid fa-bolt me-1"></i>升級目標
            </span>
            <span class="small text-light font-monospace fw-semibold" style="font-size: 0.85rem;">
                <%= vipGapText %>
            </span>
        </div>

        <!-- 右側：當前累積消費與預存數值 -->
        <div class="d-flex align-items-center gap-3">
            <div class="stat-badge-box d-flex align-items-center gap-2">
                <i class="fa-solid fa-bag-shopping text-warning small"></i>
                <span class="text-secondary small">累積消費:</span>
                <span class="text-warning fw-bold font-monospace small">$<%= spent.toLocaleString() %></span>
            </div>
            <div class="stat-badge-box d-flex align-items-center gap-2">
                <i class="fa-solid fa-piggy-bank text-info small"></i>
                <span class="text-secondary small">累積實充:</span>
                <span class="text-info fw-bold font-monospace small">$<%= deposited.toLocaleString() %></span>
            </div>
        </div>
    </div>
</div>