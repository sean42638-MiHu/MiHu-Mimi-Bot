<!-- 📊 模組化：VIP 等級門檻與特權對照表格 -->
<div class="glass-table-card mb-4">
    <div class="vip-scroll-container">
        <table class="mihu-table">
            <thead>
                <tr>
                    <th style="width: 130px;">等級</th>
                    <th style="width: 150px;">累計消費門檻</th>
                    <th style="width: 150px;">預存門檻</th>
                    <th>特權獎勵內容（點擊整行看詳細）</th>
                    <th style="width: 120px;" class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                <% vipTiers.forEach(vip => {
                    const rewards = JSON.parse(vip.rewards || '[]');
                    const vipColor = vip.color || '#A855F7';
                %>
                    <tr class="vip-tier-row" data-vip-level="<%= vip.level %>" data-vip-name="<%= vip.name %>" data-vip-spent="<%= vip.spent_threshold %>" data-vip-deposit="<%= vip.deposit_threshold %>" data-vip-color="<%= vipColor %>" data-rewards='<%- JSON.stringify(rewards).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>'>
                        <td>
                            <%- include('vip_badge', { level: vip.name, color: vipColor }) %>
                        </td>
                        <td>
                            <span class="font-monospace text-warning fw-bold"><%= Number(vip.spent_threshold).toLocaleString() %></span> <span class="text-secondary small">T</span>
                        </td>
                        <td>
                            <span class="font-monospace text-info fw-bold"><%= Number(vip.deposit_threshold).toLocaleString() %></span> <span class="text-secondary small">T</span>
                        </td>
                        <td>
                            <div class="rewards-preview-badges">
                                <% rewards.slice(0, 3).forEach(r => { %>
                                    <span class="reward-tag"><%= r %></span>
                                <% }) %>
                                <% if (rewards.length > 3) { %>
                                    <span class="reward-tag" style="color: #c084fc;">+ 更多 <%= rewards.length - 3 %> 項</span>
                                <% } %>
                            </div>
                        </td>
                        <td class="text-end" onclick="event.stopPropagation();">
                            <% if (typeof hasPerm === 'function' && hasPerm('vip.manage')) { %><button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 vip-edit-trigger" data-rewards='<%- JSON.stringify(rewards).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>'>
                                <i class="fa-solid fa-pen-to-square me-1"></i>編輯
                            </button><% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
