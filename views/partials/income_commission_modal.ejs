<!-- 🚀 分潤成數彈窗模組 (ID: commissionRatesModal) -->
<div class="modal fade" id="commissionRatesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content modal-content-glass p-2">
            <div class="modal-header border-0 pb-1">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-percent text-info"></i>
                    <span>個人與各類別分潤成數表</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <% 
                   // 🚀 嚴格驗證：只有當 personalRate 存在、不為 null/undefined 且數字 > 0 時，才認定為個人特例！
                   let validPersonalRate = null;
                   if (typeof personalRate !== 'undefined' && personalRate !== null && personalRate !== '' && personalRate !== 'null') {
                       const pNum = Number(personalRate);
                       if (!isNaN(pNum) && pNum > 0) {
                           validPersonalRate = pNum > 1 ? (pNum / 100) : pNum;
                       }
                   }
                %>

                <% if (validPersonalRate !== null) { %>
                    <div class="p-3 mb-3 rounded-3 small" style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #7dd3fc;">
                        ☀️ <strong style="color: #38bdf8;">特例提示</strong>：您擁有個人專屬特例抽佣成數 <strong class="text-warning font-monospace fs-6 px-1"><%= Math.round(validPersonalRate * 100) %>%</strong>，優先適用於所有類別訂單！
                    </div>
                <% } else { %>
                    <div class="p-3 mb-3 rounded-3 small" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;">
                        ✨ <strong>工作室連動預設</strong>：您目前採用工作室全域類別分潤設定！(分潤依原價金額計算，不承擔折扣)
                    </div>
                <% } %>

                <div class="glass-table-card border-0">
                    <table class="mihu-table">
                        <thead>
                            <tr>
                                <th>訂單類別</th>
                                <th class="text-end">工作室設定分潤</th>
                                <th class="text-end">您的實際適用成數</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                                const defaultNetShareRates = {
                                    '陪玩單': 0.80,
                                    '禮物單': 0.85,
                                    '有獎單': 0.90,
                                    '冠名單': 0.85,
                                    '其他單': 0.80,
                                    '獎金單': 1.00
                                };

                                const categoryNames = (typeof globalCommissions !== 'undefined' && globalCommissions)
                                    ? Object.keys(globalCommissions)
                                    : Object.keys(defaultNetShareRates);
                                const categoryAliases = { '有獎': '有獎單', '冠名': '冠名單', '獎金': '獎金單', '其他': '其他單', '活動單': '其他單' };
                                const categoryOrder = ['陪玩單', '禮物單', '有獎單', '冠名單', '其他單', '獎金單'];
                                const categories = Array.from(new Set(categoryNames.map(cat => categoryAliases[cat] || cat))).sort((left, right) => {
                                    const leftRank = categoryOrder.indexOf(left);
                                    const rightRank = categoryOrder.indexOf(right);
                                    return (leftRank === -1 ? categoryOrder.length : leftRank) - (rightRank === -1 ? categoryOrder.length : rightRank);
                                });
                                categories.forEach(cat => {
                                    let studioNetRate = defaultNetShareRates[cat] ?? defaultNetShareRates['其他單'];
                                    
                                    // globalCommissions 一律為陪陪實拿比例。
                                    const legacyCat = Object.keys(categoryAliases).find(alias => categoryAliases[alias] === cat) || cat;
                                    const categoryRate = globalCommissions && (globalCommissions[cat] ?? globalCommissions[legacyCat]);
                                    if (typeof globalCommissions !== 'undefined' && globalCommissions && categoryRate !== undefined) {
                                        const rawVal = Number(categoryRate);
                                        if (!isNaN(rawVal)) {
                                            const normalizedRate = rawVal > 1 && rawVal <= 100 ? rawVal / 100 : rawVal;
                                            if (normalizedRate >= 0 && normalizedRate <= 1) studioNetRate = normalizedRate;
                                        }
                                    }

                                    // 若 validPersonalRate 為 null，實際成數完全跟隨工作室設定
                                    const actualRate = (validPersonalRate !== null) ? validPersonalRate : studioNetRate;
                            %>
                                <tr>
                                    <td class="fw-bold text-white"><%= cat %></td>
                                    <td class="text-end font-monospace text-secondary"><%= Math.round(studioNetRate * 100) %>%</td>
                                    <td class="text-end font-monospace fw-bold text-warning"><%= Math.round(actualRate * 100) %>%</td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-0 pt-1">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>