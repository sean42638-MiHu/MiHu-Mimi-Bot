<%
    const perms = (typeof userPerms !== 'undefined' && userPerms) ? userPerms : [];
    const currUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};

    const canAccess = typeof hasPerm === 'function'
        ? hasPerm
        : node => perms.includes('*') || perms.includes(node);

    const hasPersonalSection = canAccess('view_personal') || canAccess('view_profile') || canAccess('view_wallet') || canAccess('view_income') || canAccess('view_personal_orders');
    const hasMemberSection = canAccess('view_manage_members') || canAccess('view_member_ledger');
    const hasManageChildren = canAccess('action_view_analytics') || hasMemberSection || canAccess('view_manage_staff') || canAccess('view_staff_payroll') || canAccess('view_payout') || canAccess('view_manage_orders');
    const hasManageSection = canAccess('view_management') && hasManageChildren;

    const currentPage = typeof activePage !== 'undefined' ? activePage : '';
    const isBotPage = currentPage === 'bot_settings' || currentPage === 'bot-settings';
    const canSystemSettingsEntry = canAccess('view_system_settings');
    const canSystemBotEntry = canAccess('view_bot_settings') || canAccess('view_discord_status') || canAccess('action_system_management');
    const canSystemCommissionEntry = canAccess('view_commission_settings') || canAccess('view_commission');
    const canSystemVipEntry = canAccess('view_vip_settings') || canAccess('view_vip');
    const canSystemRoleEntry = canAccess('view_role_management') || canAccess('view_roles');
    const canSystemLogsEntry = canAccess('view_audit_logs') || canAccess('action_view_audit_logs');
    const canSystemStatusEntry = canAccess('view_system_status') || canAccess('view_system_health');

    const hasSystemSettingsChildren = canSystemSettingsEntry;
    const hasSystemManageChildren = canSystemBotEntry || canSystemCommissionEntry || canSystemVipEntry || canSystemRoleEntry;
    const hasSystemInfoChildren = canSystemLogsEntry || canSystemStatusEntry;

    const canViewSystemSettingsCategory = canAccess('view_cat_system_settings') || hasSystemSettingsChildren;
    const canViewSystemManageCategory = canAccess('view_cat_system_manage') || hasSystemManageChildren;
    const canViewSystemInfoCategory = canAccess('view_cat_system_info') || hasSystemInfoChildren;

    const hasSystemChildren = (canViewSystemSettingsCategory && hasSystemSettingsChildren)
        || (canViewSystemManageCategory && hasSystemManageChildren)
        || (canViewSystemInfoCategory && hasSystemInfoChildren);
    const hasSystemSection = canAccess('view_system') && hasSystemChildren;
    const isAnalyticsPage = currentPage === 'analytics';
    const isMemberPage = currentPage === 'members' || currentPage === 'member_transactions';
    const isStaffPage = currentPage === 'staff' || currentPage === 'payroll';
    const isSystemSettingsPage = currentPage === 'system_settings';
    const isSystemManagePage = isBotPage || currentPage === 'commission' || currentPage === 'vip' || currentPage === 'roles';
    const isSystemInfoPage = currentPage === 'audit_logs' || currentPage === 'system_health';
%>

<link rel="stylesheet" href="/css/vip-badge.css">
<link rel="stylesheet" href="/css/wallet_card.css">
<link rel="stylesheet" href="/css/admin-layout.css">
<link rel="stylesheet" href="/css/admin-components.css">
<div id="mihu-request-context" data-request-method="<%= typeof requestMethod === 'string' ? requestMethod : '' %>" hidden></div>
<script src="/js/csrf.js" defer></script>
<script src="/js/protected-page-guard.js" defer></script>
<script src="/js/adminSidebar.js" defer></script>
<script src="/js/admin-feedback.js" defer></script>
<style>
    .mihu-sidebar {
        width: 280px !important;
        min-width: 280px !important;
        max-width: 280px !important;
        background-color: #131021;
        border-right: 1px solid rgba(168, 85, 247, 0.2);
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start;
        padding: 24px 16px;
        flex-shrink: 0;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .sidebar-brand-clean {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 10px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 12px;
        width: 100%;
    }

    .brand-logo-clean {
        width: 170px !important;
        max-width: 170px !important;
        height: auto !important;
        object-fit: contain !important;
        filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.5));
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brand-logo-clean:hover { transform: scale(1.05); }

    .sidebar-menu { 
        display: flex !important; 
        flex-direction: column !important; 
        gap: 4px !important; 
        width: 100%;
        overflow: visible;
    }

    .menu-label { 
        font-size: 0.74rem; 
        color: #8b83a8; 
        padding: 14px 14px 4px; 
        text-transform: uppercase; 
        font-weight: 700; 
        letter-spacing: 0.8px;
        display: block;
    }

    .menu-item {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 10px 14px !important;
        border-radius: 12px !important;
        color: #9ca3af !important;
        border-right: 3px solid transparent !important;
        text-decoration: none !important;
        font-size: 0.92rem !important;
        font-weight: 500 !important;
        transition: color 0.2s ease, background-color 0.2s ease, border-right-color 0.2s ease, box-shadow 0.2s ease !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .menu-item i { width: 18px; text-align: center; }
    .menu-item:hover, .menu-item.active {
        color: #fff !important;
        background: rgba(139, 92, 246, 0.14) !important;
        border-right-color: rgba(192, 132, 252, 0.95) !important;
        box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.25), 0 8px 18px rgba(91, 33, 182, 0.26) !important;
    }
    .menu-item:not(.locked):hover i,
    .menu-item:not(.locked):focus-visible i,
    .menu-item:not(.locked).active i,
    .submenu-item:not(.locked):hover i,
    .submenu-item:not(.locked):focus-visible i,
    .submenu-item:not(.locked).active-staff i {
        color: #c084fc !important;
    }
    .menu-icon-home { color: #f59e0b; }
    .menu-icon-profile { color: #ec4899; }
    .menu-icon-wallet { color: #10b981; }
    .menu-icon-income { color: #a855f7; }
    .menu-icon-orders-personal { color: #f472b6; }
    .menu-icon-manage-analytics { color: #a855f7; }
    .menu-icon-manage-members { color: #38bdf8; }
    .menu-icon-manage-staff { color: #10b981; }
    .menu-icon-manage-orders { color: #ff4655; }
    .menu-icon-system-settings-parent { color: #f97316; }
    .menu-icon-system-settings-child { color: #f97316; }
    .menu-icon-system-manage-parent { color: #38bdf8; }
    .menu-icon-system-bot { color: #38bdf8; }
    .menu-icon-system-commission { color: #a855f7; }
    .menu-icon-system-vip { color: #f59e0b; }
    .menu-icon-system-roles { color: #10b981; }
    .menu-icon-system-info-parent { color: #22d3ee; }
    .menu-icon-system-logs { color: #22d3ee; }
    .menu-icon-system-status { color: #fb7185; }
    .menu-item.locked,
    .menu-item.locked.active,
    .submenu-item.locked,
    .submenu-item.locked.active-staff {
        color: #64748b !important;
        background: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
        cursor: not-allowed;
        opacity: .62;
    }
    .menu-item.locked i, .submenu-item.locked i { color: #64748b !important; }
    .menu-item.locked:hover, .submenu-item.locked:hover { color: #94a3b8 !important; background: rgba(100, 116, 139, .05) !important; }
    .menu-item.locked, .submenu-item.locked { appearance: none; text-align: left; }

    .sidebar-collapse-wrap { display: flex; flex-direction: column; width: 100%; }
    #mihuSidebar .collapsing {
        transition: height 220ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: height;
    }
    .collapse-arrow {
        display: inline-flex;
        transform-origin: 50% 50%;
        transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .menu-item[aria-expanded="true"] .collapse-arrow { transform: rotate(180deg); }
    .menu-item.is-collapsing { pointer-events: none; }
    
    .sidebar-submenu-items {
        margin-left: 20px;
        padding-left: 10px;
        border-left: 2px dashed rgba(168, 85, 247, 0.25);
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 4px;
        margin-bottom: 6px;
    }
    .submenu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        color: #94a3b8;
        border-right: 3px solid transparent;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 500;
        transition: color 0.2s ease, background-color 0.2s ease, border-right-color 0.2s ease, box-shadow 0.2s ease;
    }
    .submenu-item i { width: 16px; text-align: center; font-size: 0.8rem; }
    .submenu-item.system-manage-item {
        color: #9ca3af;
        font-size: 0.92rem;
        font-weight: 500;
        letter-spacing: normal;
    }
    .submenu-item.system-manage-item i {
        width: 18px;
        font-size: 0.9rem;
    }
    .submenu-item.system-manage-item > span {
        font-weight: 600;
    }
    .submenu-item:hover {
        color: #fff;
        background: rgba(139, 92, 246, 0.12);
        border-right-color: rgba(192, 132, 252, 0.85);
        box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.18);
    }
    .submenu-item.active-staff {
        color: #ffffff !important;
        background: rgba(139, 92, 246, 0.2) !important;
        border-right-color: rgba(196, 181, 253, 0.95) !important;
        box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.3), 0 8px 20px rgba(91, 33, 182, 0.28) !important;
        font-weight: 700 !important;
    }

    @media (prefers-reduced-motion: reduce) {
        #mihuSidebar .collapsing,
        .collapse-arrow,
        .menu-item,
        .submenu-item {
            transition: none !important;
        }
    }
</style>

<aside class="mihu-sidebar" id="mihuSidebar" aria-label="主要導覽">
    <div class="sidebar-brand-clean">
        <img src="/images/logo2.png" alt="米胡電競" class="brand-logo-clean" onerror="this.src='/images/logo.png'">
        <button type="button" class="admin-sidebar-close" aria-label="關閉導覽選單" title="關閉導覽選單">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <% if (canAccess('view_dashboard')) { %>
            <div class="menu-label">首頁</div>
            <a href="/dashboard" class="menu-item <%= currentPage === 'dashboard' ? 'active' : '' %>" <%- currentPage === 'dashboard' ? 'aria-current="page"' : '' %>>
                <i class="fa-solid fa-house menu-icon-home"></i>
                <span class="fw-semibold">首頁</span>
            </a>
        <% } %>

        <% if (hasPersonalSection) { %>
            <div class="menu-label">個人</div>
            
            <% if (canAccess('view_profile')) { %>
                <a href="/profile" class="menu-item <%= currentPage === 'profile' ? 'active' : '' %>" <%- currentPage === 'profile' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-user-gear menu-icon-profile"></i>
                    <span class="fw-semibold">個人檔案</span>
                </a>
            <% } %>

            <% if (canAccess('view_wallet')) { %>
                <a href="/wallet" class="menu-item <%= currentPage === 'wallet' ? 'active' : '' %>" <%- currentPage === 'wallet' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-wallet menu-icon-wallet"></i>
                    <span class="fw-semibold">我的錢包</span>
                </a>
            <% } %>

            <% if (canAccess('view_income')) { %>
                <a href="/income" class="menu-item <%= currentPage === 'income' ? 'active' : '' %>" <%- currentPage === 'income' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-sack-dollar menu-icon-income"></i>
                    <span class="fw-semibold">我的收入</span>
                </a>
            <% } %>

            <% if (canAccess('view_personal_orders')) { %>
                <a href="/my-orders" class="menu-item <%= currentPage === 'my_orders' ? 'active' : '' %>" <%- currentPage === 'my_orders' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-receipt menu-icon-orders-personal"></i>
                    <span class="fw-semibold">我的訂單</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasManageSection) { %>
            <div class="menu-label">管理</div>

            <% if (canAccess('action_view_analytics')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseOperation" class="menu-item d-flex justify-content-between align-items-center <%= isAnalyticsPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isAnalyticsPage ? 'true' : 'false' %>" aria-controls="collapseOperation">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-chart-pie menu-icon-manage-analytics"></i>
                            <span>營運總覽</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isAnalyticsPage ? 'show' : '' %>" id="collapseOperation">
                        <div class="sidebar-submenu-items">
                            <a href="/management/analytics" class="submenu-item <%= isAnalyticsPage ? 'active-staff' : '' %>" <%- isAnalyticsPage ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-chart-line"></i>
                                <span>公司營運統計</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasMemberSection) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseMembers" class="menu-item d-flex justify-content-between align-items-center <%= isMemberPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isMemberPage ? 'true' : 'false' %>" aria-controls="collapseMembers">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-users menu-icon-manage-members"></i>
                            <span>會員管理</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isMemberPage ? 'show' : '' %>" id="collapseMembers">
                        <div class="sidebar-submenu-items">
                            <% if (canAccess('view_manage_members')) { %><a href="/management/members" class="submenu-item <%= currentPage === 'members' ? 'active-staff' : '' %>" <%- currentPage === 'members' ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-users menu-icon-manage-members"></i>
                                <span>會員名單</span>
                            </a><% } %>
                            <% if (canAccess('view_member_ledger')) { %><a href="/management/members/transactions" class="submenu-item <%= currentPage === 'member_transactions' ? 'active-staff' : '' %>" <%- currentPage === 'member_transactions' ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-wallet menu-icon-system-logs"></i>
                                <span>會員資金明細</span>
                            </a><% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canAccess('view_manage_staff') || canAccess('view_staff_payroll') || canAccess('view_payout')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseStaff" class="menu-item d-flex justify-content-between align-items-center <%= isStaffPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isStaffPage ? 'true' : 'false' %>" aria-controls="collapseStaff">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-id-badge menu-icon-manage-staff"></i>
                            <span>員工管理</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isStaffPage ? 'show' : '' %>" id="collapseStaff">
                        <div class="sidebar-submenu-items">
                            <% if (canAccess('view_manage_staff')) { %>
                                <a href="/management/staff" class="submenu-item <%= currentPage === 'staff' ? 'active-staff' : '' %>" <%- currentPage === 'staff' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-users-gear menu-icon-manage-staff"></i>
                                    <span>員工列表</span>
                                </a>
                            <% } %>
                            <!-- 🚀 正式開放進入薪轉管理頁面 -->
                            <% if (canAccess('view_staff_payroll') || canAccess('view_payout')) { %>
                                <a href="/management/payroll" class="submenu-item <%= currentPage === 'payroll' ? 'active-staff' : '' %>" <%- currentPage === 'payroll' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-money-check-dollar menu-icon-system-vip"></i>
                                    <span>薪轉管理</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canAccess('view_manage_orders')) { %>
                <a href="/management/orders" class="menu-item <%= currentPage === 'orders' ? 'active' : '' %>" <%- currentPage === 'orders' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-list-check menu-icon-manage-orders"></i>
                    <span class="fw-semibold">訂單管理</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasSystemSection) { %>
            <div class="menu-label">系統</div>

            <% if (canViewSystemSettingsCategory && hasSystemSettingsChildren) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseSystemSettings" class="menu-item d-flex justify-content-between align-items-center <%= isSystemSettingsPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isSystemSettingsPage ? 'true' : 'false' %>" aria-controls="collapseSystemSettings">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-sliders menu-icon-system-settings-parent"></i>
                            <span>系統設定</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isSystemSettingsPage ? 'show' : '' %>" id="collapseSystemSettings">
                        <div class="sidebar-submenu-items">
                            <% if (canSystemSettingsEntry) { %>
                                <a href="/system/settings" class="submenu-item <%= currentPage === 'system_settings' ? 'active-staff' : '' %>" <%- currentPage === 'system_settings' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-sliders menu-icon-system-settings-child"></i>
                                    <span>系統基礎設定</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canViewSystemManageCategory && hasSystemManageChildren) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseSystemManage" class="menu-item d-flex justify-content-between align-items-center <%= isSystemManagePage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isSystemManagePage ? 'true' : 'false' %>" aria-controls="collapseSystemManage">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-screwdriver-wrench menu-icon-system-manage-parent"></i>
                            <span>系統管理</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isSystemManagePage ? 'show' : '' %>" id="collapseSystemManage">
                        <div class="sidebar-submenu-items">
                            <% if (canSystemBotEntry) { %>
                                <a href="/system/bot" class="submenu-item system-manage-item <%= isBotPage ? 'active-staff' : '' %>" <%- isBotPage ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-robot menu-icon-system-bot"></i>
                                    <span>機器人設定</span>
                                </a>
                            <% } %>

                            <% if (canSystemCommissionEntry) { %>
                                <a href="/system/commission" class="submenu-item system-manage-item <%= currentPage === 'commission' ? 'active-staff' : '' %>" <%- currentPage === 'commission' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-percent menu-icon-system-commission"></i>
                                    <span>抽傭設定</span>
                                </a>
                            <% } %>

                            <% if (canSystemVipEntry) { %>
                                <a href="/system/vip" class="submenu-item system-manage-item <%= currentPage === 'vip' ? 'active-staff' : '' %>" <%- currentPage === 'vip' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-crown menu-icon-system-vip"></i>
                                    <span>VIP設定</span>
                                </a>
                            <% } %>

                            <% if (canSystemRoleEntry) { %>
                                <a href="/system/roles" class="submenu-item system-manage-item <%= currentPage === 'roles' ? 'active-staff' : '' %>" <%- currentPage === 'roles' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-shield-halved menu-icon-system-roles"></i>
                                    <span>身分管理</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canViewSystemInfoCategory && hasSystemInfoChildren) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseSystemInfo" class="menu-item d-flex justify-content-between align-items-center <%= isSystemInfoPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isSystemInfoPage ? 'true' : 'false' %>" aria-controls="collapseSystemInfo">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-info menu-icon-system-info-parent"></i>
                            <span>系統資訊</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isSystemInfoPage ? 'show' : '' %>" id="collapseSystemInfo">
                        <div class="sidebar-submenu-items">
                            <% if (canSystemLogsEntry) { %>
                                <a href="/system/logs" class="submenu-item <%= currentPage === 'audit_logs' ? 'active-staff' : '' %>" <%- currentPage === 'audit_logs' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-clock-rotate-left menu-icon-system-logs"></i>
                                    <span>操作紀錄</span>
                                </a>
                            <% } %>

                            <% if (canSystemStatusEntry) { %>
                                <a href="/system/status" class="submenu-item <%= currentPage === 'system_health' ? 'active-staff' : '' %>" <%- currentPage === 'system_health' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-heart-pulse menu-icon-system-status"></i>
                                    <span>系統狀態</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</aside>
<%- include('../modals/coming_soon_modal') %>
<%- include('../modals/admin_confirm_modal') %>
<%- include('../modals/admin_access_denied_modal') %>
<%- include('admin_toast_container', { flashData: typeof flashData !== 'undefined' ? flashData : {} }) %>
