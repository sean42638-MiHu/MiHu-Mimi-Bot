<%
    const perms = (typeof userPerms !== 'undefined' && userPerms) ? userPerms : [];
    const currUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};

    // 🚀 1. 寬鬆匹配所有管理員角色名稱 (包含 admin, manager, cfo, owner, administrator, cs 等)
    const userRole = String(currUser.role || '').toLowerCase();
    const isAdminUser = ['admin', 'cfo', 'manager', 'owner', 'administrator', 'cs'].includes(userRole);

    // 🚀 2. 萬能防護：只要是管理角色或 perms 陣列有值，直接全放行；若均無則預設放行基本選單
    const hasPerm = (node) => {
        if (isAdminUser) return true;
        if (perms.length === 0) return true; // 避免未傳遞 perms 時側邊欄空白
        return perms.includes(node);
    };

    const hasPersonalSection = hasPerm('personal') || hasPerm('profile') || hasPerm('my_wallet') || hasPerm('my_income') || hasPerm('my_orders');
    const hasManageSection = hasPerm('manage') || hasPerm('manage_members') || hasPerm('manage_staff') || hasPerm('manage_orders');
    const canManageCommissionPage = hasPerm('sys_commission') || (typeof canManageStudioCommission !== 'undefined' && canManageStudioCommission);
    const hasSystemSection = hasPerm('system') || canManageCommissionPage || hasPerm('sys_vip') || hasPerm('sys_roles') || hasPerm('sys_settings') || hasPerm('sys_logs');
%>

<link rel="stylesheet" href="/css/vip-badge.css">
<link rel="stylesheet" href="/css/wallet_card.css">
<link rel="stylesheet" href="/css/admin-layout.css">
<script src="/js/csrf.js" defer></script>
<script src="/js/adminSidebar.js" defer></script>
<style>
    .mihu-sidebar {
        width: 280px !important;
        min-width: 280px !important;
        max-width: 280px !important;
        background-color: #131021;
        border-right: 1px solid rgba(168, 85, 247, 0.2);
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start;
        padding: 24px 16px;
        flex-shrink: 0;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .sidebar-brand-clean {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 10px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 12px;
        width: 100%;
    }

    .brand-logo-clean {
        width: 170px !important;
        max-width: 170px !important;
        height: auto !important;
        object-fit: contain !important;
        filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.5));
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brand-logo-clean:hover { transform: scale(1.05); }

    .sidebar-menu { 
        display: flex !important; 
        flex-direction: column !important; 
        gap: 4px !important; 
        width: 100%;
    }

    .menu-label { 
        font-size: 0.74rem; 
        color: #8b83a8; 
        padding: 14px 14px 4px; 
        text-transform: uppercase; 
        font-weight: 700; 
        letter-spacing: 0.8px;
        display: block;
    }

    .menu-item {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 10px 14px !important;
        border-radius: 12px !important;
        color: #9ca3af !important;
        text-decoration: none !important;
        font-size: 0.92rem !important;
        font-weight: 500 !important;
        transition: all 0.2s ease !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .menu-item i { width: 18px; text-align: center; }
    .menu-item:hover, .menu-item.active {
        color: #fff !important;
        background: rgba(168, 85, 247, 0.15) !important;
        border: 1px solid rgba(168, 85, 247, 0.25) !important;
    }
    .menu-item.active i { color: #c084fc !important; }

    .sidebar-collapse-wrap { display: flex; flex-direction: column; width: 100%; }
    .collapse-arrow { transition: transform 0.25s ease; }
    .menu-item[aria-expanded="true"] .collapse-arrow { transform: rotate(180deg); color: #fff !important; }
    
    .sidebar-submenu-items {
        margin-left: 20px;
        padding-left: 10px;
        border-left: 2px dashed rgba(168, 85, 247, 0.25);
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 4px;
        margin-bottom: 6px;
    }
    .submenu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .submenu-item i { width: 16px; text-align: center; font-size: 0.8rem; }
    .submenu-item:hover { color: #fff; background: rgba(168, 85, 247, 0.12); }
    .submenu-item.active-staff {
        color: #ffffff !important;
        background: rgba(16, 185, 129, 0.18) !important;
        font-weight: 700 !important;
    }
</style>

<aside class="mihu-sidebar" id="mihuSidebar" aria-label="主要導覽">
    <div class="sidebar-brand-clean">
        <img src="/images/logo2.png" alt="米胡電競" class="brand-logo-clean" onerror="this.src='/images/logo.png'">
        <button type="button" class="admin-sidebar-close" aria-label="關閉導覽選單" title="關閉導覽選單">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <% if (hasPerm('home')) { %>
            <div class="menu-label">首頁</div>
            <a href="/dashboard" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-house" style="color: #fbbf24;"></i>
                <span class="fw-semibold">首頁</span>
            </a>
        <% } %>

        <% if (hasPersonalSection) { %>
            <div class="menu-label">個人</div>
            
            <% if (hasPerm('profile')) { %>
                <a href="/profile" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'active' : '' %>">
                    <i class="fa-solid fa-user-gear" style="color: #c084fc;"></i>
                    <span class="fw-semibold">個人檔案</span>
                </a>
            <% } %>

            <% if (hasPerm('my_wallet')) { %>
                <a href="/wallet" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'wallet' ? 'active' : '' %>">
                    <i class="fa-solid fa-wallet" style="color: #38bdf8;"></i>
                    <span class="fw-semibold">我的錢包</span>
                </a>
            <% } %>

            <% if (hasPerm('my_income')) { %>
                <a href="/income" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'income' ? 'active' : '' %>">
                    <i class="fa-solid fa-sack-dollar" style="color: #fde047;"></i>
                    <span class="fw-semibold">我的收入</span>
                </a>
            <% } %>

            <% if (hasPerm('my_orders')) { %>
                <a href="/my-orders" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'my_orders' ? 'active' : '' %>">
                    <i class="fa-solid fa-receipt" style="color: #ec4899;"></i>
                    <span class="fw-semibold">我的訂單</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasManageSection) { %>
            <div class="menu-label">管理</div>

            <% if (hasPerm('manage')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseOperation" class="menu-item d-flex justify-content-between align-items-center" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseOperation">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-chart-pie" style="color: #f59e0b;"></i>
                            <span class="text-white fw-semibold">營運總覽</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse" id="collapseOperation">
                        <div class="sidebar-submenu-items">
                            <a href="javascript:void(0)" class="submenu-item under-construction" data-feature="公司營運統計">
                                <i class="fa-solid fa-chart-line"></i>
                                <span>公司營運統計</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasPerm('manage_members')) { %>
                <a href="/management/members" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'members' ? 'active' : '' %>">
                    <i class="fa-solid fa-users" style="color: #38bdf8;"></i>
                    <span class="fw-semibold">會員管理</span>
                </a>
            <% } %>

            <% if (hasPerm('manage_staff') || hasPerm('staff_view_payroll') || hasPerm('payout.view')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseStaff" class="menu-item d-flex justify-content-between align-items-center <%= typeof activePage !== 'undefined' && (activePage === 'staff' || activePage === 'payroll') ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= typeof activePage !== 'undefined' && (activePage === 'staff' || activePage === 'payroll') ? 'true' : 'false' %>" aria-controls="collapseStaff">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-id-badge" style="color: #10b981;"></i>
                            <span class="text-white fw-semibold"><%= hasPerm('manage_staff') ? '員工管理' : '薪資管理' %></span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= typeof activePage !== 'undefined' && (activePage === 'staff' || activePage === 'payroll') ? 'show' : '' %>" id="collapseStaff">
                        <div class="sidebar-submenu-items">
                            <% if (hasPerm('manage_staff')) { %>
                                <a href="/management/staff" class="submenu-item <%= typeof activePage !== 'undefined' && activePage === 'staff' ? 'active-staff' : '' %>">
                                    <i class="fa-solid fa-users-gear" style="color: #10b981;"></i>
                                    <span>員工列表</span>
                                </a>
                            <% } %>
                            <!-- 🚀 正式開放進入薪轉管理頁面 -->
                            <% if (hasPerm('staff_view_payroll') || hasPerm('payout.view')) { %>
                                <a href="/management/payroll" class="submenu-item <%= typeof activePage !== 'undefined' && activePage === 'payroll' ? 'active-staff' : '' %>">
                                    <i class="fa-solid fa-money-check-dollar" style="color: #fde047;"></i>
                                    <span>薪轉管理</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasPerm('manage_orders')) { %>
                <a href="/management/orders" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">
                    <i class="fa-solid fa-list-check" style="color: #ec4899;"></i>
                    <span class="fw-semibold">訂單管理</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasSystemSection) { %>
            <div class="menu-label">系統</div>

            <% if (hasPerm('sys_settings')) { %>
                <a href="/system/bot-settings" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'bot_settings' ? 'active' : '' %>">
                    <i class="fa-solid fa-robot" style="color: #38bdf8;"></i>
                    <span class="fw-semibold">機器人設定</span>
                </a>
            <% } %>

            <% if (canManageCommissionPage) { %>
                <a href="/management/commission" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'commission' ? 'active' : '' %>">
                    <i class="fa-solid fa-percent" style="color: #fde047;"></i>
                    <span class="fw-semibold">抽佣設定</span>
                </a>
            <% } %>

            <% if (hasPerm('sys_vip')) { %>
                <a href="/system/vip" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'vip' ? 'active' : '' %>">
                    <i class="fa-solid fa-crown" style="color: #fde047;"></i>
                    <span class="fw-semibold">VIP設定</span>
                </a>
            <% } %>

            <% if (hasPerm('sys_roles')) { %>
                <a href="/system/roles" class="menu-item <%= typeof activePage !== 'undefined' && activePage === 'roles' ? 'active' : '' %>">
                    <i class="fa-solid fa-shield-halved" style="color: #34d399;"></i>
                    <span class="fw-semibold">身分管理</span>
                </a>
            <% } %>

            <% if (hasPerm('sys_settings')) { %>
                <a href="javascript:void(0)" class="menu-item under-construction" data-feature="系統設定">
                    <i class="fa-solid fa-sliders"></i>
                    <span>系統設定</span>
                </a>
            <% } %>

            <% if (hasPerm('sys_logs')) { %>
                <a href="javascript:void(0)" class="menu-item under-construction" data-feature="操作紀錄">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>操作紀錄</span>
                </a>
            <% } %>
        <% } %>
    </div>
</aside>