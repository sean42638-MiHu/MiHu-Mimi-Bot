<%
    const perms = (typeof userPerms !== 'undefined' && userPerms) ? userPerms : [];
    const currUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};

    const canAccess = typeof hasPerm === 'function'
        ? hasPerm
        : node => perms.includes('*') || perms.includes(node);

    const hasPersonalSection = canAccess('personal') || canAccess('profile') || canAccess('my_wallet') || canAccess('my_income') || canAccess('my_orders');
    const hasMemberSection = canAccess('members.view') || canAccess('member_ledger.view');
    const hasManageSection = canAccess('analytics.view') || hasMemberSection || canAccess('staff.view') || canAccess('payroll.view') || canAccess('payout.view') || canAccess('orders.view');
    const canManageCommissionPage = canAccess('commission.view');
    const hasSystemSection = canManageCommissionPage || canAccess('vip.view') || canAccess('roles.view') || canAccess('audit_logs.view') || canAccess('system_settings.view') || canAccess('discord_control.view') || canAccess('system_health.view');
    const currentPage = typeof activePage !== 'undefined' ? activePage : '';
    const isAnalyticsPage = currentPage === 'analytics';
    const isMemberPage = currentPage === 'members' || currentPage === 'member_transactions';
    const isStaffPage = currentPage === 'staff' || currentPage === 'payroll';
%>

<link rel="stylesheet" href="/css/vip-badge.css">
<link rel="stylesheet" href="/css/wallet_card.css">
<link rel="stylesheet" href="/css/admin-layout.css">
<link rel="stylesheet" href="/css/admin-components.css">
<script src="/js/csrf.js" defer></script>
<script src="/js/adminSidebar.js" defer></script>
<script src="/js/admin-feedback.js" defer></script>
<style>
    .mihu-sidebar {
        width: 280px !important;
        min-width: 280px !important;
        max-width: 280px !important;
        background-color: #131021;
        border-right: 1px solid rgba(168, 85, 247, 0.2);
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start;
        padding: 24px 16px;
        flex-shrink: 0;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .sidebar-brand-clean {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 10px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 12px;
        width: 100%;
    }

    .brand-logo-clean {
        width: 170px !important;
        max-width: 170px !important;
        height: auto !important;
        object-fit: contain !important;
        filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.5));
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brand-logo-clean:hover { transform: scale(1.05); }

    .sidebar-menu { 
        display: flex !important; 
        flex-direction: column !important; 
        gap: 4px !important; 
        width: 100%;
    }

    .menu-label { 
        font-size: 0.74rem; 
        color: #8b83a8; 
        padding: 14px 14px 4px; 
        text-transform: uppercase; 
        font-weight: 700; 
        letter-spacing: 0.8px;
        display: block;
    }

    .menu-item {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 10px 14px !important;
        border-radius: 12px !important;
        color: #9ca3af !important;
        text-decoration: none !important;
        font-size: 0.92rem !important;
        font-weight: 500 !important;
        transition: all 0.2s ease !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .menu-item i { width: 18px; text-align: center; }
    .menu-item:hover, .menu-item.active {
        color: #fff !important;
        background: rgba(168, 85, 247, 0.15) !important;
        border: 1px solid rgba(168, 85, 247, 0.25) !important;
    }
    .menu-item.active i { color: #c084fc !important; }
    .menu-item.locked,
    .menu-item.locked.active,
    .submenu-item.locked,
    .submenu-item.locked.active-staff {
        color: #64748b !important;
        background: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
        cursor: not-allowed;
        opacity: .62;
    }
    .menu-item.locked i, .submenu-item.locked i { color: #64748b !important; }
    .menu-item.locked:hover, .submenu-item.locked:hover { color: #94a3b8 !important; background: rgba(100, 116, 139, .05) !important; }
    .menu-item.locked, .submenu-item.locked { appearance: none; text-align: left; }

    .sidebar-collapse-wrap { display: flex; flex-direction: column; width: 100%; }
    .collapse-arrow { transition: transform 0.25s ease; }
    .menu-item[aria-expanded="true"] .collapse-arrow { transform: rotate(180deg); }
    
    .sidebar-submenu-items {
        margin-left: 20px;
        padding-left: 10px;
        border-left: 2px dashed rgba(168, 85, 247, 0.25);
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 4px;
        margin-bottom: 6px;
    }
    .submenu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .submenu-item i { width: 16px; text-align: center; font-size: 0.8rem; }
    .submenu-item:hover { color: #fff; background: rgba(168, 85, 247, 0.12); }
    .submenu-item.active-staff {
        color: #ffffff !important;
        background: rgba(16, 185, 129, 0.18) !important;
        font-weight: 700 !important;
    }
</style>

<aside class="mihu-sidebar" id="mihuSidebar" aria-label="主要導覽">
    <div class="sidebar-brand-clean">
        <img src="/images/logo2.png" alt="米胡電競" class="brand-logo-clean" onerror="this.src='/images/logo.png'">
        <button type="button" class="admin-sidebar-close" aria-label="關閉導覽選單" title="關閉導覽選單">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <% if (canAccess('home')) { %>
            <div class="menu-label">首頁</div>
            <a href="/dashboard" class="menu-item <%= currentPage === 'dashboard' ? 'active' : '' %>" <%- currentPage === 'dashboard' ? 'aria-current="page"' : '' %>>
                <i class="fa-solid fa-house" style="color: #fbbf24;"></i>
                <span class="fw-semibold">首頁</span>
            </a>
        <% } %>

        <% if (hasPersonalSection) { %>
            <div class="menu-label">個人</div>
            
            <% if (canAccess('profile')) { %>
                <a href="/profile" class="menu-item <%= currentPage === 'profile' ? 'active' : '' %>" <%- currentPage === 'profile' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-user-gear" style="color: #c084fc;"></i>
                    <span class="fw-semibold">個人檔案</span>
                </a>
            <% } %>

            <% if (canAccess('my_wallet')) { %>
                <a href="/wallet" class="menu-item <%= currentPage === 'wallet' ? 'active' : '' %>" <%- currentPage === 'wallet' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-wallet" style="color: #38bdf8;"></i>
                    <span class="fw-semibold">我的錢包</span>
                </a>
            <% } %>

            <% if (canAccess('my_income')) { %>
                <a href="/income" class="menu-item <%= currentPage === 'income' ? 'active' : '' %>" <%- currentPage === 'income' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-sack-dollar" style="color: #fde047;"></i>
                    <span class="fw-semibold">我的收入</span>
                </a>
            <% } %>

            <% if (canAccess('my_orders')) { %>
                <a href="/my-orders" class="menu-item <%= currentPage === 'my_orders' ? 'active' : '' %>" <%- currentPage === 'my_orders' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-receipt" style="color: #ec4899;"></i>
                    <span class="fw-semibold">我的訂單</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasManageSection) { %>
            <div class="menu-label">管理</div>

            <% if (canAccess('analytics.view')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseOperation" class="menu-item d-flex justify-content-between align-items-center <%= isAnalyticsPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isAnalyticsPage ? 'true' : 'false' %>" aria-controls="collapseOperation">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-chart-pie" style="color: #f59e0b;"></i>
                            <span>營運總覽</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isAnalyticsPage ? 'show' : '' %>" id="collapseOperation">
                        <div class="sidebar-submenu-items">
                            <a href="/management/analytics" class="submenu-item <%= isAnalyticsPage ? 'active-staff' : '' %>" <%- isAnalyticsPage ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-chart-line"></i>
                                <span>公司營運統計</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasMemberSection) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseMembers" class="menu-item d-flex justify-content-between align-items-center <%= isMemberPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isMemberPage ? 'true' : 'false' %>" aria-controls="collapseMembers">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-users" style="color: #38bdf8;"></i>
                            <span>會員管理</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isMemberPage ? 'show' : '' %>" id="collapseMembers">
                        <div class="sidebar-submenu-items">
                            <% if (canAccess('members.view')) { %><a href="/management/members" class="submenu-item <%= currentPage === 'members' ? 'active-staff' : '' %>" <%- currentPage === 'members' ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-users" style="color: #38bdf8;"></i>
                                <span>會員名單</span>
                            </a><% } %>
                            <% if (canAccess('member_ledger.view')) { %><a href="/management/members/transactions" class="submenu-item <%= currentPage === 'member_transactions' ? 'active-staff' : '' %>" <%- currentPage === 'member_transactions' ? 'aria-current="page"' : '' %>>
                                <i class="fa-solid fa-wallet" style="color: #22d3ee;"></i>
                                <span>會員資金明細</span>
                            </a><% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canAccess('staff.view') || canAccess('payroll.view') || canAccess('payout.view')) { %>
                <div class="sidebar-collapse-wrap">
                    <a href="#collapseStaff" class="menu-item d-flex justify-content-between align-items-center <%= isStaffPage ? 'active' : '' %>" data-bs-toggle="collapse" role="button" aria-expanded="<%= isStaffPage ? 'true' : 'false' %>" aria-controls="collapseStaff">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-id-badge" style="color: #10b981;"></i>
                            <span>員工管理</span>
                        </div>
                        <i class="fa-solid fa-chevron-down collapse-arrow small text-secondary"></i>
                    </a>
                    <div class="collapse <%= isStaffPage ? 'show' : '' %>" id="collapseStaff">
                        <div class="sidebar-submenu-items">
                            <% if (canAccess('staff.view')) { %>
                                <a href="/management/staff" class="submenu-item <%= currentPage === 'staff' ? 'active-staff' : '' %>" <%- currentPage === 'staff' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-users-gear" style="color: #10b981;"></i>
                                    <span>員工列表</span>
                                </a>
                            <% } %>
                            <!-- 🚀 正式開放進入薪轉管理頁面 -->
                            <% if (canAccess('payroll.view') || canAccess('payout.view')) { %>
                                <a href="/management/payroll" class="submenu-item <%= currentPage === 'payroll' ? 'active-staff' : '' %>" <%- currentPage === 'payroll' ? 'aria-current="page"' : '' %>>
                                    <i class="fa-solid fa-money-check-dollar" style="color: #fde047;"></i>
                                    <span>薪轉管理</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (canAccess('orders.view')) { %>
                <a href="/management/orders" class="menu-item <%= currentPage === 'orders' ? 'active' : '' %>" <%- currentPage === 'orders' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-list-check" style="color: #ec4899;"></i>
                    <span class="fw-semibold">訂單管理</span>
                </a>
            <% } %>
        <% } %>

        <% if (hasSystemSection) { %>
            <div class="menu-label">系統</div>

            <% if (canAccess('sys_settings') || canAccess('discord_control.view')) { %>
                <a href="/system/bot-settings" class="menu-item <%= currentPage === 'bot_settings' ? 'active' : '' %>" <%- currentPage === 'bot_settings' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-robot" style="color: #38bdf8;"></i>
                    <span class="fw-semibold">機器人設定</span>
                </a>
            <% } %>

            <% if (canManageCommissionPage) { %>
                <a href="/management/commission" class="menu-item <%= currentPage === 'commission' ? 'active' : '' %>" <%- currentPage === 'commission' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-percent" style="color: #fde047;"></i>
                    <span class="fw-semibold">抽佣設定</span>
                </a>
            <% } %>

            <% if (canAccess('vip.view')) { %>
                <a href="/system/vip" class="menu-item <%= currentPage === 'vip' ? 'active' : '' %>" <%- currentPage === 'vip' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-crown" style="color: #fde047;"></i>
                    <span class="fw-semibold">VIP設定</span>
                </a>
            <% } %>

            <% if (canAccess('roles.view')) { %>
                <a href="/system/roles" class="menu-item <%= currentPage === 'roles' ? 'active' : '' %>" <%- currentPage === 'roles' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-shield-halved" style="color: #34d399;"></i>
                    <span class="fw-semibold">身分管理</span>
                </a>
            <% } %>

            <% if (canAccess('system_settings.view')) { %>
                <a href="/system/settings" class="menu-item <%= currentPage === 'system_settings' ? 'active' : '' %>" <%- currentPage === 'system_settings' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-sliders" style="color: #a78bfa;"></i>
                    <span class="fw-semibold">系統設定</span>
                </a>
            <% } %>

            <% if (canAccess('audit_logs.view')) { %>
                <a href="/system/audit-logs" class="menu-item <%= currentPage === 'audit_logs' ? 'active' : '' %>" <%- currentPage === 'audit_logs' ? 'aria-current="page"' : '' %>>
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>操作紀錄</span>
                </a>
            <% } %>
                <% if (canAccess('system_health.view')) { %>
                    <a href="/system/health" class="menu-item <%= currentPage === 'system_health' ? 'active' : '' %>" <%- currentPage === 'system_health' ? 'aria-current="page"' : '' %>>
                        <i class="fa-solid fa-heart-pulse"></i>
                        <span>系統狀態</span>
                    </a>
                <% } %>
        <% } %>
    </div>
</aside>
<%- include('../modals/coming_soon_modal') %>
<%- include('../modals/admin_confirm_modal') %>
<%- include('admin_toast_container', { flashData: typeof flashData !== 'undefined' ? flashData : {} }) %>
<script src="/js/coming-soon.js" defer></script>
