<%
    const activeUser = (typeof user !== 'undefined' && user) ? user : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : {});
%>

<style>
    .home-card-glass {
        background: rgba(23, 19, 38, 0.85);
        border: 1px solid rgba(168, 85, 247, 0.2);
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(15px);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .home-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        width: 100%;
    }
    .home-card-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #ffffff;
    }

    /* 🚀 核心置中容器：將內部 VIP 卡片水平與垂直完美置中 */
    .vip-card-center-container {
        flex-grow: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 10px 0;
    }

    /* 限制卡片本體在容器中的最大寬度，確保不會被拉太寬 */
    .vip-card-center-container > .vip-premium-card-frame {
        width: 100%;
        max-width: 420px;
    }
</style>

<div class="home-card-glass">
    <div class="home-card-header">
        <i class="fa-solid fa-wallet text-warning fs-5"></i>
        <div>
            <div class="home-card-title">我的錢包</div>
            <div class="text-secondary small">個人儲值餘額與尊榮 VIP 身分卡</div>
        </div>
    </div>

    <!-- 💳 完美置中區域 -->
    <div class="vip-card-center-container">
        <%- include('wallet_card', { user: activeUser, vipInfo: vipInfo, mode: 'compact' }) %>
    </div>
</div>