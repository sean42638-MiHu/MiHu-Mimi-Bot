<%
    const detail = incomeDetail || {};
    const summary = detail.summary || {};
    const rows = Array.isArray(detail.rows) ? detail.rows : [];
    const categoryTotals = Array.isArray(detail.categoryTotals) ? detail.categoryTotals : [];
    const monthlySummary = incomeMonthlySummary || {};
    const summaryRows = Array.isArray(monthlySummary.rows) ? monthlySummary.rows : [];
    const summaryTotals = monthlySummary.totals || { monthlyNetAmount: 0, paidAmount: 0, pendingAmount: 0, availableAmount: 0 };
    const summaryLimitations = Array.isArray(monthlySummary.limitations) && monthlySummary.limitations.length
        ? monthlySummary.limitations
        : [
            '明細以訂單結束時間或建立時間（缺少結束時間時）與薪資調整 adjustment_month 歸屬月份。',
            '跨月調價或退款若未建立可追蹤薪資校正事件，系統不會自動回沖歷史月報。',
            '會員錢包消費與退款流水不納入陪陪薪資收入或扣減。'
        ];
    const currentMonth = detail.month || incomeSummaryMonth || '';
    const currentPage = Number(detail.page || 1);
    const totalPages = Number(detail.totalPages || 1);
    const hasPrev = currentPage > 1;
    const hasNext = currentPage < totalPages;
    const typeLabels = {
        commission: '訂單分潤',
        fixed_salary: '固定月薪',
        earned_adjustment: '收入調整',
        allowance: '薪資津貼',
        deduction: '合法薪資扣減',
        history_adjustment: '歷史收入校正'
    };

    const parseAmount = value => {
        const amount = Number(value || 0);
        return Number.isFinite(amount) ? amount : 0;
    };

    const normalizeZero = value => {
        const amount = parseAmount(value);
        return Math.abs(amount) < 0.000001 ? 0 : amount;
    };

    const formatSignedAmount = value => {
        const amount = normalizeZero(value);
        const absText = Math.abs(amount).toLocaleString();
        if (amount > 0) return `+$${absText}`;
        if (amount < 0) return `-$${absText}`;
        return `$${absText}`;
    };

    const amountClass = value => {
        const amount = normalizeZero(value);
        if (amount > 0) return 'amount-positive';
        if (amount < 0) return 'amount-negative';
        return 'amount-zero';
    };

    const categoryTone = row => {
        const entryType = String(row && row.entryType || '').trim();
        const category = String(row && row.category || '').trim();
        if (entryType === 'commission') {
            const knownCommissionCategories = new Set(['陪玩單', '禮物單', '有獎單', '冠名單', '其他單', '獎金單']);
            return knownCommissionCategories.has(category) ? 'tone-commission' : 'tone-fallback';
        }
        if (entryType === 'allowance' || category.includes('獎金')) return 'tone-allowance';
        if (entryType === 'deduction') return 'tone-deduction';
        return 'tone-fallback';
    };
%>

<div class="modal fade income-ledger-modal" id="incomeLedgerModal" tabindex="-1" aria-labelledby="incomeLedgerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: 820px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="incomeLedgerModalLabel"><i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>薪資與分潤明細</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                <form method="GET" action="/income" class="income-ledger-filter-bar" data-income-ledger-filter-form="true">
                    <input type="hidden" name="income_modal" value="1">
                    <input type="hidden" name="income_page" value="1">
                    <input type="hidden" name="summary_month" value="<%= currentMonth %>">
                    <div class="income-ledger-filter-month">
                        <label for="incomeSummaryMonthInput" class="form-label small text-secondary mb-1">查詢月份</label>
                        <input type="month" id="incomeSummaryMonthInput" name="income_month" value="<%= currentMonth %>" class="form-control form-control-sm" required>
                    </div>
                    <div class="income-ledger-filter-submit">
                        <button type="submit" class="btn btn-sm w-100 fw-semibold" data-income-ledger-update-button="true">更新明細</button>
                    </div>
                    <div class="income-ledger-filter-summary text-secondary small">
                        <span>共 <%= Number(detail.totalRows || 0).toLocaleString() %> 筆 · 第 <%= currentPage %> / <%= totalPages %> 頁</span>
                    </div>
                </form>

                <div class="income-ledger-state income-ledger-state-loading" id="incomeLedgerLoadingState" hidden>
                    <i class="fa-solid fa-rotate fa-spin me-2"></i>讀取明細中...
                </div>

                <div class="d-flex justify-content-end mb-2">
                    <button
                        type="button"
                        class="btn btn-sm income-neon-badge-btn"
                        data-bs-toggle="collapse"
                        data-bs-target="#incomeLedgerNoticeCollapse"
                        aria-expanded="false"
                        aria-controls="incomeLedgerNoticeCollapse">
                        注意事項
                    </button>
                </div>

                <div class="collapse mb-3" id="incomeLedgerNoticeCollapse">
                    <div class="income-ledger-note" role="note">
                        <% summaryLimitations.forEach(item => { %>
                            <p class="mb-1">• <%= item %></p>
                        <% }) %>
                    </div>
                </div>

                <section class="income-summary-shell mb-3" aria-labelledby="incomeSummaryModalTitle">
                    <div class="income-summary-header">
                        <div>
                            <h6 class="text-white mb-1" id="incomeSummaryModalTitle"><i class="fa-solid fa-chart-column text-warning me-2"></i>薪資摘要（按分類統計）</h6>
                            <p class="income-summary-sub">本表顯示當月收入與扣減分類；淨薪資採用 總收入 - 總扣減，並不等於已撥款實領。</p>
                        </div>
                    </div>
                    <div class="income-summary-kpis">
                        <span class="income-summary-kpi">本月薪資淨額：<strong id="incomeMonthlyNetAmount">$<%= Number(summaryTotals.monthlyNetAmount || 0).toLocaleString() %></strong></span>
                        <span class="income-summary-kpi">已實領：<strong id="incomePaidAmount">$<%= Number(summaryTotals.paidAmount || 0).toLocaleString() %></strong></span>
                        <span class="income-summary-kpi">申請中：<strong id="incomePendingAmount">$<%= Number(summaryTotals.pendingAmount || 0).toLocaleString() %></strong></span>
                        <span class="income-summary-kpi">可提領：<strong id="incomeAvailableAmount">$<%= Number(summaryTotals.availableAmount || 0).toLocaleString() %></strong></span>
                    </div>
                    <div class="table-responsive income-summary-table-wrap">
                        <table class="table table-dark table-sm align-middle mb-0 income-summary-table" id="incomeSummaryTable">
                            <thead>
                                <tr>
                                    <th>收入／扣款類別</th>
                                    <th class="text-center">筆數／單數</th>
                                    <th class="text-end">總金額</th>
                                    <th class="income-summary-col-desc">說明</th>
                                    <th class="income-summary-col-action">查看明細</th>
                                </tr>
                            </thead>
                            <tbody id="incomeSummaryTableBody">
                                <% if (!summaryRows.length) { %>
                                    <tr><td colspan="5" class="text-center py-3 text-secondary">本月沒有可顯示的薪資與分潤項目</td></tr>
                                <% } %>
                                <% summaryRows.forEach(item => { %>
                                    <% const signedAmount = Number(item.totalAmount || 0); %>
                                    <% const signedClass = signedAmount > 0 ? 'income-amount-positive' : (signedAmount < 0 ? 'income-amount-negative' : 'income-amount-zero'); %>
                                    <tr>
                                        <td><span class="income-category-chip"><%= item.category %></span></td>
                                        <td class="text-center"><%= item.countLabel %></td>
                                        <td class="text-end <%= signedClass %>"><%= signedAmount > 0 ? '+' : (signedAmount < 0 ? '-' : '') %>$<%= Math.abs(signedAmount).toLocaleString() %></td>
                                        <td class="income-summary-col-desc"><%= (item.descriptions || []).join('、') || '-' %></td>
                                        <td class="income-summary-col-action">
                                            <button
                                                type="button"
                                                class="btn btn-sm income-neon-detail-btn income-open-detail"
                                                data-source-type="<%= item.sourceType %>"
                                                data-category="<%= item.category %>">
                                                查看明細
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <p class="text-danger small mt-2 mb-0" id="incomeSummaryError" hidden></p>
                </section>

                <div class="small text-secondary mb-2">薪資流水明細（含分潤、固定月薪、津貼與扣減分錄）</div>

                <% if (categoryTotals.length) { %>
                    <div class="mb-3 d-flex flex-wrap gap-2 income-ledger-category-totals">
                        <% categoryTotals.forEach(item => { %>
                            <span class="badge">
                                <%= item.category %>：$<%= Number(item.amount || 0).toLocaleString() %>
                            </span>
                        <% }) %>
                    </div>
                <% } %>

                <div class="table-responsive income-ledger-table-wrap">
                    <table class="table table-sm align-middle mb-2 income-ledger-table">
                        <thead>
                            <tr>
                                <th>時間</th>
                                <th>分類</th>
                                <th>來源</th>
                                <th class="text-end">金額 (NTD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!rows.length) { %>
                                <tr class="income-ledger-empty-row">
                                    <td colspan="4" class="text-center py-4">本月尚無薪資或分潤明細</td>
                                </tr>
                            <% } %>
                            <% rows.forEach(row => { %>
                                <tr>
                                    <td><%= (row.occurredAt || '').replace('T', ' ').slice(0, 16) || '-' %></td>
                                    <td>
                                        <span class="income-ledger-category-pill <%= categoryTone(row) %>"><%= row.category || '-' %></span>
                                    </td>
                                    <td class="income-ledger-source-cell">
                                        <div class="income-ledger-source-title"><%= typeLabels[row.entryType] || row.entryType || '收入' %></div>
                                        <div class="income-ledger-source-desc"><%= row.description || '-' %></div>
                                    </td>
                                    <td class="text-end <%= amountClass(row.amount) %>">
                                        <%= formatSignedAmount(row.amount) %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2 income-ledger-pagination">
                    <a class="btn btn-sm income-ledger-page-btn <%= hasPrev ? '' : 'disabled' %>" href="/income?income_modal=1&income_month=<%= encodeURIComponent(currentMonth) %>&summary_month=<%= encodeURIComponent(currentMonth) %>&income_page=<%= Math.max(1, currentPage - 1) %>" aria-disabled="<%= hasPrev ? 'false' : 'true' %>" <%= hasPrev ? '' : 'tabindex="-1"' %>>上一頁</a>
                    <span class="small text-secondary">第 <%= currentPage %> / <%= totalPages %> 頁</span>
                    <a class="btn btn-sm income-ledger-page-btn <%= hasNext ? '' : 'disabled' %>" href="/income?income_modal=1&income_month=<%= encodeURIComponent(currentMonth) %>&summary_month=<%= encodeURIComponent(currentMonth) %>&income_page=<%= Math.min(totalPages, currentPage + 1) %>" aria-disabled="<%= hasNext ? 'false' : 'true' %>" <%= hasNext ? '' : 'tabindex="-1"' %>>下一頁</a>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm income-ledger-close-btn" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>
