<section class="admin-panel salary-section salary-overview-panel mb-4 p-3 p-lg-4 rounded-3" style="background:linear-gradient(160deg, rgba(30, 20, 52, 0.9), rgba(11, 9, 24, 0.95));border:1px solid rgba(196, 129, 255, 0.34);box-shadow:0 24px 44px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.04);backdrop-filter:blur(12px);">
    <div class="salary-overview-head mb-3">
        <div>
            <h2 class="h5 mb-1">本月薪資總覽 <span class="text-secondary">(<%= month %>)</span></h2>
            <p class="small text-secondary mb-0">共 <%= totalStaff %> 位員工，每頁 <%= pageSize || 15 %> 位</p>
        </div>
    </div>

    <form method="get" action="/management/salary-settings" class="row g-2 align-items-end salary-filter-form mb-3">
        <div class="col-12 col-md-3">
            <label class="small text-secondary" for="monthFilter">月份</label>
            <input id="monthFilter" class="form-control form-control-sm" type="month" name="month" value="<%= month %>">
        </div>
        <div class="col-12 col-md-6">
            <label class="small text-secondary" for="salarySearch">搜尋員工</label>
            <input id="salarySearch" class="form-control form-control-sm" type="search" name="q" value="<%= search %>" placeholder="名稱、暱稱或 Discord ID">
        </div>
        <div class="col-12 col-md-3 text-md-end">
            <button class="btn btn-sm salary-filter-submit" type="submit">套用篩選</button>
        </div>
    </form>

    <div class="salary-distribute-status <%= distStatus.locked ? 'is-locked' : 'is-open' %>">
        <div class="salary-distribute-title"><%= distStatus.message %></div>
        <div class="small text-secondary">規則：<%= distStatus.totalRules %>，已完成：<%= distStatus.committedRules %>，待派發：<%= distStatus.pendingRules %></div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-sm align-middle mb-0 salary-table">
            <thead>
                <tr>
                    <th>員工</th>
                    <th class="text-end">歷史收入</th>
                    <th class="text-end">已請款</th>
                    <th class="text-end">待請款</th>
                    <th class="text-end">調整累計</th>
                    <th class="text-end">可提領（調整後）</th>
                    <th class="text-end">固定月薪規則</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                <% if (!salaryRows.length) { %>
                    <tr><td colspan="8" class="text-center text-secondary py-4">目前沒有可顯示的薪資資料</td></tr>
                <% } %>
                <% salaryRows.forEach(row => { %>
                    <% const roleKey = String(row.role || 'staff').toLowerCase(); %>
                    <% const roleBadgeClass = roleBadgeMap[roleKey] || 'role-badge role-badge-member'; %>
                    <% const roleLabel = roleNameMap[roleKey] || roleKey; %>
                    <tr>
                        <td>
                            <div class="salary-staff-cell">
                                <div class="salary-staff-title"><%= row.displayName %></div>
                                <div class="salary-staff-meta">
                                    <span class="salary-staff-id"><%= row.userId %></span>
                                    <span class="<%= roleBadgeClass %>"><%= roleLabel %></span>
                                </div>
                            </div>
                        </td>
                        <td class="text-end">$<%= Number(row.earnedSalary).toLocaleString() %></td>
                        <td class="text-end">$<%= Number(row.paidAmount).toLocaleString() %></td>
                        <td class="text-end">$<%= Number(row.pendingAmount).toLocaleString() %></td>
                        <td class="text-end"><span class="<%= row.adjustmentAmount >= 0 ? 'text-success' : 'text-danger' %>">$<%= Number(row.adjustmentAmount).toLocaleString() %></span></td>
                        <td class="text-end fw-semibold">$<%= Number(row.adjustedAvailableAmount).toLocaleString() %></td>
                        <td class="text-end">
                            <% if (row.fixedSalaryRules.length) { %>
                                <% row.fixedSalaryRules.forEach(rule => { %>
                                    <div><%= rule.itemName %> $<%= Number(rule.amount).toLocaleString() %></div>
                                <% }) %>
                            <% } else { %>
                                <span class="text-secondary">未設定</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <div class="salary-row-actions">
                                <button
                                    type="button"
                                    class="btn btn-sm salary-row-history"
                                    data-user-id="<%= row.userId %>"
                                    data-display-name="<%= row.displayName %>"
                                >調整紀錄</button>
                                <% if (canSalaryAdjust) { %>
                                    <button
                                        type="button"
                                        class="btn btn-sm salary-row-adjust"
                                        data-user-id="<%= row.userId %>"
                                        data-display-name="<%= row.displayName %>"
                                        data-role-key="<%= roleKey %>"
                                        data-role-badge-class="<%= roleBadgeClass %>"
                                        data-role-name="<%= roleLabel %>"
                                    >快速調整</button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <% if (totalPages > 1) { %>
        <% const previousPage = Math.max(1, page - 1); %>
        <% const nextPage = Math.min(totalPages, page + 1); %>
        <div class="salary-pagination mt-3">
            <a class="btn btn-sm salary-pager-btn <%= page <= 1 ? 'disabled' : '' %>" <%= page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %> href="/management/salary-settings?month=<%= encodeURIComponent(month) %>&q=<%= encodeURIComponent(search) %>&page=<%= previousPage %>">上一頁</a>
            <span class="salary-pagination-current">第 <%= page %> / <%= totalPages %> 頁</span>
            <a class="btn btn-sm salary-pager-btn <%= page >= totalPages ? 'disabled' : '' %>" <%= page >= totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %> href="/management/salary-settings?month=<%= encodeURIComponent(month) %>&q=<%= encodeURIComponent(search) %>&page=<%= nextPage %>">下一頁</a>
        </div>
    <% } %>
</section>

<section class="admin-panel salary-section p-3 p-lg-4 rounded-3">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2 flex-wrap">
        <h2 class="h6 mb-0">最近調整摘要</h2>
        <span class="small text-secondary">完整明細可由頁面頂部操作列開啟</span>
    </div>
    <div class="small text-secondary mb-2">顯示最近 <%= Math.min(5, recentAdjustments.length) %> 筆，完整資料可在「調整紀錄」查詢與分頁。</div>
    <div class="salary-latest-feed">
        <% if (!recentAdjustments.length) { %>
            <div class="text-secondary">目前沒有調整紀錄</div>
        <% } else { %>
            <% recentAdjustments.slice(0, 5).forEach(row => { %>
                <div class="salary-latest-item">
                    <span class="salary-latest-time"><%= row.created_at %></span>
                    <span class="salary-latest-name"><%= row.custom_nickname || row.global_name || row.username || row.user_id %></span>
                    <span class="salary-latest-type"><%= row.adjustment_type %></span>
                    <span class="<%= row.amount >= 0 ? 'text-success' : 'text-danger' %>">$<%= Number(row.amount).toLocaleString() %></span>
                    <span class="salary-latest-reason"><%= row.reason %></span>
                </div>
            <% }) %>
        <% } %>
    </div>
</section>
