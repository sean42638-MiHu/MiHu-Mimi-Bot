<!-- 📊 模組化：訂單清單表格組件 (獨立滾動高 + 狀態樣式 + 店長批量刪除勾選) -->
<style>
    .glass-table-card {
        background: rgba(23, 19, 38, 0.85) !important;
        border: 1px solid rgba(168, 85, 247, 0.2) !important;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
    }

    .table-responsive-scroll {
        margin: 0;
        max-height: 500px;
        overflow-y: auto !important;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(168, 85, 247, 0.4) transparent;
    }
    .table-responsive-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .table-responsive-scroll::-webkit-scrollbar-thumb {
        background: rgba(168, 85, 247, 0.4);
        border-radius: 4px;
    }

    .mihu-table {
        width: 100%;
        margin-bottom: 0;
        color: #f3f4f6 !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .mihu-table th {
        background: #131021 !important;
        color: #94a3b8 !important;
        font-weight: 700;
        font-size: 0.84rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .mihu-table td {
        padding: 15px 20px;
        vertical-align: middle;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        font-size: 0.92rem;
        white-space: nowrap;
        color: #f3f4f6 !important;
    }

    .mihu-table tbody tr.order-row {
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .mihu-table tbody tr.order-row:hover {
        background: rgba(168, 85, 247, 0.12) !important;
    }

    .user-mini-col { display: flex; align-items: center; gap: 10px; }
    .user-mini-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255, 255, 255, 0.15); }

    .category-badge { font-size: 0.78rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px; }
    .badge-陪玩單   { background: rgba(168, 85, 247, 0.18); border: 1px solid rgba(168, 85, 247, 0.4); color: #d8b4fe; }
    .badge-禮物單   { background: rgba(236, 72, 153, 0.18); border: 1px solid rgba(236, 72, 153, 0.4); color: #f472b6; }
    .badge-有獎單, .badge-有獎 { background: rgba(56, 189, 248, 0.18); border: 1px solid rgba(56, 189, 248, 0.4); color: #7dd3fc; }
    .badge-冠名單, .badge-冠名 { background: rgba(245, 158, 11, 0.18); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde047; }
    .badge-獎金     { background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; }

    /* 🚀 勾選框獨立自訂樣式 */
    .order-checkbox-custom {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: #ec4899;
    }
</style>

<div class="glass-table-card">
    <div class="table-responsive-scroll">
        <table class="mihu-table" id="ordersTable">
            <thead>
                <tr>
                    <% if (typeof canBatchDeleteOrders !== 'undefined' && canBatchDeleteOrders) { %>
                        <!-- 🚀 僅限店長/最高管理員顯示勾選方塊欄 -->
                        <th style="width: 40px; text-align: center;">
                            <input type="checkbox" id="checkAllOrders" class="order-checkbox-custom" title="全選/取消全選">
                        </th>
                    <% } %>
                    <th style="width: 14%;">訂單編號</th>
                    <th style="width: 14%;">闆闆</th>
                    <th style="width: 14%;">陪陪</th>
                    <th style="width: 11%;">類別</th>
                    <th style="width: 13%;">項目</th>
                    <th style="width: 13%;">內容</th>
                    <th style="width: 9%;">數量 / 時長</th>
                    <th style="width: 12%;">訂單金額</th>
                    <th style="width: 9%; text-align: center;">狀態</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody">
                <% if (!orders || orders.length === 0) { %>
                    <tr>
                        <td colspan="<%= (typeof canBatchDeleteOrders !== 'undefined' && canBatchDeleteOrders) ? 10 : 9 %>" class="text-center py-5 text-secondary">
                            目前尚無相關訂單紀錄
                        </td>
                    </tr>
                <% } else { %>
                    <% orders.forEach(o => { 
                        const csName = o.cs_nickname || o.cs_global_name || o.cs_username || o.cs_name || '米胡客服';
                        const csAvatar = o.cs_avatar 
                            ? `https://cdn.discordapp.com/avatars/${o.cs_id}/${o.cs_avatar}.png`
                            : `https://cdn.discordapp.com/embed/avatars/2.png`;

                        const bossAvatar = o.boss_avatar 
                            ? `https://cdn.discordapp.com/avatars/${o.boss_id}/${o.boss_avatar}.png` 
                            : `https://cdn.discordapp.com/embed/avatars/0.png`;
                        const bossName = o.boss_nickname || o.boss_global_name || o.boss_username || '匿名闆闆';

                        const talentAvatar = o.talent_avatar 
                            ? `https://cdn.discordapp.com/avatars/${o.talent_id}/${o.talent_avatar}.png` 
                            : `https://cdn.discordapp.com/embed/avatars/1.png`;
                        const talentName = o.talent_id ? (o.talent_nickname || o.talent_global_name || o.talent_username || '陪玩師') : '派單中';

                        const category = o.category || o.extra || '陪玩單';
                        const itemName = o.game || o.item_name || '一般';
                        const contentTier = o.content_tier || o.note || '-';
                        const unit = o.unit || '小時';

                        const statusObj = orderStatus.getOrderStatusMeta(o.status);

                        const totalAmount = Number(o.total_amount || 0);
                        const discount = Number(o.discount || 0);
                        const originalPrice = totalAmount + discount;

                        const canEdit = true;
                        const canReassign = typeof hasPerm === 'function' && hasPerm('action_order_reassign');
                        const canAdjustPrice = typeof hasPerm === 'function' && hasPerm('action_order_price');
                        const canRefund = typeof hasPerm === 'function' && hasPerm('action_order_refund');
                        const canRefundCompleted = typeof hasPerm === 'function' && hasPerm('action_order_refund_completed');
                        const canBatchDelete = typeof canBatchDeleteOrders !== 'undefined' ? !!canBatchDeleteOrders : false;
                        const canBatchDeleteThisOrder = canBatchDelete;

                        const orderObj = {
                            id: o.id,
                            orderNo: o.order_no,
                            bossId: o.boss_id,
                            bossName: bossName,
                            bossAvatar: bossAvatar,
                            talentId: o.talent_id || '',
                            talentName: talentName,
                            talentAvatar: talentAvatar,
                            csId: o.cs_id || '',
                            csName: csName,
                            csAvatar: csAvatar,
                            category: category,
                            itemName: itemName,
                            contentTier: contentTier,
                            duration: o.duration,
                            unit: unit,
                            originalPrice: originalPrice,
                            discount: discount,
                            totalAmount: totalAmount,
                            extra: o.extra || '無特別條件',
                            note: o.note || '無特別備註',
                            talentMessage: o.talent_message || o.review_comment || '尚無留言',
                            status: o.status,
                            statusName: statusObj.label,
                            statusMeta: statusObj,
                            startTime: o.start_time || '尚未開始',
                            endTime: o.end_time || '尚未結束',
                            createdAt: o.created_at || o.created_time || o.order_date || '未記錄時間',
                            canEdit: canEdit,
                            canReassign: canReassign,
                            canAdjustPrice: canAdjustPrice,
                            canRefund: canRefund,
                            canRefundCompleted: canRefundCompleted
                        };
                    %>
                        <tr class="order-row" 
                            data-status="<%= statusObj.filterKey %>"
                            data-search="<%= `${o.order_no} ${csName} ${bossName} ${talentName} ${category} ${itemName} ${contentTier}`.toLowerCase() %>"
                            onclick="openUnifiedModal(this)">
                            
                            <!-- 🚀 隱藏欄位：注入可供彈窗開啟的單筆 JSON 數據 -->
                            <script type="application/json" class="order-data-json">
                                <%- JSON.stringify(orderObj) %>
                            </script>

                            <% if (typeof canBatchDeleteOrders !== 'undefined' && canBatchDeleteOrders) { %>
                                <!-- 🚀 僅限店長顯示 Checkbox，並使用 stopPropagation 避免點擊勾選框時誤觸展開編輯 Modal -->
                                <td style="text-align: center;" onclick="event.stopPropagation();">
                                    <% if (canBatchDeleteThisOrder) { %><input type="checkbox" class="order-checkbox order-checkbox-custom" value="<%= o.id %>"><% } %>
                                </td>
                            <% } %>

                            <td>
                                <div class="fw-bold font-monospace text-light"><%= o.order_no %></div>
                                <div class="small text-secondary font-monospace" style="font-size: 0.72rem;"><%= (o.created_at || '').slice(0, 16) %></div>
                            </td>

                            <td>
                                <div class="user-mini-col">
                                    <img src="<%= bossAvatar %>" alt="闆闆頭像" class="user-mini-avatar">
                                    <div>
                                        <div class="fw-bold text-white small"><%= bossName %></div>
                                        <div class="text-secondary font-monospace" style="font-size: 0.68rem;">•••• <%= (o.boss_id || '').slice(-4) %></div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="user-mini-col">
                                    <% if (o.talent_id) { %>
                                        <img src="<%= talentAvatar %>" alt="陪陪頭像" class="user-mini-avatar" style="border-color: rgba(168, 85, 247, 0.4);">
                                        <div>
                                            <div class="fw-bold text-light small"><%= talentName %></div>
                                            <div class="text-secondary font-monospace" style="font-size: 0.68rem;">•••• <%= (o.talent_id || '').slice(-4) %></div>
                                        </div>
                                    <% } else { %>
                                        <div class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.74rem;">
                                            <i class="fa-solid fa-hourglass-start me-1"></i>派單中
                                        </div>
                                    <% } %>
                                </div>
                            </td>

                            <td><span class="category-badge badge-<%= category %>"><%= category %></span></td>
                            <td><span class="fw-bold text-white small"><%= itemName %></span></td>
                            <td><span class="text-white-50 small text-truncate d-inline-block" style="max-width: 120px;" title="<%= contentTier %>"><%= contentTier %></span></td>
                            <td><span class="font-monospace text-light small"><%= o.duration %> <%= unit %></span></td>
                            <td><span class="font-monospace text-warning fw-bold">$<%= Number(o.total_amount).toLocaleString() %></span> <span class="small text-secondary">NTD</span></td>

                            <td class="text-center">
                                <%- include('./order_status_badge', { badge: statusObj }) %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>

        <div id="noMatchRow" class="text-center py-5 text-secondary" style="display: none;">
            <i class="fa-solid fa-receipt fs-3 mb-2 opacity-50"></i>
            <p class="small mb-0">找不到符合條件的訂單記錄</p>
        </div>
    </div>
</div>
