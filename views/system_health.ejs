<!DOCTYPE html><html lang="zh-Hant"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>系統狀態 · 米胡電競 MiHu Gaming</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><link rel="stylesheet" href="/css/system-health.css"></head><body class="mihu-admin-page text-light"><div class="app-layout"><%- include('partials/sidebar', { activePage: 'system_health' }) %><div class="main-wrapper"><%- include('partials/navbar', { activePage: 'system_health' }) %><main class="content-body admin-page-content health-page"><%- include('partials/admin_page_header', { icon: 'fa-heart-pulse', title: 'System Health', description: '查看 Web、資料庫、Discord Runtime 與系統資源狀態' }) %><% if (error) { %><div class="admin-error-state" role="alert"><div class="admin-error-state__icon"><i class="fa-solid fa-triangle-exclamation"></i></div><strong class="admin-error-state__title">系統狀態載入失敗</strong><p class="admin-error-state__description"><%= error %></p></div><% } else if (health) { %><div class="health-overview"><div class="health-overall"><span class="health-dot" aria-hidden="true"></span><strong data-health-overall><%= health.overall %></strong></div><p class="health-updated">最後更新：<time data-health-updated datetime="<%= health.generatedAt %>"><%= new Date(health.generatedAt).toLocaleTimeString('zh-TW') %></time></p></div><div class="health-grid"><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Web Server</h2><span class="admin-badge admin-badge-success" data-health-web-status><%= health.web.status %></span></div><div class="health-card__rows"><div class="health-card__row"><span>Uptime</span><strong data-health-web-uptime><%= health.web.uptime %></strong></div><div class="health-card__row"><span>Node</span><strong><%= health.web.node %></strong></div><div class="health-card__row"><span>Environment</span><strong><%= health.web.environment %></strong></div><div class="health-card__row"><span>Platform</span><strong><%= health.web.platform %></strong></div></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Database</h2><span class="admin-badge admin-badge-success" data-health-db-status><%= health.database.status %></span></div><div class="health-card__rows"><div class="health-card__row"><span>Response Time</span><strong data-health-db-ms><%= health.database.responseMs %> ms</strong></div><div class="health-card__row"><span>Probe</span><strong>SELECT 1</strong></div></div><p class="health-error" data-health-error hidden></p></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Discord Bot</h2><span class="admin-badge admin-badge-muted" data-health-bot-status><%= health.bot.status %></span></div><div class="health-card__rows"><div class="health-card__row"><span>Configured</span><strong><%= health.bot.configured ? 'CONFIGURED' : 'NOT CONFIGURED' %></strong></div><div class="health-card__row"><span>Ready</span><strong><%= health.bot.ready ? 'ONLINE' : 'NOT STARTED' %></strong></div><div class="health-card__row"><span>Username</span><strong data-health-bot-user><%= health.bot.username || '—' %></strong></div><div class="health-card__row"><span>Commands</span><strong><%= health.bot.commandCount %></strong></div></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Discord OAuth</h2><span class="admin-badge <%= health.oauth.clientConfigured && health.oauth.secretConfigured ? 'admin-badge-success' : 'admin-badge-muted' %>" data-health-oauth-status><%= health.oauth.clientConfigured && health.oauth.secretConfigured ? 'CONFIGURED' : 'MISSING' %></span></div><div class="health-card__rows"><div class="health-card__row"><span>Client ID</span><strong><%= health.oauth.clientConfigured ? 'CONFIGURED' : 'MISSING' %></strong></div><div class="health-card__row"><span>Client Secret</span><strong><%= health.oauth.secretConfigured ? 'CONFIGURED' : 'MISSING' %></strong></div><div class="health-card__row"><span>Callback</span><strong><%= health.oauth.callbackConfigured ? 'CONFIGURED' : 'MISSING' %></strong></div></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Guild Configuration</h2><span class="admin-badge admin-badge-info" data-health-guild-status>—</span></div><div class="health-card__rows"><% Object.entries(health.discord.guilds).forEach(([key, guild]) => { %><div class="health-card__row"><span><%= guild.label %></span><strong><%= guild.configured ? 'CONFIGURED' : 'MISSING' %></strong></div><% }) %></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Command Deployment</h2><span class="admin-badge admin-badge-muted">READ ONLY</span></div><div class="health-card__rows"><div class="health-card__row"><span>DEV</span><strong data-health-deploy-dev><%= health.discord.deployment.development ? (health.discord.deployment.development.success ? '成功' : '失敗') : '尚無紀錄' %></strong></div><div class="health-card__row"><span>Production</span><strong data-health-deploy-prod><%= health.discord.deployment.production ? (health.discord.deployment.production.success ? '成功' : '失敗') : '尚無紀錄' %></strong></div></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Runtime</h2><span class="admin-badge admin-badge-info"><%= health.runtime.appEnvironment %></span></div><div class="health-card__rows"><div class="health-card__row"><span>Discord Enabled</span><strong><%= health.runtime.discordEnabled ? 'YES' : 'NO' %></strong></div><div class="health-card__row"><span>Process Uptime</span><strong><%= health.web.uptime %></strong></div></div></article><article class="admin-panel health-card"><div class="health-card__header"><h2 class="health-card__title">Memory</h2><span class="admin-badge admin-badge-info">PROCESS</span></div><div class="health-card__rows"><div class="health-card__row"><span>RSS / Heap</span><strong data-health-memory><%= health.memory.rssMb %> MB RSS · <%= health.memory.heapUsedMb %> / <%= health.memory.heapTotalMb %> MB</strong></div></div></article></div><p class="health-updated mt-3" data-health-error hidden>狀態更新失敗</p><% } %></main></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script><script src="/js/system-health.js" defer></script></body></html>
