<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>個人檔案 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        img { max-width: 100%; height: auto; }

        .main-wrapper { 
            flex-grow: 1; 
            display: flex; 
            flex-direction: column; 
            overflow-y: auto; 
            max-height: 100vh; 
            min-width: 0;
        }

        .content-body { padding: 20px 36px 32px; flex-grow: 1; }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 14px;
            width: 100%;
        }

        .page-title-text {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
        }
        
        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 30px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            margin-bottom: 24px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }

        .privacy-badge {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #fca5a5;
            font-size: 0.76rem;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.5px;
        }

        .field-label {
            font-size: 0.84rem;
            color: #e2e8f0;
            font-weight: 600;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 11px 16px;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }
        .form-control-glass::placeholder {
            color: #94a3b8 !important;
            opacity: 1;
        }
        .form-control-glass:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: var(--mihu-purple-light);
            color: #ffffff !important;
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }

        .form-control-glass:disabled,
        .form-control-glass[readonly] {
            background-color: rgba(0, 0, 0, 0.4) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #cbd5e1 !important;
            cursor: not-allowed;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(0.85);
            cursor: pointer;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'profile' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'profile' }) %>

    <div class="content-body">
        <div class="page-header-content">
            <div>
                <div class="page-title-text">
                    <i class="fa-solid fa-user-gear text-purple-light"></i>
                    <span>個人檔案設定</span>
                </div>
                <p class="text-secondary small mb-0">管理您的個人資訊、暱稱呈現與機密薪轉帳戶資料</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12">
                <div id="profileFormAlertHost">
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success d-flex align-items-center gap-2" data-profile-alert="success" role="alert">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>個人檔案與薪轉資料已成功儲存更新！</span>
                        </div>
                    <% } %>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger py-2 px-3 small mb-4 border-0 bg-danger bg-opacity-25 text-danger d-flex align-items-center gap-2" data-profile-alert="error" role="alert">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span><%= error %></span>
                        </div>
                    <% } %>
                </div>

                <form action="/profile" method="POST" data-admin-submit-loading data-submit-loading-text="儲存中..." data-profile-fetch="<%= canViewPrivacyData ? 'privacy' : 'off' %>">
                    
                    <!-- 1. 模組化：個人基本資料區塊 -->
                    <%- include('partials/profile_basic_info', { user: user, canViewProfileDiscord: Boolean(canViewProfileDiscord), canEditProfileNickname: Boolean(canEditProfileNickname) }) %>

                    <!-- 2. 模組化：個人隱私資料區塊 -->
                    <% if (canViewPrivacyData) { %>
                        <%- include('partials/profile_privacy_card', { user: user, canEditPrivacyData: Boolean(canEditPrivacyData) }) %>
                    <% } %>

                    <div class="d-flex justify-content-end mb-4">
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                            <i class="fa-solid fa-floppy-disk me-1"></i>儲存檔案變更
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function calcAgeFromBirthday(dateString) {
        if (!dateString) return;
        const birthDate = new Date(dateString);
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        if (age >= 0 && age <= 120) {
            document.getElementById('inputAge').value = age;
        }
    }

    (function () {
        const form = document.querySelector('form[action="/profile"]');
        if (!form) return;
        if (form.getAttribute('data-profile-fetch') !== 'privacy') return;
        if (typeof window.fetch !== 'function') return;

        const alertHost = document.getElementById('profileFormAlertHost');
        const submitButton = form.querySelector('button[type="submit"], input[type="submit"]');
        const submitLabel = submitButton ? submitButton.innerHTML : '';
        let submitPending = false;

        function renderAlert(type, message) {
            if (!alertHost) return;
            const safeType = type === 'success' ? 'success' : 'danger';
            const icon = safeType === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation';
            const typeLabel = safeType === 'success' ? 'success' : 'error';
            alertHost.innerHTML = '';
            const alert = document.createElement('div');
            alert.className = `alert alert-${safeType} py-2 px-3 small mb-4 border-0 bg-${safeType} bg-opacity-25 text-${safeType} d-flex align-items-center gap-2`;
            alert.setAttribute('data-profile-alert', typeLabel);
            alert.setAttribute('role', 'alert');
            alert.innerHTML = `<i class="fa-solid ${icon}"></i><span></span>`;
            alert.querySelector('span').textContent = message;
            alertHost.appendChild(alert);
        }

        function setSubmitState(isLoading) {
            if (!submitButton) return;
            submitButton.disabled = Boolean(isLoading);
            if (submitButton.tagName === 'BUTTON') {
                submitButton.innerHTML = isLoading
                    ? '<i class="fa-solid fa-spinner fa-spin me-1"></i>儲存中...'
                    : submitLabel;
            } else if (!isLoading) {
                submitButton.value = submitButton.getAttribute('data-original-label') || submitButton.value;
            }
        }

        form.addEventListener('submit', async event => {
            if (submitPending) {
                event.preventDefault();
                return;
            }

            if (!form.checkValidity()) {
                return;
            }

            event.preventDefault();
            submitPending = true;
            setSubmitState(true);

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action || '/profile', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                    },
                    body: new URLSearchParams(formData).toString()
                });

                const contentType = String(response.headers.get('content-type') || '').toLowerCase();
                if (!contentType.includes('application/json')) {
                    throw new Error('伺服器回應格式異常，已阻止將 HTML 或 redirect 誤判為成功。');
                }

                const payload = await response.json();
                if (!response.ok || !payload || payload.success !== true) {
                    const failMessage = payload && payload.message ? String(payload.message) : '更新失敗，請稍後再試。';
                    throw new Error(failMessage);
                }

                renderAlert('success', payload.message || '個人隱私資料已順利保存！');
                const reloadPath = payload.reloadPath || '/profile?saved=1&mask_privacy=1';
                window.location.assign(reloadPath);
            } catch (error) {
                renderAlert('error', (error && error.message) ? error.message : '更新失敗，請稍後再試。');
                submitPending = false;
                setSubmitState(false);
            }
        });
    })();
</script>
</body>
</html>