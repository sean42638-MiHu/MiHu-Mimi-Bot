<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的錢包 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 28px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .glass-panel-card {
            background: rgba(19, 16, 33, 0.85) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 24px;
            padding: 28px;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
        }
    </style>
</head>
<body>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'wallet' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'wallet' }) %>

        <div class="content-body">
            <!-- 上半部：3D 電競信用卡 -->
            <div class="glass-panel-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-wallet" style="color: #a855f7;"></i>
                            <span>我的錢包</span>
                        </div>
                        <p class="text-secondary small mb-0">個人儲值餘額與尊榮 VIP 身分卡 (點擊卡片檢視詳情)</p>
                    </div>
                </div>

                <!-- 💳 1. 模組化 3D 信用卡區 (點擊觸發 Modal) -->
                <div class="d-flex justify-content-center mt-3" style="cursor: pointer;" onclick="openWalletDetailModal()">
                    <%- include('partials/wallet_card', { user: user, vipInfo: vipInfo, mode: 'default' }) %>
                </div>

                <% 
                    const currentBalance = Number(user.balance || 0);
                    const bonusBalance = Number(user.bonus_balance || 0);
                    const accumulatedDeposited = Number(user.manual_deposited !== undefined ? user.manual_deposited : (user.total_deposited || 0));
                    const accumulatedSpent = Number(user.manual_spent !== undefined ? user.manual_spent : (user.total_spent || 0));

                    const userAvatar = user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/0.png`;
                    const userName = user.custom_nickname || user.nickname || user.global_name || user.username || '會員闆闆';

                    const walletObj = {
                        id: user.id,
                        name: userName,
                        avatar: userAvatar,
                        balance: currentBalance,
                        bonusBalance: bonusBalance,
                        accumulatedDeposited: accumulatedDeposited,
                        accumulatedSpent: accumulatedSpent
                    };
                %>
                <!-- 隱藏式 JSON 資料 (保留傳遞給 Modal 檢視) -->
                <script type="application/json" id="walletDataJson">
                    <%- JSON.stringify(walletObj) %>
                </script>
            </div>

            <!-- 👑 2. 獨立模組化：VIP 流光進度條 (內已包含累積消費與累積實充方塊) -->
            <div class="mb-4">
                <%- include('partials/vip_progress_card', { 
                    user: user, 
                    stats: stats, 
                    progressPercent: progressPercent, 
                    vipGapText: vipGapText,
                    vipColor: typeof vipColor !== 'undefined' ? vipColor : (user && user.vip_color)
                }) %>
            </div>

            <!-- 📜 3. 獨立模組化：消費歷史與帳戶流水頁籤區 -->
            <%- include('partials/wallet_history', { orders: orders, transactions: transactions, topups: topups, user: user }) %>
        </div>
    </div>
</div>

<!-- 🚀 獨立錢包詳情 Modal -->
<%- include('modals/wallet_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function setText(id, txt) {
        const el = document.getElementById(id);
        if (el) el.textContent = (txt !== undefined && txt !== null && txt !== '') ? txt : '--';
    }

    function openWalletDetailModal() {
        const scriptEl = document.getElementById('walletDataJson');
        if (!scriptEl) return;

        try {
            const data = JSON.parse(scriptEl.textContent.trim());

            setText('walletModalUserName', data.name);
            setText('walletModalUserId', `ID: ${data.id}`);
            setText('walletModalBalance', `$${Number(data.balance || 0).toLocaleString()}`);
            setText('walletModalRealBalance', `$${Number(data.accumulatedDeposited || 0).toLocaleString()}`);
            setText('walletModalBonusBalance', `$${Number(data.bonusBalance || 0).toLocaleString()}`);

            const avatarEl = document.getElementById('walletModalAvatar');
            if (avatarEl && data.avatar) avatarEl.src = data.avatar;

            const modalEl = document.getElementById('walletDetailModal');
            if (modalEl) {
                const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
                instance.show();
            }
        } catch (e) {
            console.error('❌ 解析錢包 JSON 失敗:', e);
        }
    }
</script>
</body>
</html>