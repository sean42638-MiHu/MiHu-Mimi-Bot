<!-- 🚀 彈窗 4：個人與各類別分潤成數表 Modal (連動工作室全域預設) -->
<div class="modal fade" id="commissionRatesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-percent text-info"></i>
                    <span>個人與各類別分潤成數表</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <!-- 💡 提示區塊：依據是否有特例成數動態切換 -->
                <div id="commissionNoticeBox" class="alert border-0 py-2 px-3 mb-3 small" style="font-size: 0.83rem;">
                    <span id="commissionNoticeText"></span>
                </div>

                <div class="table-responsive rounded-3" style="border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(0, 0, 0, 0.2);">
                    <table class="table table-dark table-hover align-middle mb-0 text-center small">
                        <thead>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <th class="py-2 text-white-50">訂單類別</th>
                                <th class="py-2 text-white-50">工作室設定分潤</th>
                                <th class="py-2 text-white-50">您的實際適用成數</th>
                            </tr>
                        </thead>
                        <tbody id="commissionTableBody">
                            <!-- 由 JavaScript 動態繪製列表 -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 🚨 獨立防呆彈窗：數目不得為負數 Modal -->
<div class="modal fade" id="negativeErrorModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="background: #1f1a30; border: 1px solid rgba(239, 68, 68, 0.5); border-radius: 18px; color: #f3f4f6; box-shadow: 0 10px 30px rgba(239, 68, 68, 0.35);">
            <div class="modal-body text-center py-4">
                <div class="text-danger fs-1 mb-2">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <h6 class="fw-bold text-white mb-2">數目不得為負數</h6>
                <p id="negativeErrorText" class="text-secondary small mb-3">計算後的帳務數目不得小於 0！</p>
                <button type="button" class="btn btn-danger rounded-pill px-4 py-1 small fw-bold" data-bs-dismiss="modal">確定</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.currentMemberBalance = 0;
    window.currentMemberBonus = 0;

    // 🚀 關鍵：Modal 開啟時 100% 清空所有輸入框，絕不預填舊值，避免 0 被誤覆蓋！
    window.openAdjustBalanceModal = function(memberData) {
        if (!memberData) return;

        window.currentMemberBalance = Number(memberData.balance || 0);
        window.currentMemberBonus = Number(memberData.bonus_balance || memberData.bonus || 0);

        const form = document.getElementById('adjustBalanceForm');
        if (form) form.action = `/management/members/update-balance/${memberData.id}`;

        const nameEl = document.getElementById('balanceTargetName');
        if (nameEl) nameEl.textContent = memberData.custom_nickname || memberData.global_name || memberData.username;

        document.getElementById('hiddenCurrentBalance').value = window.currentMemberBalance;
        document.getElementById('hiddenCurrentBonus').value = window.currentMemberBonus;

        // 🚀 強制清空所有輸入框，不讓舊數字干擾本次充值
        document.getElementById('modalAddAmount').value = '';
        document.getElementById('modalBonusBalance').value = '';
        document.getElementById('modalBalance').value = ''; 
        document.getElementById('modalSpent').value = '';
        document.getElementById('modalDeposited').value = ''; // 100% 空白不預填！

        const modalEl = document.getElementById('adjustBalanceModal');
        if (modalEl) {
            const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
        }
    };

    // 🚀 開啟「個人與各類別分潤成數表」彈窗 (完美支援工作室預設與個人特例)
    // 🚀 修正：個人與各類別分潤成數表開啟邏輯
window.openCommissionRatesModal = function(talentData, studioRates) {
    // 預設工作室 5 大類別成數 (若後端沒傳則以此為備用預設)
    const defaultStudioRates = {
        '陪玩單': 0.80,
        '禮物單': 0.85,
        '有獎單': 0.90,
        '冠名單': 0.85,
        '其他單': 0.80,
        '獎金單': 1.00
    };

    const rates = studioRates || defaultStudioRates;
    const formatShareRate = (value, fallback) => {
        if (value === null || value === undefined || value === '') value = fallback;
        const isPercent = typeof value === 'string' && value.trim().endsWith('%');
        let rate = isPercent ? Number(value.trim().slice(0, -1)) / 100 : Number(value);
        if (!isPercent && rate > 1 && rate <= 100) rate /= 100;
        return Number.isFinite(rate) && rate >= 0 && rate <= 1 ? `${Math.round(rate * 100)}%` : `${Math.round(fallback * 100)}%`;
    };
    
    // 💡 關鍵修正：必須嚴格檢查 commission_rate 是否有填寫，若為 null / undefined / 空白 / 0 則視為沒有特例！
    let personalRate = null;
    if (talentData && talentData.commission_rate !== null && talentData.commission_rate !== undefined && talentData.commission_rate !== '' && String(talentData.commission_rate).trim().toLowerCase() !== 'null') {
        let parsed = Number(talentData.commission_rate);
        if (Number.isFinite(parsed) && parsed > 1 && parsed <= 100) parsed /= 100;
        if (Number.isFinite(parsed) && parsed > 0 && parsed <= 1) personalRate = parsed;
    }

    const noticeBox = document.getElementById('commissionNoticeBox');
    const noticeText = document.getElementById('commissionNoticeText');

    if (personalRate !== null) {
        // 1. 只有真的有填寫特例數字時，才顯示特例提示
        const percentStr = Math.round(personalRate * 100) + '%';
        if (noticeBox) noticeBox.className = 'alert border-0 py-2 px-3 mb-3 small bg-primary bg-opacity-10 border-primary border-opacity-25 text-primary';
        if (noticeText) noticeText.innerHTML = `☀️ <strong>特例提示</strong>：您擁有個人專屬特例抽傭成數 <strong>${percentStr}</strong>，優先適用於所有類別訂單！`;
    } else {
        // 2. 沒填寫特例（工作室預設）時，顯示連動成功提示
        if (noticeBox) noticeBox.className = 'alert border-0 py-2 px-3 mb-3 small bg-success bg-opacity-10 border-success border-opacity-25 text-success';
        if (noticeText) noticeText.innerHTML = `✨ <strong>工作室連動預設</strong>：您目前採用工作室全域類別分潤設定！`;
    }

    const categories = [
        { name: '陪玩單', studio: formatShareRate(rates['陪玩單'], defaultStudioRates['陪玩單']) },
        { name: '禮物單', studio: formatShareRate(rates['禮物單'], defaultStudioRates['禮物單']) },
        { name: '有獎單', studio: formatShareRate(rates['有獎單'] ?? rates['有獎'], defaultStudioRates['有獎單']) },
        { name: '冠名單', studio: formatShareRate(rates['冠名單'] ?? rates['冠名'], defaultStudioRates['冠名單']) },
        { name: '其他單', studio: formatShareRate(rates['其他單'] ?? rates['其他'], defaultStudioRates['其他單']) },
        { name: '獎金單', studio: formatShareRate(rates['獎金單'] ?? rates['獎金'], defaultStudioRates['獎金單']) }
    ];

    const tbody = document.getElementById('commissionTableBody');
    if (tbody) {
        tbody.innerHTML = categories.map(cat => {
            // 💡 若無個人特例，實際適用成數就完全等於工作室設定！
            const applied = (personalRate !== null) ? Math.round(personalRate * 100) + '%' : cat.studio;
            return `
                <tr>
                    <td class="fw-bold text-white">${cat.name}</td>
                    <td class="text-secondary">${cat.studio}</td>
                    <td class="fw-bold text-warning">${applied}</td>
                </tr>
            `;
        }).join('');
    }

    const modalEl = document.getElementById('commissionRatesModal');
    if (modalEl) {
        const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
        instance.show();
    }
};
    // 🚀 前端提交攔截與負數獨立彈窗顯示
    document.addEventListener('DOMContentLoaded', () => {
        const adjustForm = document.getElementById('adjustBalanceForm');
        if (adjustForm) {
            adjustForm.addEventListener('submit', function (e) {
                const currBalance = Number(window.currentMemberBalance || 0);
                const currBonus = Number(window.currentMemberBonus || 0);

                const addAmountVal = document.getElementById('modalAddAmount').value.trim();
                const bonusChangeVal = document.getElementById('modalBonusBalance').value.trim();
                const directBalanceVal = document.getElementById('modalBalance').value.trim();
                const totalSpentVal = document.getElementById('modalSpent').value.trim();
                const totalDepositedVal = document.getElementById('modalDeposited').value.trim();

                let finalBalance = currBalance;
                let finalBonus = currBonus;

                if (directBalanceVal !== '') {
                    finalBalance = Number(directBalanceVal);
                } else if (addAmountVal !== '') {
                    finalBalance = currBalance + Number(addAmountVal);
                }

                if (bonusChangeVal !== '') {
                    finalBonus = currBonus + Number(bonusChangeVal);
                }

                let errorMsg = '';
                if (finalBalance < 0) {
                    errorMsg = `當前實充為 $${currBalance}，扣除後最終餘額為 $${finalBalance}，數目不得為負數！`;
                } else if (finalBonus < 0) {
                    errorMsg = `當前贈送金為 $${currBonus}，扣除後最終贈送金為 $${finalBonus}，數目不得為負數！`;
                } else if (totalSpentVal !== '' && Number(totalSpentVal) < 0) {
                    errorMsg = '「累積消費」不得設定為負數！';
                } else if (totalDepositedVal !== '' && Number(totalDepositedVal) < 0) {
                    errorMsg = '「累積實充」不得設定為負數！';
                }

                if (errorMsg) {
                    e.preventDefault();
                    document.getElementById('negativeErrorText').textContent = errorMsg;
                    const errModalEl = document.getElementById('negativeErrorModal');
                    if (errModalEl) {
                        const errInstance = bootstrap.Modal.getOrCreateInstance(errModalEl);
                        errInstance.show();
                    }
                }
            });
        }
    });
</script>