            ]
        },
        {
            id: 'visibility_manage',
            title: '管理',
            iconClass: 'fa-solid fa-briefcase',
            description: '管理區主選單與子模組可見度。',
            items: [
                { key: 'view_management', label: '管理目錄' },
                { key: 'action_view_analytics', label: '公司營運統計', parentKey: 'view_management' },
                { key: 'view_manage_members', label: '會員名單', parentKey: 'view_management' },
                { key: 'view_member_ledger', label: '會員資金明細', parentKey: 'view_manage_members' },
                { key: 'view_manage_staff', label: '員工列表', parentKey: 'view_management' },
                { key: 'view_staff_payroll', label: '薪轉管理', parentKey: 'view_manage_staff' },
                { key: 'view_payout', label: '提款審核', parentKey: 'view_staff_payroll' },
                { key: 'view_manage_orders', label: '訂單管理', parentKey: 'view_management' }
            ]
        },
        {
            id: 'visibility_system',
            title: '系統',
            iconClass: 'fa-solid fa-screwdriver-wrench',
            description: '保留三個系統父選單與其子項目可見度。',
            items: [
                { key: 'view_system', label: '系統目錄' },
                { key: 'view_cat_system_settings', label: '系統設定', parentKey: 'view_system' },
                { key: 'view_system_settings', label: '系統基礎設定', parentKey: 'view_cat_system_settings' },
                { key: 'view_cat_system_manage', label: '系統管理', parentKey: 'view_system' },
                { key: 'view_discord_status', label: '機器人設定', parentKey: 'view_cat_system_manage' },
                { key: 'view_commission', label: '抽傭設定', parentKey: 'view_cat_system_manage' },
                { key: 'view_vip', label: 'VIP設定', parentKey: 'view_cat_system_manage' },
                { key: 'view_roles', label: '身分管理', parentKey: 'view_cat_system_manage' },
                { key: 'view_cat_system_info', label: '系統資訊', parentKey: 'view_system' },
                { key: 'action_view_audit_logs', label: '操作紀錄', parentKey: 'view_cat_system_info' },
                { key: 'view_system_health', label: '系統狀態', parentKey: 'view_cat_system_info' }
            ]
        }
    ];

    const actionCards = [
        {
            id: 'action_personal',
            title: '個人頁面操作',
            iconClass: 'fa-solid fa-id-card',
            items: [
                { key: 'action_profile_nickname', label: '變更暱稱' },
                { key: 'action_edit_privacy_data', label: '編輯個人隱私資料' }
            ]
        },
        {
            id: 'action_member',
            title: '會員頁面操作',
            iconClass: 'fa-solid fa-users',
            items: [
                { key: 'action_member_balance', label: '會員帳務調整' },
                { key: 'action_member_role_vip', label: '手動 VIP 調整與全後台身分調整' },
                { key: 'action_member_manage', label: '會員資料管理' },
                { key: 'action_member_management', label: '會員管理完整授權（舊版相容）' }
            ]
        },
        {
            id: 'action_staff',
            title: '員工與薪資頁面操作',
            iconClass: 'fa-solid fa-user-gear',
            items: [
                { key: 'action_staff_manage', label: '員工管理' },
                { key: 'action_staff_commission', label: '設定員工職務與抽傭' },
                { key: 'action_staff_payroll', label: '審核薪轉撥付' },
                { key: 'action_staff_payroll_details', label: '查看員工個資與薪資（舊版相容）' },
                { key: 'action_staff_sensitive', label: '解鎖查看敏感資料（二步驟驗證）' },
                { key: 'action_payout_mark_paid', label: '標記提款已匯款' },
                { key: 'action_payout_reject', label: '駁回提款申請' }
            ]
        },
        {
            id: 'action_order',
            title: '訂單管理頁面操作',
            iconClass: 'fa-solid fa-list-check',
            items: [
                { key: 'action_order_create', label: '建立訂單' },
                { key: 'action_order_manage', label: '訂單維護' },
                { key: 'action_order_edit_reassign', label: '編輯訂單' },
                { key: 'action_order_price', label: '調整訂單價格' },
                { key: 'action_order_refund', label: '退款訂單' },
                { key: 'action_order_batch_delete', label: '刪除訂單（批量）' },
                { key: 'action_order_refund_completed', label: '核准完成訂單退款' },
                { key: 'action_order_management', label: '訂單管理完整授權（舊版相容）' }
            ]
        },
        {
            id: 'action_system',
            title: '系統與身分管理操作',
            iconClass: 'fa-solid fa-shield-halved',
            items: [
                { key: 'action_role_manage', label: '身分權限修改' },
                { key: 'action_commission_config', label: '抽傭比例變更' }
            ]
        }
    ];

    const visibilityKeySet = new Set(visibilityCards.flatMap(card => card.items.map(item => item.key)));
    const actionKeySet = new Set(actionCards.flatMap(card => card.items.map(item => item.key)));
    const hierarchyParentKeys = new Set(
        [...visibilityCards, ...actionCards]
            .flatMap(card => card.items.map(item => item.parentKey).filter(Boolean))
    );
    const otherActionItems = metadataValues
        .filter(item => !visibilityKeySet.has(item.key) && !actionKeySet.has(item.key))
        .map(item => ({ key: item.key, label: item.label }));

    function resolvePermissionEntry(item) {
        const permission = (permissionMetadata || {})[item.key];
        if (!permission) return null;
        return {
            key: permission.key,
            label: item.label || permission.label,
            description: permission.description,
            implemented: permission.implemented !== false,
            parentKey: item.parentKey || '',
            isParent: hierarchyParentKeys.has(permission.key)
        };
    }
%>
<div class="modal fade admin-modal" id="editRolePermsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl admin-modal-dialog admin-modal-dialog--lg">
        <div class="modal-content modal-content-glass admin-modal-content role-modal-content">
            <form class="admin-form" action="/system/roles/update-permissions" method="POST" data-admin-submit-loading data-submit-loading-text="儲存中...">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-white">編輯身分權限：<span id="targetRoleName" class="text-info"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body admin-modal-body p-4">
                    <input type="hidden" id="targetRoleKey" name="role">
                    <p class="small text-secondary">各項權限獨立授予；衍生開關會標示來源，儲存時保留原始選取。</p>
                    <ul class="nav nav-tabs role-permission-tabs" id="rolePermissionTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="rolePermissionTabVisibilityTrigger" data-role-perm-default-tab data-bs-toggle="tab" data-bs-target="#rolePermissionVisibilityPane" type="button" role="tab" aria-controls="rolePermissionVisibilityPane" aria-selected="true">🌐 項目能見度 (頁面/選單)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="rolePermissionTabActionTrigger" data-bs-toggle="tab" data-bs-target="#rolePermissionActionPane" type="button" role="tab" aria-controls="rolePermissionActionPane" aria-selected="false">⚡ 功能操作權限 (按鈕/API)</button>
                        </li>
                    </ul>

                    <div class="tab-content role-permission-tab-content" id="rolePermissionTabContent">
                        <section class="tab-pane fade show active" id="rolePermissionVisibilityPane" role="tabpanel" aria-labelledby="rolePermissionTabVisibilityTrigger" tabindex="0">
                            <% visibilityCards.forEach(card => { %>
                                <section class="permission-group-card" aria-label="<%= card.title %>">
                                    <h6 class="permission-group-title">
                                        <i class="<%= card.iconClass %>" aria-hidden="true"></i>
                                        <span><%= card.title %></span>
                                    </h6>
                                    <p class="permission-group-desc"><%= card.description %></p>
                                    <div class="admin-permission-grid role-permission-grid">
                                        <% card.items.forEach(item => {
                                            const entry = resolvePermissionEntry(item);
                                            if (!entry) return;
                                            const disabled = !entry.implemented || !(delegatablePermissions || []).includes(entry.key);
                                        %>
                                            <label class="admin-permission-item <%= entry.parentKey ? 'permission-child-item' : '' %>">
                                                <input
                                                    class="form-check-input form-switch-input perm-checkbox"
                                                    type="checkbox"
                                                    role="switch"
                                                    data-inactive="<%= !entry.implemented %>"
                                                    data-permission-label="<%= entry.label %>"
                                                    data-permission-parent="<%= entry.isParent ? 'true' : 'false' %>"
                                                    data-permission-child="<%= entry.parentKey ? 'true' : 'false' %>"
                                                    data-permission-parent-key="<%= entry.parentKey %>"
                                                    name="permissions"
                                                    value="<%= entry.key %>"
                                                    id="role_permission_<%= entry.key.replace(/[^a-zA-Z0-9_:-]/g, '_') %>"
                                                    <%= disabled ? 'disabled' : '' %>>
                                                <span class="admin-permission-name">
                                                    <%= entry.label %>
                                                    <% if (!entry.implemented) { %><small class="d-block text-secondary">尚未實作獨立權限檢查（唯讀保留）</small><% } %>
                                                </span>
                                            </label>
                                        <% }) %>
                                    </div>
                                </section>
                            <% }) %>
                        </section>

                        <section class="tab-pane fade" id="rolePermissionActionPane" role="tabpanel" aria-labelledby="rolePermissionTabActionTrigger" tabindex="0">
                            <% actionCards.forEach(card => { %>
                                <section class="permission-group-card" aria-label="<%= card.title %>">
                                    <h6 class="permission-group-title">
                                        <i class="<%= card.iconClass %>" aria-hidden="true"></i>
                                        <span><%= card.title %></span>
                                    </h6>
                                    <div class="admin-permission-grid role-permission-grid">
                                        <% card.items.forEach(item => {
                                            const entry = resolvePermissionEntry(item);
                                            if (!entry) return;
                                            const disabled = !entry.implemented || !(delegatablePermissions || []).includes(entry.key);
                                        %>
                                            <label class="admin-permission-item <%= entry.parentKey ? 'permission-child-item' : '' %>">
                                                <input
                                                    class="form-check-input form-switch-input perm-checkbox"
                                                    type="checkbox"
                                                    role="switch"
                                                    data-inactive="<%= !entry.implemented %>"
                                                    data-permission-label="<%= entry.label %>"
                                                    data-permission-parent="<%= entry.isParent ? 'true' : 'false' %>"
                                                    data-permission-child="<%= entry.parentKey ? 'true' : 'false' %>"
                                                    data-permission-parent-key="<%= entry.parentKey %>"
                                                    name="permissions"
                                                    value="<%= entry.key %>"
                                                    id="role_permission_<%= entry.key.replace(/[^a-zA-Z0-9_:-]/g, '_') %>"
                                                    <%= disabled ? 'disabled' : '' %>>
                                                <span class="admin-permission-name">
                                                    <%= entry.label %>
                                                    <% if (!entry.implemented) { %><small class="d-block text-secondary">尚未實作獨立權限檢查（唯讀保留）</small><% } %>
                                                </span>
                                            </label>
                                        <% }) %>
                                    </div>
                                </section>
                            <% }) %>

                            <% if (otherActionItems.length > 0 || canGrantWildcard) { %>
                                <section class="permission-group-card" aria-label="其他高權限與相容權限">
                                    <h6 class="permission-group-title">
                                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                        <span>其他／高權限</span>
                                    </h6>
                                    <div class="admin-permission-grid role-permission-grid">
                                        <% otherActionItems.forEach(item => {
                                            const entry = resolvePermissionEntry(item);
                                            if (!entry) return;
                                            const disabled = !entry.implemented || !(delegatablePermissions || []).includes(entry.key);
                                        %>
                                            <label class="admin-permission-item">
                                                <input
                                                    class="form-check-input form-switch-input perm-checkbox"
                                                    type="checkbox"
                                                    role="switch"
                                                    data-inactive="<%= !entry.implemented %>"
                                                    data-permission-label="<%= entry.label %>"
                                                    data-permission-parent="false"
                                                    data-permission-child="false"
                                                    data-permission-parent-key=""
                                                    name="permissions"
                                                    value="<%= entry.key %>"
                                                    id="role_permission_<%= entry.key.replace(/[^a-zA-Z0-9_:-]/g, '_') %>"
                                                    <%= disabled ? 'disabled' : '' %>>
                                                <span class="admin-permission-name">
                                                    <%= entry.label %>
                                                    <% if (!entry.implemented) { %><small class="d-block text-secondary">尚未實作獨立權限檢查（唯讀保留）</small><% } %>
                                                </span>
                                            </label>
                                        <% }) %>
                                        <% if (canGrantWildcard) { %>
                                            <label class="admin-permission-item">
                                                <input class="form-check-input form-switch-input perm-checkbox" type="checkbox" role="switch" data-permission-label="最高權限萬用授權" data-permission-parent="false" data-permission-child="false" data-permission-parent-key="" name="permissions" value="*" id="permission_wildcard">
                                                <span class="admin-permission-name">最高權限萬用授權</span>
                                                <span class="admin-badge admin-badge-danger">*</span>
                                            </label>
                                        <% } %>
                                    </div>
                                </section>
                            <% } %>
                        </section>
                    </div>

                    <section id="roleUnknownPermissions" class="admin-form-section mt-3" aria-label="未識別權限資料" hidden>
                        <h6 class="admin-form-section-title">未識別資料（唯讀保留，不授權）</h6>
                        <div id="roleUnknownPermissionList" class="small text-secondary"></div>
                    </section>
                </div>
                <div class="modal-footer admin-modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-sm btn-warning rounded-pill px-4 fw-bold text-dark">儲存權限設定</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>
