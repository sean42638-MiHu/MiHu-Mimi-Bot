                { key: 'view_dashboard_wallet', label: '首頁錢包卡片', parentKey: 'view_dashboard' },
                { key: 'view_dashboard_info', label: '首頁公告與資訊', parentKey: 'view_dashboard' },
                { key: 'view_dashboard_banner', label: '首頁 Banner', parentKey: 'view_dashboard' }
            ]
        },
        {
            id: 'visibility_personal',
