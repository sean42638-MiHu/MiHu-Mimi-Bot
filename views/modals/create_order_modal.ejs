<%
    const canCreateOrder = typeof canCreateManualOrder === 'boolean'
        ? canCreateManualOrder
        : (typeof hasPerm === 'function' && hasPerm('action_order_create'));
    const canAdjustManualRate = typeof canAdjustOrderPrice === 'boolean'
        ? canAdjustOrderPrice
        : (typeof hasPerm === 'function' && hasPerm('action_order_price'));
    const manualShareDefaults = defaultTalentShareRates || {
        '陪玩單': 0.80,
        '禮物單': 0.85,
        '有獎單': 0.90,
        '冠名單': 0.85,
        '其他單': 0.80,
        '獎金單': 1.00
    };
%>

<% if (canCreateOrder) { %>
<style>
    #manualCreateOrderModal .manual-create-content {
        background: linear-gradient(165deg, rgba(14, 11, 28, 0.98), rgba(29, 16, 48, 0.95));
        border: 1px solid rgba(232, 121, 249, 0.35);
        box-shadow: 0 28px 56px rgba(7, 5, 18, 0.78);
        color: #f8fafc;
    }

    #manualCreateOrderModal .manual-create-body {
        max-height: 74vh;
        overflow-y: auto;
        padding-right: 12px;
    }

    #manualCreateOrderModal .manual-create-body::-webkit-scrollbar {
        width: 4px;
    }

    #manualCreateOrderModal .manual-create-body::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.72);
    }

    #manualCreateOrderModal .manual-create-body::-webkit-scrollbar-thumb {
        background: rgba(217, 70, 239, 0.72);
        border-radius: 999px;
    }

    #manualCreateOrderModal .manual-form-label {
        color: #d8d4e8;
        font-size: 0.82rem;
        margin-bottom: 6px;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    #manualCreateOrderModal .manual-form-control,
    #manualCreateOrderModal .manual-form-select {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #f3f4f6;
        border-radius: 12px;
        min-height: 40px;
    }

    #manualCreateOrderModal .manual-form-control::placeholder {
        color: #9ca3af;
        opacity: 1;
    }

    #manualCreateOrderModal .manual-form-control:read-only,
    #manualCreateOrderModal .manual-form-control:disabled,
    #manualCreateOrderModal .manual-form-select:disabled {
        color: #d1d5db;
        background: rgba(148, 163, 184, 0.1);
        border-color: rgba(148, 163, 184, 0.32);
        opacity: 1;
        cursor: not-allowed;
    }

    #manualCreateOrderModal .manual-form-select {
        color: #f3f4f6;
        color-scheme: dark;
    }

    #manualCreateOrderModal .manual-form-control:focus,
    #manualCreateOrderModal .manual-form-select:focus {
        border-color: rgba(244, 114, 182, 0.8);
        box-shadow: 0 0 0 0.2rem rgba(244, 114, 182, 0.22);
    }

    #manualCreateOrderModal .manual-form-select option {
        background: #0f172a;
        color: #f3f4f6;
    }

    #manualCreateOrderModal .manual-search-wrap {
        position: relative;
    }

    #manualCreateOrderModal .manual-search-results {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 6px);
        z-index: 20;
        background: rgba(9, 12, 29, 0.96);
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 12px;
        overflow: hidden;
        display: none;
        backdrop-filter: blur(6px);
    }

    #manualCreateOrderModal .manual-search-item {
        width: 100%;
        border: 0;
        padding: 10px 12px;
        text-align: left;
        color: #f3f4f6;
        background: transparent;
        font-size: 0.84rem;
    }

    #manualCreateOrderModal .manual-search-empty,
    #manualCreateOrderModal .manual-help-text {
        color: #a8a3bb;
    }

    #manualCreateOrderModal .manual-create-warning {
        color: #fff1f2;
        background: rgba(120, 53, 15, 0.44);
        border: 1px solid rgba(251, 191, 36, 0.42);
    }

    #manualCreateOrderModal .manual-create-error {
        color: #fee2e2;
        background: rgba(127, 29, 29, 0.45);
        border: 1px solid rgba(248, 113, 113, 0.55);
    }

    #manualCreateOrderModal .manual-wallet-card {
        margin-top: 10px;
        padding: 10px 12px;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 12px;
        background: rgba(8, 47, 73, 0.3);
        color: #f3f4f6;
    }

    #manualCreateOrderModal .manual-wallet-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    #manualCreateOrderModal .manual-wallet-value {
        display: block;
        color: #f3f4f6;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    #manualCreateOrderModal .manual-wallet-insufficient {
        color: #fecaca;
        font-weight: 700;
    }

    #manualCreateOrderModal .manual-submit-summary {
        color: #f3f4f6;
        max-width: 340px;
        overflow-wrap: anywhere;
    }

    #manualCreateOrderModal .manual-search-item:hover,
    #manualCreateOrderModal .manual-search-item:focus-visible {
        background: rgba(236, 72, 153, 0.2);
        outline: none;
    }

    #manualCreateOrderModal .manual-selected-chip {
        margin-top: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid rgba(96, 165, 250, 0.45);
        background: rgba(59, 130, 246, 0.18);
        color: #bfdbfe;
        font-size: 0.77rem;
    }

    #manualCreateOrderModal .manual-preview-card {
        border-radius: 14px;
        border: 1px solid rgba(244, 114, 182, 0.35);
        background: linear-gradient(145deg, rgba(30, 20, 44, 0.88), rgba(17, 27, 52, 0.82));
        padding: 14px;
    }

    #manualCreateOrderModal .manual-preview-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    #manualCreateOrderModal .manual-preview-label {
        font-size: 0.72rem;
        color: #a8a3bb;
        display: block;
        margin-bottom: 2px;
    }

    #manualCreateOrderModal .manual-preview-value {
        font-size: 1rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-weight: 800;
        color: #f8fafc;
    }

    #manualCreateOrderModal .manual-override-disabled {
        border-radius: 10px;
        background: rgba(148, 163, 184, 0.06);
    }

    @media (max-width: 768px) {
        #manualCreateOrderModal .modal-dialog {
            margin: 0;
            max-width: 100%;
            height: 100%;
        }

        #manualCreateOrderModal .modal-content {
            min-height: 100vh;
            border-radius: 0;
        }

        #manualCreateOrderModal .manual-create-body {
            max-height: none;
            padding-bottom: 16px;
        }

        #manualCreateOrderModal .manual-preview-grid {
            grid-template-columns: 1fr;
        }

        #manualCreateOrderModal .manual-wallet-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #manualCreateOrderModal *,
        #manualCreateOrderModal *::before,
        #manualCreateOrderModal *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<div class="modal fade" id="manualCreateOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 880px;">
        <div class="modal-content manual-create-content">
            <form id="manualCreateOrderForm" method="POST" action="/management/orders/create">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="request_key" id="manualOrderRequestKey">
                <input type="hidden" name="boss_id" id="manualOrderBossId">
                <input type="hidden" name="talent_id" id="manualOrderTalentId">

                <div class="modal-header border-0 pb-2">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-file-circle-plus" style="color:#f472b6;"></i>
                        手動建立訂單
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manual-create-body">
                    <div class="alert manual-create-error py-2 px-3 small" id="manualCreateOrderError" style="display:none;" role="alert"></div>
                    <div class="alert manual-create-warning py-2 px-3 small mb-3">
                        建立訂單將立即扣除所選會員錢包餘額；進行中訂單於完成後才結算收益與累積消費。
                    </div>

                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="manual-form-label">會員 (Discord ID / 暱稱)</label>
                            <div class="manual-search-wrap">
                                <input type="search" class="form-control manual-form-control" id="manualMemberSearch" autocomplete="off" placeholder="輸入至少 2 個字，例如 member-a">
                                <div class="manual-search-results" id="manualMemberResults"></div>
                            </div>
                            <div id="manualMemberSelected" style="display:none;"></div>
                            <div id="manualMemberWalletPreview" class="manual-wallet-card" style="display:none;" aria-live="polite">
                                <div class="manual-wallet-grid">
                                    <div><span class="manual-preview-label">可付款主餘額</span><span class="manual-wallet-value" id="manualWalletBalance">$0</span></div>
                                    <div><span class="manual-preview-label">贈送金（本次不合併扣款）</span><span class="manual-wallet-value" id="manualWalletBonus">$0</span></div>
                                    <div><span class="manual-preview-label">扣款後主餘額</span><span class="manual-wallet-value" id="manualWalletAfter">$0</span></div>
                                </div>
                                <div class="small mt-2" id="manualWalletPaymentPreview"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="manual-form-label">接單人 (接單資格)</label>
                            <div class="manual-search-wrap">
                                <input type="search" class="form-control manual-form-control" id="manualTalentSearch" autocomplete="off" placeholder="搜尋陪陪 / 接單員工">
                                <div class="manual-search-results" id="manualTalentResults"></div>
                            </div>
                            <div id="manualTalentSelected" style="display:none;"></div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="manual-form-label">訂單類別</label>
                            <select class="form-select manual-form-select" id="manualOrderCategory" name="category" required>
                                <option value="陪玩單">陪玩單</option>
                                <option value="禮物單">禮物單</option>
                                <option value="有獎單">有獎單</option>
                                <option value="冠名單">冠名單</option>
                                <option value="其他單">其他單</option>
                                <option value="獎金單">獎金單</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="manual-form-label">服務項目</label>
                            <input type="text" class="form-control manual-form-control" id="manualOrderGame" name="game" maxlength="120" required>
                        </div>
                        <div class="col-md-4">
                            <label class="manual-form-label">內容規格</label>
                            <input type="text" class="form-control manual-form-control" id="manualOrderTier" name="content_tier" maxlength="120" placeholder="可留空">
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-3 col-6">
                            <label class="manual-form-label">時長 / 數量</label>
                            <input type="number" class="form-control manual-form-control" id="manualOrderDuration" name="duration" min="0.01" max="10000" step="0.01" value="1" required>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="manual-form-label">單位</label>
                            <select class="form-select manual-form-select" id="manualOrderUnit" name="unit">
                                <option value="小時">小時</option>
                                <option value="局">局</option>
                                <option value="次">次</option>
                                <option value="首">首</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="manual-form-label">訂單金額 (NTD)</label>
                            <input type="number" class="form-control manual-form-control" id="manualOrderAmount" name="final_amount" min="0" max="1000000000" step="0.01" value="0" required>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="manual-form-label">建立狀態</label>
                            <select class="form-select manual-form-select" id="manualOrderStatus" name="manual_status">
                                <option value="completed" selected>completed (已完成)</option>
                                <option value="in_progress">in_progress (進行中)</option>
                            </select>
                        </div>
                    </div>

                    <div class="rounded-4 p-3 mt-3" style="border:1px solid rgba(125,211,252,0.35); background:rgba(15,23,42,0.45);">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <label class="manual-form-label mb-0">覆寫分潤比例</label>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="manualEnableRatioOverride" name="enable_ratio_override" value="1" <%= canAdjustManualRate ? '' : 'disabled' %>>
                                <label class="form-check-label small text-secondary" for="manualEnableRatioOverride">啟用覆寫</label>
                            </div>
                        </div>
                        <div class="row g-2 mt-1 <%= canAdjustManualRate ? '' : 'manual-override-disabled' %>" id="manualRatioOverrideGroup">
                            <div class="col-md-6">
                                <select class="form-select manual-form-select" name="ratio_mode" id="manualRatioMode" <%= canAdjustManualRate ? 'disabled' : 'disabled' %>>
                                    <option value="talent_share">輸入陪陪分潤 %</option>
                                    <option value="studio_cut">輸入工作室抽成 %</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <input type="number" class="form-control manual-form-control" name="ratio_value" id="manualRatioValue" min="0" max="100" step="0.01" placeholder="例如 82.5" <%= canAdjustManualRate ? 'disabled' : 'disabled' %>>
                            </div>
                        </div>
                        <% if (!canAdjustManualRate) { %>
                            <small class="manual-help-text d-block mt-2">此帳號沒有 orders.price_adjust 權限，僅能使用既有分潤規則。</small>
                        <% } else { %>
                            <small class="manual-help-text d-block mt-2">覆寫會影響訂單分潤快照，未啟用時採用接單者個人成數或類別預設。</small>
                        <% } %>
                    </div>

                    <div class="manual-preview-card mt-3" aria-live="polite">
                        <div class="small text-info fw-semibold mb-2">即時收益預覽 (僅作提示，實際以後端交易計算為準)</div>
                        <div class="manual-preview-grid">
                            <div>
                                <span class="manual-preview-label">套用陪陪分潤</span>
                                <span class="manual-preview-value" id="manualPreviewTalentRate">80.00%</span>
                            </div>
                            <div>
                                <span class="manual-preview-label">陪陪預估收益</span>
                                <span class="manual-preview-value" id="manualPreviewTalentNet">$0</span>
                            </div>
                            <div>
                                <span class="manual-preview-label">工作室預估抽成</span>
                                <span class="manual-preview-value" id="manualPreviewStudioCut">$0</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="manual-form-label">陪陪留言 (選填)</label>
                            <textarea class="form-control manual-form-control" id="manualTalentMessage" name="talent_message" rows="2" maxlength="500" placeholder="完成單可同步寫入留言"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="manual-form-label">客服備註 (選填)</label>
                            <textarea class="form-control manual-form-control" id="manualOrderNote" name="note" rows="2" maxlength="500" placeholder="內部備註，最多 500 字"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">取消</button>
                    <div class="d-flex flex-column align-items-end gap-1">
                        <small class="manual-submit-summary" id="manualCreateOrderSubmitSummary" aria-live="polite">請先選擇會員與接單人</small>
                        <small class="manual-help-text" id="manualCreateOrderValidation" aria-live="polite"></small>
                        <button type="submit" class="btn btn-primary" id="manualCreateOrderSubmitBtn" disabled style="background:linear-gradient(135deg,#ec4899,#db2777); border:1px solid rgba(249,168,212,0.45);">建立訂單</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function initializeManualCreateOrderModal() {
        if (window.__mihuManualCreateOrderInitialized) return;
        window.__mihuManualCreateOrderInitialized = true;

        const modalEl = document.getElementById('manualCreateOrderModal');
        const form = document.getElementById('manualCreateOrderForm');
        if (!modalEl || !form) return;

        const defaults = <%- JSON.stringify(manualShareDefaults) %>;
        const canAdjustRate = <%= canAdjustManualRate ? 'true' : 'false' %>;

        const memberInput = document.getElementById('manualMemberSearch');
        const memberResults = document.getElementById('manualMemberResults');
        const memberHidden = document.getElementById('manualOrderBossId');
        const memberSelected = document.getElementById('manualMemberSelected');
        const memberWalletPreview = document.getElementById('manualMemberWalletPreview');
        const walletBalance = document.getElementById('manualWalletBalance');
        const walletBonus = document.getElementById('manualWalletBonus');
        const walletAfter = document.getElementById('manualWalletAfter');
        const walletPaymentPreview = document.getElementById('manualWalletPaymentPreview');

        const talentInput = document.getElementById('manualTalentSearch');
        const talentResults = document.getElementById('manualTalentResults');
        const talentHidden = document.getElementById('manualOrderTalentId');
        const talentSelected = document.getElementById('manualTalentSelected');

        const requestKeyInput = document.getElementById('manualOrderRequestKey');
        const amountInput = document.getElementById('manualOrderAmount');
        const categoryInput = document.getElementById('manualOrderCategory');
        const ratioToggle = document.getElementById('manualEnableRatioOverride');
        const ratioModeInput = document.getElementById('manualRatioMode');
        const ratioValueInput = document.getElementById('manualRatioValue');
        const previewRate = document.getElementById('manualPreviewTalentRate');
        const previewTalentNet = document.getElementById('manualPreviewTalentNet');
        const previewStudioCut = document.getElementById('manualPreviewStudioCut');
        const errorBox = document.getElementById('manualCreateOrderError');
        const submitBtn = document.getElementById('manualCreateOrderSubmitBtn');
        const submitSummary = document.getElementById('manualCreateOrderSubmitSummary');
        const validationText = document.getElementById('manualCreateOrderValidation');
        const durationInput = document.getElementById('manualOrderDuration');
        const gameInput = document.getElementById('manualOrderGame');

        let selectedTalentRate = null;
        let selectedMemberSnapshot = null;
        let memberSearchSequence = 0;
        let memberWalletSequence = 0;
        let takerSearchSequence = 0;
        let submitting = false;

        function createRequestKey() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                return `manual_${window.crypto.randomUUID().replace(/-/g, '')}`;
            }
            const randomPart = Math.random().toString(36).slice(2, 14);
            const timePart = Date.now().toString(36);
            return `manual_${timePart}_${randomPart}`;
        }

        function setError(message) {
            if (!errorBox) return;
            const text = String(message || '').trim();
            if (!text) {
                errorBox.style.display = 'none';
                errorBox.textContent = '';
                return;
            }
            errorBox.textContent = text;
            errorBox.style.display = 'block';
        }

        function formatCurrency(value) {
            return `$${Number(value || 0).toLocaleString('zh-TW', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            })}`;
        }

        function parseValidAmount() {
            const raw = String(amountInput && amountInput.value || '').trim();
            if (!/^(0|[1-9]\d*)(\.\d{1,2})?$/.test(raw)) return null;
            const value = Number(raw);
            return Number.isFinite(value) && value >= 0 && value <= 1000000000 ? Number(value.toFixed(2)) : null;
        }

        function updateWalletPreview() {
            const amount = parseValidAmount();
            const hasMember = Boolean(memberHidden && memberHidden.value && selectedMemberSnapshot
                && selectedMemberSnapshot.id === String(memberHidden.value));
            if (!hasMember || !memberWalletPreview) {
                if (memberWalletPreview) memberWalletPreview.style.display = 'none';
                if (submitSummary) submitSummary.textContent = '請先選擇有效會員與接單人';
                updateSubmitState();
                return;
            }

            memberWalletPreview.style.display = 'block';
            const balance = Number(selectedMemberSnapshot.balance || 0);
            const bonus = Number(selectedMemberSnapshot.bonusBalance || 0);
            const after = amount === null ? balance : Number((balance - amount).toFixed(2));
            if (walletBalance) walletBalance.textContent = formatCurrency(balance);
            if (walletBonus) walletBonus.textContent = formatCurrency(bonus);
            if (walletAfter) walletAfter.textContent = formatCurrency(after);
            const enough = amount !== null && after >= 0;
            if (walletPaymentPreview) {
                walletPaymentPreview.className = `small mt-2 ${enough ? '' : 'manual-wallet-insufficient'}`;
                walletPaymentPreview.textContent = amount === null
                    ? '請輸入合法金額後預覽扣款。'
                    : (enough
                        ? `本次由主餘額扣款 ${formatCurrency(amount)}。贈送金維持獨立，不列入可付款額。`
                        : `主餘額不足，尚缺 ${formatCurrency(Math.abs(after))}；送出時伺服器會再次核對。`);
            }
            if (submitSummary) {
                submitSummary.textContent = `${selectedMemberSnapshot.nickname} (${selectedMemberSnapshot.id}) · 本次扣款 ${amount === null ? '金額無效' : formatCurrency(amount)}`;
            }
            updateSubmitState();
        }

        function updateSubmitState() {
            if (!submitBtn) return;
            const amount = parseValidAmount();
            const durationRaw = String(durationInput && durationInput.value || '').trim();
            const durationValid = /^(0|[1-9]\d*)(\.\d{1,2})?$/.test(durationRaw)
                && Number.isFinite(Number(durationRaw)) && Number(durationRaw) > 0 && Number(durationRaw) <= 10000;
            const walletReady = Boolean(selectedMemberSnapshot && selectedMemberSnapshot.id === String(memberHidden.value)
                && amount !== null && Number(selectedMemberSnapshot.balance) >= amount);
            const ready = Boolean(memberHidden.value && talentHidden.value && walletReady && durationValid
                && String(gameInput && gameInput.value || '').trim() && !submitting);
            submitBtn.disabled = !ready;
            if (validationText) {
                if (submitting) validationText.textContent = '訂單建立中…';
                else if (!memberHidden.value) validationText.textContent = '請選擇有效會員。';
                else if (!talentHidden.value) validationText.textContent = '請選擇有效接單人。';
                else if (amount === null) validationText.textContent = '金額需為 0 至 1,000,000,000，最多兩位小數。';
                else if (!durationValid) validationText.textContent = '時長/數量需大於 0，最多兩位小數。';
                else if (!walletReady) validationText.textContent = '錢包主餘額不足或尚未載入。';
                else if (!String(gameInput && gameInput.value || '').trim()) validationText.textContent = '請填寫服務項目。';
                else validationText.textContent = '';
            }
        }

        function setSelectedChip(container, label, id, extraText) {
            if (!container) return;
            if (!label || !id) {
                container.style.display = 'none';
                container.innerHTML = '';
                return;
            }
            container.style.display = 'block';
            container.innerHTML = '';
            const chip = document.createElement('span');
            chip.className = 'manual-selected-chip';
            chip.textContent = `${label} · ${id}${extraText ? ` · ${extraText}` : ''}`;
            container.appendChild(chip);
        }

        function closeResults(panel) {
            if (!panel) return;
            panel.style.display = 'none';
            panel.innerHTML = '';
        }

        function renderResults(panel, rows, onChoose, emptyText) {
            if (!panel) return;
            panel.innerHTML = '';
            if (!rows.length) {
                const empty = document.createElement('div');
                empty.className = 'manual-search-empty small px-3 py-2';
                empty.textContent = emptyText;
                panel.appendChild(empty);
                panel.style.display = 'block';
                return;
            }
            rows.forEach(row => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'manual-search-item';
                button.textContent = row.label;
                button.addEventListener('click', () => onChoose(row));
                panel.appendChild(button);
            });
            panel.style.display = 'block';
        }

        function debounce(fn, wait) {
            let timer = null;
            return (...args) => {
                if (timer) clearTimeout(timer);
                timer = setTimeout(() => fn(...args), wait);
            };
        }

        async function fetchJson(url) {
            const response = await fetch(url, {
                method: 'GET',
                headers: { Accept: 'application/json' },
                credentials: 'same-origin'
            });
            let payload = null;
            try {
                payload = await response.json();
            } catch (_error) {
                payload = null;
            }
            if (!response.ok || !payload || payload.success !== true) {
                throw new Error(payload && payload.error ? payload.error : '資料讀取失敗，請稍後再試。');
            }
            return payload;
        }

        const searchMembers = debounce(async (keyword, sequence) => {
            if (keyword.length < 2) {
                closeResults(memberResults);
                return;
            }
            try {
                const payload = await fetchJson(`/management/orders/create/member-options?q=${encodeURIComponent(keyword)}`);
                if (sequence !== memberSearchSequence || keyword !== String(memberInput.value || '').trim()) return;
                const rows = (payload.members || []).map(member => ({
                    id: member.id,
                    nickname: member.nickname,
                    label: `${member.nickname} · Discord ${member.id} · VIP ${member.vipLevel}`,
                    value: member
                }));
                renderResults(memberResults, rows, item => {
                    memberSearchSequence += 1;
                    const walletSequence = ++memberWalletSequence;
                    memberHidden.value = String(item.id);
                    memberInput.value = `${item.nickname} (${item.id})`;
                    closeResults(memberResults);
                    setSelectedChip(memberSelected, item.nickname, item.id, `Discord ID ${item.id} · VIP ${item.value.vipLevel}`);
                    selectedMemberSnapshot = null;
                    updateWalletPreview();
                    fetchJson(`/management/orders/create/member-wallet/${encodeURIComponent(item.id)}`)
                        .then(walletPayload => {
                            if (walletSequence !== memberWalletSequence || String(memberHidden.value) !== String(item.id)) return;
                            selectedMemberSnapshot = walletPayload.member;
                            updateWalletPreview();
                        })
                        .catch(error => {
                            if (walletSequence !== memberWalletSequence) return;
                            memberHidden.value = '';
                            selectedMemberSnapshot = null;
                            setSelectedChip(memberSelected, '', '', '');
                            setError(error.message || '會員錢包讀取失敗');
                            updateWalletPreview();
                        });
                }, '找不到符合條件的會員');
            } catch (error) {
                if (sequence !== memberSearchSequence) return;
                setError(error.message || '會員搜尋失敗');
            }
        }, 240);

        const searchTakers = debounce(async (keyword, sequence) => {
            if (keyword.length < 2) {
                closeResults(talentResults);
                return;
            }
            try {
                const payload = await fetchJson(`/management/orders/create/taker-options?q=${encodeURIComponent(keyword)}`);
                if (sequence !== takerSearchSequence || keyword !== String(talentInput.value || '').trim()) return;
                const rows = (payload.takers || []).map(taker => {
                    const statusLabel = String(taker.status || 'idle');
                    const hasPersonalRate = taker.personalRate !== null && taker.personalRate !== undefined;
                    return {
                        id: taker.id,
                        nickname: taker.nickname,
                        personalRate: hasPersonalRate ? Number(taker.personalRate) : null,
                        label: `${taker.nickname} · ${taker.id} · 狀態 ${statusLabel}${hasPersonalRate ? ` · 個人成數 ${(Number(taker.personalRate) * 100).toFixed(2)}%` : ''}`,
                        statusLabel
                    };
                });
                renderResults(talentResults, rows, item => {
                    talentHidden.value = String(item.id);
                    talentInput.value = `${item.nickname} (${item.id})`;
                    selectedTalentRate = item.personalRate;
                    setSelectedChip(
                        talentSelected,
                        item.nickname,
                        item.id,
                        item.personalRate === null
                            ? item.statusLabel
                            : `${item.statusLabel} / ${(item.personalRate * 100).toFixed(2)}%`
                    );
                    closeResults(talentResults);
                        takerSearchSequence += 1;
                    refreshPreview();
                }, '找不到符合條件的接單者');
            } catch (error) {
                if (sequence !== takerSearchSequence) return;
                setError(error.message || '接單者搜尋失敗');
            }
        }, 240);

        function getBaseTalentRate() {
            if (selectedTalentRate !== null && Number.isFinite(Number(selectedTalentRate))) {
                return Number(selectedTalentRate);
            }
            const category = String(categoryInput && categoryInput.value || '陪玩單');
            const fallback = Number(defaults[category]);
            return Number.isFinite(fallback) ? fallback : 0.8;
        }

        function getAppliedTalentRate() {
            let rate = getBaseTalentRate();
            const overrideEnabled = Boolean(ratioToggle && ratioToggle.checked && canAdjustRate);
            if (!overrideEnabled) return rate;

            const ratioValue = Number(ratioValueInput && ratioValueInput.value);
            if (!Number.isFinite(ratioValue)) return rate;
            const rawRatio = Math.min(100, Math.max(0, ratioValue)) / 100;
            const mode = String(ratioModeInput && ratioModeInput.value || 'talent_share');
            rate = mode === 'studio_cut' ? (1 - rawRatio) : rawRatio;
            if (!Number.isFinite(rate) || rate < 0 || rate > 1) {
                return getBaseTalentRate();
            }
            return rate;
        }

        function refreshPreview() {
            const amount = Number(amountInput && amountInput.value || 0);
            const safeAmount = Number.isFinite(amount) && amount > 0 ? amount : 0;
            const rate = getAppliedTalentRate();
            const talentNet = Math.round(safeAmount * rate);
            const studioCut = Math.max(0, safeAmount - talentNet);
            if (previewRate) previewRate.textContent = `${(rate * 100).toFixed(2)}%`;
            if (previewTalentNet) previewTalentNet.textContent = formatCurrency(talentNet);
            if (previewStudioCut) previewStudioCut.textContent = formatCurrency(studioCut);
            updateWalletPreview();
        }

        function syncOverrideControls() {
            if (!ratioModeInput || !ratioValueInput || !ratioToggle) return;
            const enabled = canAdjustRate && ratioToggle.checked;
            ratioModeInput.disabled = !enabled;
            ratioValueInput.disabled = !enabled;
            if (!enabled) ratioValueInput.value = '';
            refreshPreview();
        }

        async function submitManualCreate(event) {
            event.preventDefault();
            setError('');

            if (!memberHidden.value) {
                setError('請先選擇有效會員。');
                memberInput.focus();
                return;
            }
            if (!talentHidden.value) {
                setError('請先選擇有效接單者。');
                talentInput.focus();
                return;
            }

            const amount = parseValidAmount();
            if (amount === null) {
                setError('訂單金額格式無效，最多兩位小數且不可超過 1,000,000,000。');
                amountInput.focus();
                updateSubmitState();
                return;
            }
            if (!selectedMemberSnapshot || selectedMemberSnapshot.id !== String(memberHidden.value)) {
                setError('會員錢包尚未載入，請稍候或重新選擇會員。');
                return;
            }
            if (Number(selectedMemberSnapshot.balance) < amount) {
                setError('會員錢包主餘額不足，請確認最新餘額。');
                updateWalletPreview();
                return;
            }

            if (submitting) return;
            submitting = true;
            updateSubmitState();
            setError('');

            if (!requestKeyInput.value) {
                requestKeyInput.value = createRequestKey();
            }

            const params = new URLSearchParams(new FormData(form));
            const submitLoading = window.MiHuFeedback && typeof window.MiHuFeedback.setButtonLoading === 'function';
            if (submitLoading && submitBtn) {
                window.MiHuFeedback.setButtonLoading(submitBtn, { loading: true, text: '建立中...' });
            } else if (submitBtn) {
                submitBtn.disabled = true;
            }

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        Accept: 'application/json'
                    },
                    body: params.toString(),
                    credentials: 'same-origin'
                });

                let payload = null;
                try {
                    payload = await response.json();
                } catch (_error) {
                    payload = null;
                }

                if (!response.ok || !payload || payload.success !== true) {
                    const message = payload && payload.error ? payload.error : '手動建立訂單失敗，請稍後再試。';
                    if (payload && payload.wallet && selectedMemberSnapshot
                        && selectedMemberSnapshot.id === String(memberHidden.value)) {
                        selectedMemberSnapshot = { ...selectedMemberSnapshot, ...payload.wallet };
                        updateWalletPreview();
                    }
                    if (payload && payload.code === 'IDEMPOTENCY_CONFLICT') {
                        requestKeyInput.value = createRequestKey();
                    }
                    setError(message);
                    return;
                }

                if (window.MiHuFeedback && typeof window.MiHuFeedback.success === 'function') {
                    window.MiHuFeedback.success(payload.successMsg || '手動訂單建立成功');
                }
                window.location.assign(payload.redirect || '/management/orders');
            } catch (_error) {
                setError('網路連線中斷，請稍後再試。');
            } finally {
                submitting = false;
                if (submitLoading && submitBtn) {
                    window.MiHuFeedback.setButtonLoading(submitBtn, { loading: false });
                }
                updateSubmitState();
            }
        }

        if (memberInput) {
            memberInput.addEventListener('input', () => {
                setError('');
                memberSearchSequence += 1;
                memberWalletSequence += 1;
                memberHidden.value = '';
                selectedMemberSnapshot = null;
                setSelectedChip(memberSelected, '', '', '');
                updateWalletPreview();
                closeResults(memberResults);
                const keyword = String(memberInput.value || '').trim();
                searchMembers(keyword, memberSearchSequence);
            });
            memberInput.addEventListener('focus', () => {
                if (memberInput.value.trim().length >= 2) {
                    memberSearchSequence += 1;
                    searchMembers(memberInput.value.trim(), memberSearchSequence);
                }
            });
        }

        if (talentInput) {
            talentInput.addEventListener('input', () => {
                setError('');
                takerSearchSequence += 1;
                talentHidden.value = '';
                selectedTalentRate = null;
                setSelectedChip(talentSelected, '', '', '');
                closeResults(talentResults);
                refreshPreview();
                searchTakers(String(talentInput.value || '').trim(), takerSearchSequence);
            });
            talentInput.addEventListener('focus', () => {
                if (talentInput.value.trim().length >= 2) {
                    takerSearchSequence += 1;
                    searchTakers(talentInput.value.trim(), takerSearchSequence);
                }
            });
        }

        document.addEventListener('click', event => {
            if (!modalEl.contains(event.target)) return;
            if (memberResults && !memberResults.contains(event.target) && event.target !== memberInput) {
                closeResults(memberResults);
            }
            if (talentResults && !talentResults.contains(event.target) && event.target !== talentInput) {
                closeResults(talentResults);
            }
        });

        if (ratioToggle) ratioToggle.addEventListener('change', syncOverrideControls);
        if (ratioModeInput) ratioModeInput.addEventListener('change', refreshPreview);
        if (ratioValueInput) ratioValueInput.addEventListener('input', refreshPreview);
        if (amountInput) amountInput.addEventListener('input', refreshPreview);
        if (durationInput) durationInput.addEventListener('input', updateSubmitState);
        if (gameInput) gameInput.addEventListener('input', updateSubmitState);
        if (categoryInput) categoryInput.addEventListener('change', refreshPreview);

        form.addEventListener('submit', submitManualCreate);
        modalEl.addEventListener('show.bs.modal', () => {
            requestKeyInput.value = '';
            syncOverrideControls();
            refreshPreview();
            setError('');
        });

        modalEl.addEventListener('hidden.bs.modal', () => {
            requestKeyInput.value = '';
            closeResults(memberResults);
            closeResults(talentResults);
        });

        syncOverrideControls();
        refreshPreview();
    })();
</script>
<% } %>
