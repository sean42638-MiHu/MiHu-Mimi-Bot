                                <td colspan="6" class="text-center text-secondary py-3">請先選擇分類</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-secondary d-flex justify-content-between">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-light btn-sm" id="incomeCategoryDetailPrevPage">上一頁</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="incomeCategoryDetailNextPage">下一頁</button>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
