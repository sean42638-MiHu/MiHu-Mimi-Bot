<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIP設定 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        .content-body { 
            padding: 20px 36px 32px;
            flex-grow: 1; 
        }
        
        .glass-panel-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
        }

        .glass-table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
        }

        .vip-scroll-container {
            max-height: calc(var(--vip-header-height, 54px) + (var(--vip-row-height, 64px) * 5));
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(168, 85, 247, 0.55) rgba(15, 23, 42, 0.6);
        }
        .vip-scroll-container::-webkit-scrollbar { width: 6px; }
        .vip-scroll-container::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); border-radius: 999px; }
        .vip-scroll-container::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.42); border-radius: 999px; box-shadow: 0 0 8px rgba(168, 85, 247, 0.14); }
        .vip-scroll-container::-webkit-scrollbar-thumb:hover { background: rgba(168, 85, 247, 0.78); box-shadow: 0 0 10px rgba(168, 85, 247, 0.22); }
        .vip-scroll-container .mihu-table thead th { position: sticky; top: 0; z-index: 5; background: rgba(11, 9, 20, 0.96); }

        .table-responsive { margin: 0; }
        .mihu-table {
            width: 100%;
            margin-bottom: 0;
            color: #f3f4f6;
            border-collapse: separate;
            border-spacing: 0;
        }
        .mihu-table th {
            background: rgba(0, 0, 0, 0.42);
            color: #94a3b8;
            font-weight: 700;
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            white-space: nowrap;
        }
        .mihu-table td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.92rem;
            white-space: nowrap;
        }
        .mihu-table tbody tr {
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .mihu-table tbody tr:hover {
            background: rgba(168, 85, 247, 0.08);
        }
        .mihu-table tbody tr:last-child td {
            border-bottom: none;
        }

        .rewards-preview-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-width: 480px;
        }
        .reward-tag {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            padding: 2px 8px;
            font-size: 0.78rem;
            color: #cbd5e1;
            white-space: nowrap;
        }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97);
            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px);
            color: #fff;
        }

        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.92rem;
        }
        .form-control-glass:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            color: #ffffff;
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }

        .reward-item-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        .reward-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #f3f4f6;
            border-radius: 8px;
            padding: 7px 12px;
            font-size: 0.88rem;
            flex-grow: 1;
        }
        .reward-input:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            color: #fff;
            outline: none;
        }
        .btn-add-reward {
            background: rgba(168, 85, 247, 0.15);
            border: 1px dashed rgba(168, 85, 247, 0.4);
            color: #d8b4fe;
            border-radius: 8px;
            font-size: 0.82rem;
            padding: 7px 12px;
            width: 100%;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-add-reward:hover {
            background: rgba(168, 85, 247, 0.25);
            color: #fff;
        }
        .btn-del-reward {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #f87171;
            border-radius: 8px;
            padding: 6px 10px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-del-reward:hover { background: rgba(239, 68, 68, 0.35); color: #fff; }

        .view-reward-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .view-reward-list li {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .view-reward-list li i {
            color: #fde047;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'vip' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'vip' }) %>

    <div class="content-body admin-page-content">
        <!-- 🚀 專屬大標題與說明（左側標題、右側按鈕置右） -->
        <%- include('partials/admin_page_header', { icon: 'fa-crown', title: 'VIP設定', description: '設定各階級 VIP 門檻（累計消費與預存額度）及對應特權獎勵內容', actions: '<button type="button" class="btn btn-sm px-3 py-2 rounded-pill text-white fw-semibold" data-bs-toggle="modal" data-bs-target="#addVipModal" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;"><i class="fa-solid fa-plus me-1"></i>新增 VIP 等級</button>' }) %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ VIP 設定已成功更新！
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 px-3 small mb-4 border-0 bg-danger bg-opacity-25 text-danger"><%= error %></div>
        <% } %>

        <!-- 📊 1. 獨立模組：VIP 門檻與特權對照表格 -->
        <%- include('partials/vip_table', { vipTiers: vipTiers }) %>

        <!-- 💳 2. 獨立模組：VIP 尊榮卡片樣式展示區塊 (單張切換) -->
        <div class="glass-panel-card p-4 mb-4 vip-showcase-shell">
            <div class="d-flex justify-content-between align-items-center mb-4 vip-showcase-header">
                <div>
                    <div class="h5 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-id-card text-warning"></i>
                        <span>VIP 尊榮身份卡片樣式展示</span>
                    </div>
                    <p class="text-secondary small mb-0">當會員達到對應 VIP 等級時，錢包與個人主頁將自動替換為該等級的限定金屬質感信用卡。</p>
                </div>
            </div>

            <!-- 引用獨立模組：單張卡片展示與切換 -->
            <%- include('partials/vip_cards_showcase', { vipTiers: vipTiers }) %>
        </div>
    </div>
</div>

<!-- 🚀 3. 獨立模組：查看/編輯/新增 VIP 彈窗群組 -->
<%- include('modals/vip_modals') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const viewModal = new bootstrap.Modal(document.getElementById('viewVipModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editVipModal'));

        function normalizeVipColorInput(value) {
            const raw = String(value || '').trim().toUpperCase();
            const candidate = raw.startsWith('#') ? raw : `#${raw}`;
            return /^#[0-9A-F]{6}$/.test(candidate) ? candidate : null;
        }

        function setupVipColorPicker(colorInputId, hexInputId, previewId, nameInputId) {
            const colorInput = document.getElementById(colorInputId);
            const hexInput = document.getElementById(hexInputId);
            const preview = document.getElementById(previewId);
            const nameInput = nameInputId ? document.getElementById(nameInputId) : null;
            if (!colorInput || !hexInput || !preview) return;
            const updatePreview = (value) => {
                const normalized = normalizeVipColorInput(value);
                if (!normalized) return false;
                colorInput.value = normalized;
                hexInput.value = normalized;
                preview.style.setProperty('--vip-color', normalized);
                if (nameInput) preview.querySelector('[data-vip-preview-name]')?.replaceChildren(nameInput.value || 'VIP');
                return true;
            };
            colorInput.addEventListener('input', () => updatePreview(colorInput.value));
            hexInput.addEventListener('input', () => { if (normalizeVipColorInput(hexInput.value)) updatePreview(hexInput.value); });
            hexInput.addEventListener('blur', () => updatePreview(hexInput.value || '#A855F7'));
            nameInput?.addEventListener('input', () => { preview.querySelector('[data-vip-preview-name]')?.replaceChildren(nameInput.value || 'VIP'); });
        }

        setupVipColorPicker('editVipColorPicker', 'editVipColor', 'editVipColorPreview', null);
        setupVipColorPicker('addVipColorPicker', 'addVipColor', 'addVipColorPreview', 'addVipName');
        document.getElementById('addVipModal')?.addEventListener('show.bs.modal', () => {
            document.getElementById('addVipColorPicker').value = '#A855F7';
            document.getElementById('addVipColor').value = '#A855F7';
            document.getElementById('addVipColorPreview').style.setProperty('--vip-color', '#A855F7');
            document.querySelector('#addVipColorPreview [data-vip-preview-name]')?.replaceChildren('VIP');
        });

    function openViewModal(level, name, spent, deposit, color, el) {
        const rewards = JSON.parse(el.getAttribute('data-rewards') || '[]');
        const viewBadge = document.getElementById('viewVipTitleBadge');
        viewBadge.style.setProperty('--vip-color', normalizeVipColorInput(color) || '#A855F7');
        viewBadge.querySelector('.vip-badge__label')?.replaceChildren(name);
        document.getElementById('viewSpent').textContent = `${Number(spent).toLocaleString()} T`;
        document.getElementById('viewDeposit').textContent = `${Number(deposit).toLocaleString()} T`;
        
        const list = document.getElementById('viewRewardsList');
        list.innerHTML = '';
        rewards.forEach(r => {
            const li = document.createElement('li');
                const icon = document.createElement('i');
                icon.className = 'fa-solid fa-gift';
                icon.setAttribute('aria-hidden', 'true');
                const text = document.createElement('span');
                text.textContent = String(r);
                li.append(icon, text);
            list.appendChild(li);
        });

        viewModal.show();
    }

    function openEditModal(level, name, spent, deposit, color, el) {
        const rewards = JSON.parse(el.getAttribute('data-rewards') || '[]');
        document.getElementById('editVipForm').action = `/system/vip/update/${level}`;
        document.getElementById('editVipModalTitle').textContent = `編輯 ${name} 設定`;
        document.getElementById('editSpent').value = spent;
        document.getElementById('editDeposit').value = deposit;
        const normalizedColor = normalizeVipColorInput(color) || '#A855F7';
        document.getElementById('editVipColorPicker').value = normalizedColor;
        document.getElementById('editVipColor').value = normalizedColor;
        document.getElementById('editVipColorPreview').style.setProperty('--vip-color', normalizedColor);
        document.querySelector('#editVipColorPreview [data-vip-preview-name]')?.replaceChildren(name);

        const container = document.getElementById('editRewardsContainer');
        container.innerHTML = '';
        rewards.forEach(r => {
            container.appendChild(createRewardRow(r));
        });

        editModal.show();
    }

    function createRewardRow(val = '') {
        const row = document.createElement('div');
        row.className = 'reward-item-row';
            const input = document.createElement('input');
            input.type = 'text';
            input.name = 'rewards[]';
            input.className = 'reward-input admin-form-control';
            input.value = String(val || '');
            input.placeholder = '輸入獎勵項目';
            input.required = true;
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'btn-del-reward admin-btn admin-btn-danger';
            remove.title = '移除獎勵';
            remove.setAttribute('aria-label', '移除獎勵');
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-trash-can';
            icon.setAttribute('aria-hidden', 'true');
            remove.appendChild(icon);
            remove.addEventListener('click', () => row.remove());
            row.append(input, remove);
        return row;
    }

    function addEditRewardRow() {
        const container = document.getElementById('editRewardsContainer');
        const row = createRewardRow('');
        container.appendChild(row);
        row.querySelector('input').focus();
    }

    document.querySelectorAll('.vip-tier-row').forEach(row => {
        row.addEventListener('click', event => {
            if (event.target.closest('.vip-edit-trigger')) return;
            openViewModal(row.dataset.vipLevel, row.dataset.vipName, row.dataset.vipSpent, row.dataset.vipDeposit, row.dataset.vipColor, row);
        });
        row.querySelector('.vip-edit-trigger')?.addEventListener('click', event => {
            event.stopPropagation();
            openEditModal(row.dataset.vipLevel, row.dataset.vipName, row.dataset.vipSpent, row.dataset.vipDeposit, row.dataset.vipColor, row);
        });
    });
</script>
</body>
</html>