<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>身分管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/roles-page.css">
</head>
<body class="mihu-admin-page text-light">

<div class="app-layout">
<%- include('partials/sidebar', { activePage: 'roles' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'roles' }) %>

    <div class="content-body admin-page-content roles-page">
        <%- include('partials/admin_page_header', { icon: 'fa-shield-halved', title: '身分管理', description: '自訂系統身分組類別、權限層級與各功能模組之訪問與操作權限', actions: hasPerm('roles.manage') ? '<button type="button" class="btn btn-sm px-3 py-2 rounded-pill text-white fw-semibold" data-bs-toggle="modal" data-bs-target="#addRoleModal" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;"><i class="fa-solid fa-plus me-1"></i>新增身分組</button>' : '' }) %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ 身分設定已成功更新！
            </div>
        <% } %>

        <%- include('partials/roles_table') %>
    </div>
</div>
</div>

<%- include('modals/role_permission_modal') %>
<%- include('modals/role_info_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>window.rolePageConfig = <%- JSON.stringify({ delegatablePermissions: delegatablePermissions || [], legacyPermissionImplications: typeof legacyPermissionImplications !== 'undefined' ? legacyPermissionImplications : {}, canGrantWildcard: Boolean(canGrantWildcard) }).replace(/</g, "\\u003c") %>;</script>
<script src="/js/roles-page.js" defer></script>
</body>
</html>
