                                        <label class="form-check-label text-white small" for="perm_member_adjust_balance">會員帳務調整</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="member_adjust_vip" id="perm_member_adjust_vip">
                                        <label class="form-check-label text-white small" for="perm_member_adjust_vip">手動 VIP 等級調整</label>
                                    </div>
                                </div>
                            </div>

                            <!-- 員工管理與敏感個資 -->
                            <div class="col-md-6">
                                <div class="p-3 rounded-3" style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2);">
                                    <div class="small fw-bold text-success mb-2"><i class="fa-solid fa-id-badge me-1"></i> 員工管理與敏感個資</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="staff_view_payroll" id="perm_staff_view_payroll">
                                        <label class="form-check-label text-white small" for="perm_staff_view_payroll">查看員工敏感薪轉個資</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="staff_edit_role_commission" id="perm_staff_edit_role_commission">
                                        <label class="form-check-label text-white small" for="perm_staff_edit_role_commission">設定員工職務與抽佣比例</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="p-3 rounded-3" style="background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2);">
                                    <div class="small fw-bold text-info mb-2"><i class="fa-solid fa-money-bill-transfer me-1"></i>提款與薪轉權限</div>
                                    <div class="row g-2">
                                        <div class="col-md-4 form-check form-switch">
                                            <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="payout.view" id="perm_payout_view">
                                            <label class="form-check-label text-white small" for="perm_payout_view">查看提款申請</label>
                                        </div>
                                        <div class="col-md-4 form-check form-switch">
                                            <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="payout.view_sensitive" id="perm_payout_view_sensitive">
                                            <label class="form-check-label text-white small" for="perm_payout_view_sensitive">查看完整薪轉資料</label>
                                        </div>
                                        <div class="col-md-4 form-check form-switch">
                                            <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="payout.export" id="perm_payout_export">
                                            <label class="form-check-label text-white small" for="perm_payout_export">匯出待撥款 Excel</label>
                                        </div>
                                        <div class="col-md-4 form-check form-switch">
                                            <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="payout.mark_paid" id="perm_payout_mark_paid">
                                            <label class="form-check-label text-white small" for="perm_payout_mark_paid">標記已撥款</label>
                                        </div>
                                        <div class="col-md-4 form-check form-switch">
                                            <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="payout.reject" id="perm_payout_reject">
                                            <label class="form-check-label text-white small" for="perm_payout_reject">退回提款申請</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 全站訂單核心操作 -->
                            <div class="col-md-12">
