<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>身分管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        .content-body { 
            padding: 16px 36px 32px; 
            flex-grow: 1; 
        }

        .glass-table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
        }

        .table-responsive { margin: 0; }
        .mihu-table {
            width: 100%;
            margin-bottom: 0;
            color: #f3f4f6;
            border-collapse: separate;
            border-spacing: 0;
        }
        .mihu-table th {
            background: rgba(0, 0, 0, 0.42);
            color: #94a3b8;
            font-weight: 700;
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            white-space: nowrap;
        }
        .mihu-table td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.92rem;
        }
        .mihu-table tbody tr.role-row {
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .mihu-table tbody tr.role-row:hover {
            background: rgba(168, 85, 247, 0.08);
        }
        .mihu-table tbody tr:last-child td {
            border-bottom: none;
        }

        .category-text-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #94a3b8;
            white-space: nowrap;
        }
        .category-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }
        .dot-最高權限 { background: #ef4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.8); }
        .dot-主管職位 { background: #f59e0b; box-shadow: 0 0 8px rgba(245, 158, 11, 0.8); }
        .dot-客服職位 { background: #38bdf8; box-shadow: 0 0 8px rgba(56, 189, 248, 0.8); }
        .dot-一般職位 { background: #c084fc; box-shadow: 0 0 8px rgba(192, 132, 252, 0.8); }
        .dot-會員     { background: #94a3b8; box-shadow: 0 0 6px rgba(148, 163, 184, 0.5); }

        .role-pill-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        .badge-style-danger {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.25), rgba(185, 28, 28, 0.3));
            border: 1px solid rgba(239, 68, 68, 0.5);
            color: #fca5a5;
        }
        .badge-style-warning {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(180, 83, 9, 0.3));
            border: 1px solid rgba(245, 158, 11, 0.5);
            color: #fde047;
        }
        .badge-style-info {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.25), rgba(14, 116, 144, 0.3));
            border: 1px solid rgba(56, 189, 248, 0.5);
            color: #7dd3fc;
        }
        .badge-style-primary {
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.25), rgba(109, 40, 217, 0.3));
            border: 1px solid rgba(168, 85, 247, 0.5);
            color: #e9d5ff;
        }
        .badge-style-secondary {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #cbd5e1;
        }

        .action-btns-group {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }
        .action-btn-clean {
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            font-size: 0.82rem;
            padding: 5px 12px;
            line-height: 1.2;
            cursor: pointer;
        }

        .perm-tree-box {
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 16px;
            max-height: 260px;
            overflow-y: auto;
        }
        .perm-tree-box::-webkit-scrollbar { width: 6px; }
        .perm-tree-box::-webkit-scrollbar-thumb {
            background: rgba(168, 85, 247, 0.4);
            border-radius: 6px;
        }

        .form-check-input {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.25);
            cursor: pointer;
            margin-right: 8px;
        }
        .form-check-input:checked {
            background-color: #9333ea;
            border-color: #c084fc;
        }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97);
            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px);
            color: #fff;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }
        .modal-body { overflow-y: auto; }

        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #ffffff !important;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.92rem;
        }
        .form-control-glass:focus {
            background-color: #171326 !important;
            color: #ffffff !important;
            border-color: #c084fc !important;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3) !important;
            outline: none !important;
        }
        .form-control-glass::placeholder { color: #64748b !important; }

        input.form-control-glass:-webkit-autofill,
        input.form-control-glass:-webkit-autofill:hover, 
        input.form-control-glass:-webkit-autofill:focus {
            -webkit-text-fill-color: #ffffff !important;
            -webkit-box-shadow: 0 0 0px 1000px #171326 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }
        
        select.form-control-glass option {
            background-color: #171326 !important;
            color: #ffffff !important;
            padding: 8px 12px;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'roles' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'roles' }) %>

    <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <div class="page-title-text" style="font-size: 1.5rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                    <i class="fa-solid fa-shield-halved text-success"></i>
                    <span>身分管理</span>
                </div>
                <p class="text-secondary small mb-0">自訂系統身分組類別、權限層級與各功能模組之訪問與操作權限</p>
            </div>

            <div>
                <button type="button" class="btn btn-sm px-3 py-2 rounded-pill text-white fw-semibold" data-bs-toggle="modal" data-bs-target="#addRoleModal" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                    <i class="fa-solid fa-plus me-1"></i>新增身分組
                </button>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ 身分設定已成功更新！
            </div>
        <% } %>

        <div class="glass-table-card">
            <div class="table-responsive">
                <table class="mihu-table">
                    <thead>
                        <tr>
                            <th style="width: 130px;">階級分類</th>
                            <th style="width: 120px;">職位名稱</th>
                            <th style="width: 100px;">權重等級</th>
                            <th>職位職責說明（點擊整行看可見項目清單）</th>
                            <th style="width: 240px; min-width: 220px;" class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                            const roleList = (typeof rolesData !== 'undefined' && rolesData) ? rolesData : ((typeof roles !== 'undefined' && roles) ? roles : []);
                            if (roleList && roleList.length > 0) { 
                        %>
                            <% roleList.forEach(r => { 
                                let permsArray = [];
                                try {
                                    permsArray = typeof r.permissions === 'string' ? JSON.parse(r.permissions) : (r.permissions || []);
                                } catch (e) {
                                    permsArray = [];
                                }
                                const permsJson = JSON.stringify(permsArray).replace(/'/g, "&apos;").replace(/"/g, "&quot;");
                            %>
                                <tr class="role-row" 
                                    data-id="<%= r.id %>"
                                    data-rolekey="<%= r.role_key %>"
                                    data-name="<%= r.name %>"
                                    data-category="<%= r.category %>"
                                    data-color="<%= r.color_badge || 'primary' %>"
                                    data-tier="<%= r.tier_level %>"
                                    data-desc="<%= r.description || '' %>"
                                    data-perms='<%- permsJson %>'>
                                    <td>
                                        <div class="category-text-wrap">
                                            <span class="category-dot dot-<%= r.category %>"></span>
                                            <span><%= r.category %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="role-pill-badge badge-style-<%= r.color_badge || 'primary' %>"><%= r.name %></span>
                                    </td>
                                    <td>
                                        <span class="font-monospace text-warning fw-bold small">Lv.<%= r.tier_level %></span>
                                    </td>
                                    <td>
                                        <span class="text-light"><%= r.description || '無特別說明' %></span>
                                    </td>
                                    <td class="text-end" onclick="event.stopPropagation();">
                                        <div class="action-btns-group">
                                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill action-btn-clean btn-edit-info">
                                                <i class="fa-solid fa-user-pen me-1"></i>編輯資料
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill action-btn-clean text-white fw-semibold btn-edit-perms" style="background: linear-gradient(135deg, #9333ea, #7e22ce); border: none;">
                                                <i class="fa-solid fa-lock-open me-1"></i>編輯權限
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="fa-solid fa-folder-open fs-3 mb-2 opacity-50"></i>
                                    <p class="small mb-0">目前尚無任何身分組資料</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗 1：檢視身分權限 Modal -->
<div class="modal fade" id="viewRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 850px;">
        <div class="modal-content modal-content-glass">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <span id="viewRoleNameBadge" class="role-pill-badge badge-style-danger fs-6 px-3 py-1">職位</span>
                    <span id="viewRoleCategoryText" class="small text-secondary fw-normal">階級</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
                <div class="p-3 rounded-3 mb-3" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="text-secondary small mb-1"><i class="fa-solid fa-circle-info me-1"></i>職責說明：</div>
                    <div class="text-white small fw-medium" id="viewRoleDesc">說明內容</div>
                </div>

                <div class="small text-secondary fw-semibold mb-2 d-flex align-items-center gap-1">
                    <i class="fa-solid fa-shield-halved text-warning"></i> 允許查看與使用的系統模組：
                </div>
                
                <div class="perm-tree-box p-3 rounded-3" id="viewRolePermTreeDisplay" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(168, 85, 247, 0.25); min-height: 280px; max-height: 50vh; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- 彈窗 2：編輯身分基本資料 Modal -->
<div class="modal fade" id="editRoleInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content modal-content-glass">
            <form id="editRoleInfoForm" method="POST">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-pen text-warning"></i>
                        <span id="editRoleInfoTitle">編輯身分資料</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">職位名稱</label>
                            <input type="text" id="editInfoName" name="name" class="form-control form-control-glass" required>
                        </div>
                        <div class="col-6">
                            <label class="small text-secondary fw-semibold mb-1">所屬階級</label>
                            <select id="editInfoCategory" name="category" class="form-select form-control-glass" style="background-color: #171326; color: #fff;">
                                <option value="最高權限">最高權限</option>
                                <option value="主管職位">主管職位</option>
                                <option value="客服職位">客服職位</option>
                                <option value="一般職位">一般職位</option>
                                <option value="會員">會員</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">權限權重等級 (1~100)</label>
                        <input type="number" id="editInfoTier" name="tier_level" class="form-control form-control-glass" required>
                    </div>

                    <div class="mb-3">
                        <label class="small text-secondary fw-semibold mb-1">職責說明</label>
                        <input type="text" id="editInfoDesc" name="description" class="form-control form-control-glass" required>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4" style="background-color: #9333ea; border: none;">儲存資料</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 彈窗 3：編輯身分組權限 Modal (刪除英文括號乾淨版) -->
<div class="modal fade" id="editRolePermsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 880px;">
        <div class="modal-content modal-content-glass" style="background: rgba(20, 16, 35, 0.97); border: 1px solid rgba(168, 85, 247, 0.35); border-radius: 20px; color: #fff; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);">
            <form action="/system/roles/update-permissions" method="POST">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-shield text-warning"></i>
                        編輯身分權限：<span id="targetRoleName" class="text-info"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
                    <input type="hidden" id="targetRoleKey" name="role">

                    <!-- 分區一：側邊欄選單與頁面能見度 -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2 pb-1 border-bottom border-secondary border-opacity-25">
                            <i class="fa-solid fa-bars-staggered text-purple" style="color: #c084fc;"></i>
                            <h6 class="fw-bold text-white m-0">1. 側邊欄選單與模組能見度</h6>
                        </div>
                        
                        <div class="row g-3">
                            <!-- 個人專區選單 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); height: 100%;">
                                    <div class="small fw-bold text-purple mb-2" style="color: #c084fc;">個人專區</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="home" id="perm_home">
                                        <label class="form-check-label text-white small" for="perm_home">控制台首頁</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="personal" id="perm_personal">
                                        <label class="form-check-label text-white small" for="perm_personal">個人專區選單</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="profile" id="perm_profile">
                                        <label class="form-check-label text-white small" for="perm_profile">個人檔案</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="my_wallet" id="perm_my_wallet">
                                        <label class="form-check-label text-white small" for="perm_my_wallet">我的錢包</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="my_income" id="perm_my_income">
                                        <label class="form-check-label text-white small" for="perm_my_income">我的收入</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="my_orders" id="perm_my_orders">
                                        <label class="form-check-label text-white small" for="perm_my_orders">我的訂單</label>
                                    </div>
                                </div>
                            </div>

                            <!-- 營運管理選單 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); height: 100%;">
                                    <div class="small fw-bold text-info mb-2">工作室管理</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="manage" id="perm_manage">
                                        <label class="form-check-label text-white small" for="perm_manage">營運總覽選單</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="manage_members" id="perm_manage_members">
                                        <label class="form-check-label text-white small" for="perm_manage_members">會員管理</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="manage_staff" id="perm_manage_staff">
                                        <label class="form-check-label text-white small" for="perm_manage_staff">員工管理</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="manage_orders" id="perm_manage_orders">
                                        <label class="form-check-label text-white small" for="perm_manage_orders">全站訂單總覽</label>
                                    </div>
                                </div>
                            </div>

                            <!-- 系統控制選單 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); height: 100%;">
                                    <div class="small fw-bold text-success mb-2">系統控制</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="system" id="perm_system">
                                        <label class="form-check-label text-white small" for="perm_system">系統控制選單</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="sys_vip" id="perm_sys_vip">
                                        <label class="form-check-label text-white small" for="perm_sys_vip">VIP 設定</label>
