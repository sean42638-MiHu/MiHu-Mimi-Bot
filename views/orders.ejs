<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>訂單管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 24px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .filter-tabs {
            display: flex;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 4px;
            border-radius: 14px;
            flex-wrap: wrap;
        }
        .filter-tab-btn {
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 0.84rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .filter-tab-btn:hover { color: #fff; }
        .filter-tab-btn.active {
            background: rgba(168, 85, 247, 0.25);
            color: #fff;
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.25);
        }

        .search-box-wrap { position: relative; width: 280px; flex-shrink: 0; }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
        }
        .search-icon-left { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.88rem; }
        .search-clear-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; display: none; border: none; background: transparent; }

        .btn-batch-delete {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.84rem;
            border-radius: 20px;
            padding: 6px 16px;
            border: 1px solid rgba(239, 68, 68, 0.5);
            box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-batch-delete:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            box-shadow: 0 6px 18px rgba(239, 68, 68, 0.5);
            transform: translateY(-1px);
        }

        .batch-delete-modal .modal-content {
            background: linear-gradient(165deg, rgba(10, 8, 18, 0.98), rgba(33, 13, 56, 0.95));
            border: 1px solid rgba(168, 85, 247, 0.32);
            box-shadow: 0 24px 54px rgba(7, 4, 18, 0.75);
            color: #f8fafc;
        }
        .batch-delete-modal .modal-header,
        .batch-delete-modal .modal-footer {
            border-color: rgba(168, 85, 247, 0.28);
        }
        .batch-delete-modal .refund-preview-board {
            background: rgba(14, 9, 31, 0.88);
            border: 1px solid rgba(168, 85, 247, 0.28);
            border-radius: 14px;
            padding: 14px;
        }
        .batch-delete-modal .preview-item {
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: rgba(15, 23, 42, 0.45);
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 8px;
            font-size: 0.87rem;
        }
        .batch-delete-modal .preview-item:last-child {
            margin-bottom: 0;
        }
        .batch-delete-modal .preview-reason {
            color: #fca5a5;
            font-size: 0.8rem;
            margin-top: 4px;
        }
        .batch-delete-modal .btn-danger-confirm {
            background: linear-gradient(135deg, #dc2626, #991b1b);
            border: 1px solid rgba(248, 113, 113, 0.45);
            color: #fff;
            font-weight: 800;
        }
        .batch-delete-modal .btn-danger-confirm:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

<% 
    const activeCurrUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : ((typeof user !== 'undefined' && user) ? user : {});
    const canBatchDeleteOrders = typeof hasPerm === 'function' && hasPerm('action_order_batch_delete');
    const canRefundCompletedOrders = typeof hasPerm === 'function' && hasPerm('action_order_refund_completed');
%>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'orders' }) %>

        <div class="content-body">
            <div class="page-header-content">
                <div>
                    <div class="h4 fw-bold text-white mb-1">
                        <i class="fa-solid fa-list-check text-pink me-2" style="color: #ec4899;"></i>工作室訂單管理
                    </div>
                    <p class="text-secondary small mb-0">即時監控與核算工作室訂單收益 (點擊任意訂單列即可檢視詳情或進行編輯)</p>
                </div>

                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="orderSearchInput" class="search-input-glass" placeholder="搜尋單號 / 客服 / 闆闆 / 陪陪 / 類別 / 項目...">
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
                </div>
            </div>

            <!-- 🚀 3. 狀態標籤篩選器 & 店長專屬批量刪除隱藏 Form -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="filter-tabs">
                    <button type="button" class="filter-tab-btn active" data-filter="all">全部訂單 (<%= orders ? orders.length : 0 %>)</button>
                    <button type="button" class="filter-tab-btn" data-filter="pending">派單中</button>
                    <button type="button" class="filter-tab-btn" data-filter="active">進行中</button>
                    <button type="button" class="filter-tab-btn" data-filter="completed">已完成</button>
                    <button type="button" class="filter-tab-btn" data-filter="cancelled">已取消</button>
                    <button type="button" class="filter-tab-btn" data-filter="refunded">已退款</button>
                    <button type="button" class="filter-tab-btn" data-filter="rejected">已駁回</button>
                </div>

                <% if (canBatchDeleteOrders) { %>
                    <!-- 🚀 批量刪除退款：先預覽再確認 -->
                    <form id="batchDeleteForm" action="/management/orders/batch-delete" method="POST" style="margin: 0;">
                        <input type="hidden" name="_csrf" id="batchDeleteCsrfToken" value="<%= csrfToken %>">
                        <button type="button" class="btn-batch-delete" id="btnBatchDelete" disabled>
                            <i class="fa-solid fa-trash-can"></i>
                            <span>批量刪除並退款 (<span id="selectedCount">0</span>)</span>
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success py-2 px-3 small mb-3 border-0 bg-success bg-opacity-25 text-success">
                    ✅ 訂單狀態與資料已成功更新！
                </div>
            <% } %>

            <% if (typeof successMsg !== 'undefined' && successMsg) { %>
                <div class="alert alert-success py-2 px-3 small mb-3 border-0 bg-success bg-opacity-25 text-success">
                    ✅ <%= successMsg %>
                </div>
            <% } %>

            <!-- 📊 4. 獨立模組：訂單清單表格卡片 -->
            <%- include('partials/orders_table', { 
                orders: typeof orders !== 'undefined' ? orders : [], 
                currentUser: activeCurrUser, 
                userPerms: typeof userPerms !== 'undefined' ? userPerms : [],
                canBatchDeleteOrders,
                canRefundCompletedOrders
            }) %>
        </div>
    </div>
</div>

<%- include('modals/order_detail_modal') %>

<% if (canBatchDeleteOrders) { %>
<div class="modal fade batch-delete-modal" id="batchDeletePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>批量刪除訂單並退款確認
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <p class="small mb-3 text-warning">
                    確認後會依帳務預覽結果執行「退款並刪除」或「僅刪除（本次退款 0）」；帳務流水與操作紀錄會保留。
                </p>
                <div class="refund-preview-board mb-3">
                    <div class="d-flex justify-content-between align-items-center small text-secondary mb-2">
                        <span>預覽筆數：<strong id="previewOrderCount" class="text-white">0</strong></span>
                        <span>退款總額：<strong id="previewRefundTotal" class="text-success">$0</strong></span>
                    </div>
                    <div id="batchPreviewList" aria-live="polite"></div>
                </div>
                <div id="batchPreviewBlocking" class="alert alert-danger py-2 px-3 small mb-0" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnBatchDeleteCancel" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger-confirm" id="btnBatchDeleteConfirm">確認刪除並退款</button>
            </div>
        </div>
    </div>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function setVal(id, val) {
        const el = document.getElementById(id);
        if (el) el.value = (val !== undefined && val !== null) ? val : '';
    }
    function setText(id, txt) {
        const el = document.getElementById(id);
        if (el) el.textContent = (txt !== undefined && txt !== null) ? txt : '--';
    }

    function getOrderData(rowEl) {
        if (!rowEl) return null;
        const scriptEl = rowEl.querySelector('.order-data-json');
        if (!scriptEl) return null;
        try {
            return JSON.parse(scriptEl.textContent.trim());
        } catch (e) {
            console.error('❌ JSON 解析失敗:', e);
            return null;
        }
    }

    function openUnifiedModal(rowEl) {
        const data = getOrderData(rowEl);
        if (!data) return;

        window.currentOrderCanEdit = !!data.canEdit;
        window.currentOrderCanReassign = !!data.canReassign;
        window.currentOrderCanAdjustPrice = !!data.canAdjustPrice;
        window.currentOrderCanRefund = !!data.canRefund
            && !['cancelled', 'refunded'].includes(data.status)
            && (data.status !== 'completed' || !!data.canRefundCompleted);

        const form = document.getElementById('modalOrderEditForm');
        if (form) form.action = `/management/orders/update/${data.id}`;

        setText('detailOrderNo', data.orderNo);
        setText('detailCreatedAt', data.createdAt);
        setText('detailStatusAndCs', `${data.statusName || '進行中'} / ${data.csName || '米胡客服'}`);
        setText('detailCsInfo', data.csName ? `${data.csName} (@${data.csId || 'CS'})` : '米胡客服');
        setText('detailBossInfo', data.bossName ? `${data.bossName} (@${data.bossId})` : '--');
        setText('detailTalentInfo', data.talentId ? `${data.talentName} (@${data.talentId})` : '派單中 (尚未指派)');
        setText('detailExtra', (data.extra && data.extra.trim() !== '' && data.extra !== '無') ? data.extra : '無特別條件');

        setText('detailOriginalPrice', `$${Number(data.originalPrice || data.totalAmount).toLocaleString()}`);
        setText('detailDiscount', data.discount ? `-$${Number(data.discount).toLocaleString()}` : '$0');
        setText('detailTotalAmountText', `$${Number(data.totalAmount).toLocaleString()} NTD`);

        setVal('editCategory', data.category || '陪玩單');
        setVal('editGame', data.itemName);
        setVal('editContentTier', data.contentTier);
        setVal('editDuration', data.duration || 1);
        setVal('editUnit', data.unit || '小時');
        setVal('editTalentId', data.talentId || '');
        setVal('editOrderStatus', data.status || 'pending');
        setVal('editTalentMessage', data.talentMessage);
        setVal('editNote', data.note);

        if (typeof switchEditMode === 'function') {
            switchEditMode(false);
        }

        const modalEl = document.getElementById('orderDetailModal');
        if (modalEl) {
            const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('.order-row');
        const searchInput = document.getElementById('orderSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');
        const filterTabs = document.querySelectorAll('.filter-tab-btn');

        let currentFilter = 'all';

        function applyFilters() {
            const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesQuery = query === '' || searchData.includes(query);
                const matchesFilter = currentFilter === 'all' || rowStatus === currentFilter;

                if (matchesQuery && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                if (clearBtn) clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
                applyFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                applyFilters();
                searchInput.focus();
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                filterTabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                currentFilter = tab.getAttribute('data-filter');
                applyFilters();
            });
        });

        // 🚀 批量刪除勾選與預覽確認流程
        const checkAll = document.getElementById('checkAllOrders');
        const itemChecks = document.querySelectorAll('.order-checkbox');
        const batchBtn = document.getElementById('btnBatchDelete');
        const countSpan = document.getElementById('selectedCount');
        const batchForm = document.getElementById('batchDeleteForm');
        const previewModalEl = document.getElementById('batchDeletePreviewModal');
        const previewList = document.getElementById('batchPreviewList');
        const previewOrderCount = document.getElementById('previewOrderCount');
        const previewRefundTotal = document.getElementById('previewRefundTotal');
        const previewBlocking = document.getElementById('batchPreviewBlocking');
        const batchDeleteConfirmBtn = document.getElementById('btnBatchDeleteConfirm');
        const batchDeleteCancelBtn = document.getElementById('btnBatchDeleteCancel');
        const batchDeleteModal = previewModalEl ? bootstrap.Modal.getOrCreateInstance(previewModalEl) : null;

        let latestPreviewSelection = [];
        let isSubmittingBatchDelete = false;

        function notifyError(message) {
            const text = String(message || '操作失敗，請稍後再試。');
            if (window.MiHuFeedback && typeof window.MiHuFeedback.error === 'function') {
                window.MiHuFeedback.error(text);
            } else {
                alert(text);
            }
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function renderPreview(preview) {
            if (!previewList || !previewOrderCount || !previewRefundTotal || !previewBlocking || !batchDeleteConfirmBtn) return;

            previewList.innerHTML = '';
            previewOrderCount.textContent = String(preview.summary && preview.summary.count || 0);
            const totalRefund = Number(preview.summary && preview.summary.refundableTotal || 0);
            previewRefundTotal.textContent = `$${totalRefund.toLocaleString()} NTD`;

            (preview.items || []).forEach(item => {
                const wrapper = document.createElement('div');
                wrapper.className = 'preview-item';
                const refundText = `$${Number(item.refundableAmount || 0).toLocaleString()} NTD`;
                const deleteModeText = Number(item.refundableAmount || 0) > 0
                    ? '本次退款'
                    : '僅刪除 (已退款/免退款)';
                wrapper.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">${escapeHtml(item.orderNo)}</div>
                        <div class="text-success">${deleteModeText}：${refundText}</div>
                    </div>
                    <div class="small text-secondary">狀態：${escapeHtml(item.status || '--')}</div>
                `;
                if (Array.isArray(item.reasons) && item.reasons.length) {
                    item.reasons.forEach(reason => {
                        const reasonNode = document.createElement('div');
                        reasonNode.className = 'preview-reason';
                        reasonNode.textContent = `- ${reason}`;
                        wrapper.appendChild(reasonNode);
                    });
                }
                previewList.appendChild(wrapper);
            });

            const blockingRows = Array.isArray(preview.summary && preview.summary.blocking)
                ? preview.summary.blocking
                : [];
            if (blockingRows.length > 0) {
                previewBlocking.style.display = 'block';
                previewBlocking.innerHTML = blockingRows.map(row => {
                    const reasons = Array.isArray(row.reasons) ? row.reasons.join('；') : '';
                    return `<div>【${escapeHtml(row.orderRef)}】${escapeHtml(reasons)}</div>`;
                }).join('');
                batchDeleteConfirmBtn.disabled = true;
            } else {
                previewBlocking.style.display = 'none';
                previewBlocking.textContent = '';
                batchDeleteConfirmBtn.disabled = false;
            }
        }

        async function requestBatchPreview(selectedIds) {
            const csrfInput = document.getElementById('batchDeleteCsrfToken');
            const csrfToken = csrfInput ? String(csrfInput.value || '').trim() : '';
            if (!csrfToken) {
                notifyError('操作憑證已失效，請重新整理頁面後再試一次。');
                return null;
            }

            const body = new URLSearchParams();
            body.set('_csrf', csrfToken);
            selectedIds.forEach(id => body.append('order_ids', id));

            const response = await fetch('/management/orders/batch-delete/preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    Accept: 'application/json'
                },
                body: body.toString(),
                credentials: 'same-origin'
            });

            let payload = null;
            try {
                payload = await response.json();
            } catch (error) {
                payload = null;
            }

            if (!response.ok || !payload || payload.success !== true) {
                const errMsg = payload && payload.error ? String(payload.error) : '批量刪除預覽失敗，請稍後再試。';
                if (response.status === 403 && /csrf/i.test(errMsg)) {
                    notifyError('工作階段或安全憑證已失效，請重新整理頁面後再試一次。');
                    return null;
                }
                notifyError(errMsg);
                return null;
            }

            return payload.preview;
        }

        async function submitBatchDelete() {
            if (isSubmittingBatchDelete || !latestPreviewSelection.length || !batchForm) return;
            isSubmittingBatchDelete = true;
            if (batchBtn) batchBtn.disabled = true;
            if (batchDeleteConfirmBtn) batchDeleteConfirmBtn.disabled = true;
            if (batchDeleteCancelBtn) batchDeleteCancelBtn.disabled = true;

            try {
                const csrfInput = document.getElementById('batchDeleteCsrfToken');
                const csrfToken = csrfInput ? String(csrfInput.value || '').trim() : '';
                if (!csrfToken) {
                    notifyError('操作憑證已失效，請重新整理頁面後再試一次。');
                    return;
                }

                const body = new URLSearchParams();
                body.set('_csrf', csrfToken);
                latestPreviewSelection.forEach(id => body.append('order_ids', id));

                const response = await fetch(batchForm.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        Accept: 'application/json'
                    },
                    body: body.toString(),
                    credentials: 'same-origin'
                });

                let payload = null;
                try {
                    payload = await response.json();
                } catch (error) {
                    payload = null;
                }

                if (!response.ok || !payload || payload.success !== true) {
                    const errMsg = payload && payload.error ? String(payload.error) : '批量刪除失敗，請稍後再試。';
                    if (response.status === 403 && /csrf/i.test(errMsg)) {
                        notifyError('工作階段或安全憑證已失效，請重新整理頁面後再試一次。');
                        return;
                    }
                    notifyError(errMsg);
                    return;
                }

                window.location.assign(payload.redirect || '/management/orders');
            } catch (error) {
                notifyError('網路異常，請稍後再試。');
            } finally {
                isSubmittingBatchDelete = false;
                if (batchBtn) batchBtn.disabled = false;
                if (batchDeleteCancelBtn) batchDeleteCancelBtn.disabled = false;
                if (batchDeleteConfirmBtn) batchDeleteConfirmBtn.disabled = false;
            }
        }

        function updateBatchButton() {
            const checkedBoxes = document.querySelectorAll('.order-checkbox:checked');
            const count = checkedBoxes.length;

            if (countSpan) countSpan.textContent = count;
            if (batchBtn) batchBtn.disabled = count === 0;
        }

        if (checkAll) {
            checkAll.addEventListener('change', () => {
                const visibleCheckboxes = document.querySelectorAll('.order-row:not([style*="display: none"]) .order-checkbox');
                visibleCheckboxes.forEach(cb => cb.checked = checkAll.checked);
                updateBatchButton();
            });
        }

        itemChecks.forEach(cb => {
            cb.addEventListener('change', () => {
                updateBatchButton();
                if (checkAll && !cb.checked) checkAll.checked = false;
            });
        });

        if (batchBtn && batchForm) {
            batchBtn.addEventListener('click', async () => {
                const checkedBoxes = document.querySelectorAll('.order-checkbox:checked');
                if (checkedBoxes.length === 0) {
                    notifyError('請至少勾選一筆訂單再進行批量刪除。');
                    return;
                }

                const selectedIds = [...checkedBoxes].map(cb => String(cb.value || '').trim()).filter(Boolean);
                latestPreviewSelection = selectedIds;
                const preview = await requestBatchPreview(selectedIds);
                if (!preview) return;

                renderPreview(preview);
                if (batchDeleteModal) {
                    batchDeleteModal.show();
                    setTimeout(() => {
                        if (batchDeleteConfirmBtn && !batchDeleteConfirmBtn.disabled) {
                            batchDeleteConfirmBtn.focus();
                        } else if (batchDeleteCancelBtn) {
                            batchDeleteCancelBtn.focus();
                        }
                    }, 80);
                }
            });
        }

        updateBatchButton();

        if (batchDeleteConfirmBtn) {
            batchDeleteConfirmBtn.addEventListener('click', submitBatchDelete);
        }

        if (previewModalEl) {
            previewModalEl.addEventListener('keydown', event => {
                if (event.key === 'Enter' && batchDeleteConfirmBtn && !batchDeleteConfirmBtn.disabled) {
                    event.preventDefault();
                    submitBatchDelete();
                }
            });
        }
    });
</script>
</body>
</html>
