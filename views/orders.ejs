<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>訂單管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 24px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .filter-tabs {
            display: flex;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 4px;
            border-radius: 14px;
            flex-wrap: wrap;
        }
        .filter-tab-btn {
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 0.84rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 10px;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .filter-tab-btn:hover { color: #fff; }
        .filter-tab-btn.active {
            background: rgba(168, 85, 247, 0.25);
            color: #fff;
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.25);
        }

        .search-box-wrap { position: relative; width: 280px; flex-shrink: 0; }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
        }
        .search-icon-left { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.88rem; }
        .search-clear-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; display: none; border: none; background: transparent; }

        .btn-batch-delete {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.84rem;
            border-radius: 20px;
            padding: 6px 16px;
            border: 1px solid rgba(239, 68, 68, 0.5);
            box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-batch-delete:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            box-shadow: 0 6px 18px rgba(239, 68, 68, 0.5);
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

<% 
    const activeCurrUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : ((typeof user !== 'undefined' && user) ? user : {});
    const currRole = String(activeCurrUser.role || '').toLowerCase();
    const isOwnerAdmin = ['admin', 'owner'].includes(currRole);
%>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'orders' }) %>

        <div class="content-body">
            <div class="page-header-content">
                <div>
                    <div class="h4 fw-bold text-white mb-1">
                        <i class="fa-solid fa-list-check text-pink me-2" style="color: #ec4899;"></i>工作室訂單管理
                    </div>
                    <p class="text-secondary small mb-0">即時監控與核算工作室訂單收益 (點擊任意訂單列即可檢視詳情或進行編輯)</p>
                </div>

                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="orderSearchInput" class="search-input-glass" placeholder="搜尋單號 / 客服 / 闆闆 / 陪陪 / 類別 / 項目...">
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
                </div>
            </div>

            <!-- 🚀 3. 狀態標籤篩選器 & 店長專屬批量刪除隱藏 Form -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="filter-tabs">
                    <button type="button" class="filter-tab-btn active" data-filter="all">全部訂單 (<%= orders ? orders.length : 0 %>)</button>
                    <button type="button" class="filter-tab-btn" data-filter="pending">派單中</button>
                    <button type="button" class="filter-tab-btn" data-filter="active">進行中</button>
                    <button type="button" class="filter-tab-btn" data-filter="completed">已完成</button>
                    <button type="button" class="filter-tab-btn" data-filter="cancelled">售後中</button>
                    <button type="button" class="filter-tab-btn" data-filter="rejected">已駁回</button>
                </div>

                <% if (isOwnerAdmin) { %>
                    <!-- 🚀 店長專用表單：點擊時以原生 Form 提交，不使用抓取 json -->
                    <form id="batchDeleteForm" action="/management/orders/batch-delete" method="POST" style="margin: 0;">
                        <div id="batchInputsContainer"></div>
                        <button type="button" class="btn-batch-delete" id="btnBatchDelete" style="display: none;">
                            <i class="fa-solid fa-trash-can"></i>
                            <span>批量刪除 (<span id="selectedCount">0</span>)</span>
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success py-2 px-3 small mb-3 border-0 bg-success bg-opacity-25 text-success">
                    ✅ 訂單狀態與資料已成功更新！
                </div>
            <% } %>

            <% if (typeof successMsg !== 'undefined' && successMsg) { %>
                <div class="alert alert-success py-2 px-3 small mb-3 border-0 bg-success bg-opacity-25 text-success">
                    ✅ <%= successMsg %>
                </div>
            <% } %>

            <!-- 📊 4. 獨立模組：訂單清單表格卡片 -->
            <%- include('partials/orders_table', { 
                orders: typeof orders !== 'undefined' ? orders : [], 
                currentUser: activeCurrUser, 
                userPerms: typeof userPerms !== 'undefined' ? userPerms : [],
                isOwnerAdmin: isOwnerAdmin 
            }) %>
        </div>
    </div>
</div>

<%- include('modals/order_detail_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function setVal(id, val) {
        const el = document.getElementById(id);
        if (el) el.value = (val !== undefined && val !== null) ? val : '';
    }
    function setText(id, txt) {
        const el = document.getElementById(id);
        if (el) el.textContent = (txt !== undefined && txt !== null) ? txt : '--';
    }

    function getOrderData(rowEl) {
        if (!rowEl) return null;
        const scriptEl = rowEl.querySelector('.order-data-json');
        if (!scriptEl) return null;
        try {
            return JSON.parse(scriptEl.textContent.trim());
        } catch (e) {
            console.error('❌ JSON 解析失敗:', e);
            return null;
        }
    }

    function openUnifiedModal(rowEl) {
        const data = getOrderData(rowEl);
        if (!data) return;

        window.currentOrderCanEdit = !!data.canEdit;

        const form = document.getElementById('modalOrderEditForm');
        if (form) form.action = `/management/orders/update/${data.id}`;

        setText('detailOrderNo', data.orderNo);
        setText('detailCreatedAt', data.createdAt);
        setText('detailStatusAndCs', `${data.statusName || '進行中'} / ${data.csName || '米胡客服'}`);
        setText('detailCsInfo', data.csName ? `${data.csName} (@${data.csId || 'CS'})` : '米胡客服');
        setText('detailBossInfo', data.bossName ? `${data.bossName} (@${data.bossId})` : '--');
        setText('detailTalentInfo', data.talentId ? `${data.talentName} (@${data.talentId})` : '派單中 (尚未指派)');
        setText('detailExtra', (data.extra && data.extra.trim() !== '' && data.extra !== '無') ? data.extra : '無特別條件');

        setText('detailOriginalPrice', `$${Number(data.originalPrice || data.totalAmount).toLocaleString()}`);
        setText('detailDiscount', data.discount ? `-$${Number(data.discount).toLocaleString()}` : '$0');
        setText('detailTotalAmountText', `$${Number(data.totalAmount).toLocaleString()} NTD`);

        setVal('editCategory', data.category || '陪玩單');
        setVal('editGame', data.itemName);
        setVal('editContentTier', data.contentTier);
        setVal('editDuration', data.duration || 1);
        setVal('editUnit', data.unit || '小時');
        setVal('editOrderStatus', data.status || 'pending');
        setVal('editTalentMessage', data.talentMessage);
        setVal('editNote', data.note);

        if (typeof switchEditMode === 'function') {
            switchEditMode(false);
        }

        const modalEl = document.getElementById('orderDetailModal');
        if (modalEl) {
            const instance = bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('.order-row');
        const searchInput = document.getElementById('orderSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');
        const filterTabs = document.querySelectorAll('.filter-tab-btn');

        let currentFilter = 'all';

        function applyFilters() {
            const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesQuery = query === '' || searchData.includes(query);
                const matchesFilter = currentFilter === 'all' || rowStatus === currentFilter;

                if (matchesQuery && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                if (clearBtn) clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
                applyFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                applyFilters();
                searchInput.focus();
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                filterTabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                currentFilter = tab.getAttribute('data-filter');
                applyFilters();
            });
        });

        // 🚀 批量刪除勾選連動 (以Form提交, 完全不觸發抓取JSON問題)
        const checkAll = document.getElementById('checkAllOrders');
        const itemChecks = document.querySelectorAll('.order-checkbox');
        const batchBtn = document.getElementById('btnBatchDelete');
        const countSpan = document.getElementById('selectedCount');
        const batchForm = document.getElementById('batchDeleteForm');
        const inputsContainer = document.getElementById('batchInputsContainer');

        function updateBatchButton() {
            const checkedBoxes = document.querySelectorAll('.order-checkbox:checked');
            const count = checkedBoxes.length;

            if (countSpan) countSpan.textContent = count;
            if (batchBtn) batchBtn.style.display = count > 0 ? 'inline-flex' : 'none';
        }

        if (checkAll) {
            checkAll.addEventListener('change', () => {
                const visibleCheckboxes = document.querySelectorAll('.order-row:not([style*="display: none"]) .order-checkbox');
                visibleCheckboxes.forEach(cb => cb.checked = checkAll.checked);
                updateBatchButton();
            });
        }

        itemChecks.forEach(cb => {
            cb.addEventListener('change', () => {
                updateBatchButton();
                if (checkAll && !cb.checked) checkAll.checked = false;
            });
        });

        if (batchBtn && batchForm) {
            batchBtn.addEventListener('click', () => {
                const checkedBoxes = document.querySelectorAll('.order-checkbox:checked');
                if (checkedBoxes.length === 0) return;

                if (!confirm(`⚠️ 確定要刪除勾選的 ${checkedBoxes.length} 筆訂單嗎？`)) {
                    return;
                }

                // 動態產生 hidden input 提交給後端
                if (inputsContainer) {
                    inputsContainer.innerHTML = '';
                    checkedBoxes.forEach(cb => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'order_ids';
                        input.value = cb.value;
                        inputsContainer.appendChild(input);
                    });
                }

                batchForm.submit();
            });
        }
    });
</script>
</body>
</html>