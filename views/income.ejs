<body>

<%- include('partials/sidebar', { activePage: 'income' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'income' }) %>

    <div class="content-body admin-page-content">
        <%- include('partials/admin_page_header', { icon: 'fa-sack-dollar', title: '我的收入與接單分潤', description: '即時掌握個人接單歷史累積分潤、當月結算收入與可提領薪資 (分潤依原價計算，不承擔折扣)' }) %>

        <!-- 🚀 1. 載入獨立模組：四大金流卡片 -->
        <%- include('partials/income_stat_cards') %>

        <% const minimumWithdrawalAmount = Number(payoutOverview.settings.minimumAmount); %>
        <% const withdrawalGate = payoutOverview.withdrawalGate || { allowed: false, reasons: [] }; %>
        <% const withdrawalReasons = Array.isArray(withdrawalGate.reasons) ? withdrawalGate.reasons : []; %>
        <section class="withdrawal-card-shell" aria-labelledby="withdrawalCardTitle">
            <div class="withdrawal-card-header">
                <div class="withdrawal-card-heading">
                    <h5 class="text-white" id="withdrawalCardTitle"><i class="fa-solid fa-building-columns text-info me-2"></i>薪資提款</h5>
                </div>
                <div class="withdrawal-card-actions">
                    <button type="button" class="withdrawal-card-info-btn" id="showWithdrawalTerms"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>提款須知</button>
                    <button type="button" class="withdrawal-card-apply-btn" id="beginWithdrawalFlow"
                        data-window-open="<%= payoutOverview.windowOpen ? 'true' : 'false' %>"
                        data-bank-ready="<%= payoutOverview.bankDetailsReady ? 'true' : 'false' %>"
                        data-available="<%= Number(payoutOverview.availableAmount) %>"
                        data-minimum="<%= minimumWithdrawalAmount %>"
                        data-gate-allowed="<%= withdrawalGate.allowed ? 'true' : 'false' %>"
                        data-gate-reasons="<%- JSON.stringify(withdrawalReasons) %>"
                        data-refresh-url="/api/withdrawals"
                        data-profile-url="/profile"
                        data-timezone="<%= payoutOverview.settings.timeZone %>"
                        aria-disabled="<%= withdrawalGate.allowed ? 'false' : 'true' %>">
                        <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>申請提款
                    </button>
                </div>
            </div>
            <div class="withdrawal-card-metrics">
                <span class="withdrawal-card-status" id="withdrawalWindowStatusBadge"><i class="fa-solid <%= payoutOverview.windowOpen ? 'fa-circle-check' : 'fa-circle-xmark' %>" aria-hidden="true"></i>提領狀態：<%= payoutOverview.windowOpen ? '開放中' : '未開放' %></span>
                <span class="withdrawal-pending-badge"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>撥款中：$<%= Number(payoutOverview.pendingAmount).toLocaleString() %> NTD</span>
                <span class="withdrawal-card-period"><i class="fa-regular fa-calendar" aria-hidden="true"></i>申請期間：每月 <%= payoutOverview.settings.startDay %> 日 ~ <%= payoutOverview.settings.endDay %> 日（<%= payoutOverview.settings.timeZone %>）</span>
                <span class="withdrawal-card-period" id="withdrawalNowLabel"><i class="fa-regular fa-clock" aria-hidden="true"></i>台北現在：<%= payoutOverview.timeline && payoutOverview.timeline.now ? payoutOverview.timeline.now : '-' %></span>
                <span class="withdrawal-card-period" id="withdrawalNextOpenLabel"><i class="fa-solid fa-door-open" aria-hidden="true"></i>下次開放：<%= payoutOverview.timeline && payoutOverview.timeline.nextOpenAt ? payoutOverview.timeline.nextOpenAt : '-' %></span>
            </div>
            <div class="withdrawal-card-notes">
                <p class="withdrawal-card-note">• 最低申請金額 $<%= minimumWithdrawalAmount.toLocaleString() %> · <%= payoutOverview.bankDetailsReady ? '薪轉帳戶已設定' : '薪轉帳戶尚未設定' %></p>
                <p class="withdrawal-card-note">• 非玉山銀行 (808) 帳戶設為薪轉，可能會需要負擔跨行轉帳手續費。</p>
            </div>
            <div class="withdrawal-card-notes mt-2" id="withdrawalGateNotice" aria-live="polite">
                <% if (withdrawalReasons.length) { %>
                    <% withdrawalReasons.forEach(reason => { %>
                        <p class="withdrawal-card-note" data-gate-item="true">• <%= reason.message %>
                            <% if (reason.actionUrl) { %>
                                <a href="<%= reason.actionUrl %>" class="ms-1 text-info text-decoration-underline"><%= reason.actionText || '前往設定' %></a>
                            <% } %>
                        </p>
                    <% }) %>
                <% } else { %>
                    <p class="withdrawal-card-note" data-gate-item="true">• 目前符合提款申請條件，可繼續下一步確認金額。</p>
                <% } %>
                <p class="withdrawal-card-note text-danger" id="withdrawalFrontendError" hidden></p>
            </div>
            <% if (payoutOverview.payouts.length) { %>
                <div class="table-responsive mt-3">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr><th>申請編號</th><th>申請時間</th><th class="text-end">金額</th><th>狀態</th><th>薪轉帳戶</th><th>退回原因</th></tr></thead>
                        <tbody>
                            <% payoutOverview.payouts.forEach(payout => { %>
                                <tr>
                                    <td><%= payout.withdrawal_no || `#${payout.id}` %></td>
                                    <td><%= payout.requested_at || '-' %></td>
                                    <td class="text-end">$<%= Number(payout.amount).toLocaleString() %></td>
                                    <td><%= payout.status === 'pending' ? '撥款中' : payout.status === 'paid' ? '已撥款' : payout.status === 'rejected' ? '已退回' : '歷史紀錄' %></td>
                                    <td><%= payout.bank_name || '-' %> · <%= payout.account_name_masked || '-' %> · <%= payout.bank_account_masked || '-' %></td>
                                    <td><%= payout.rejected_reason || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-secondary small mb-0 mt-3">尚無提款申請紀錄</p>
            <% } %>
        </section>

        <section class="income-summary-shell" aria-labelledby="incomeSummaryTitle">
            <div class="income-summary-header">
                <div>
                    <h5 class="text-white mb-1" id="incomeSummaryTitle"><i class="fa-solid fa-chart-column text-warning me-2"></i>薪資與分潤明細</h5>
                    <p class="income-summary-sub">明細、分類統計與分頁已整合到同一個薪資明細視窗。</p>
                </div>
                <div class="income-summary-actions">
                    <button type="button" class="btn income-ledger-open-btn px-3 py-2 small fw-semibold" data-bs-toggle="modal" data-bs-target="#incomeLedgerModal" id="openIncomeLedgerButton">
                        <i class="fa-solid fa-file-invoice-dollar me-1"></i>
                        <span>薪資與分潤明細</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 🚀 2. 我的接單管理中心 -->
        <div class="p-4 rounded-4 d-flex justify-content-between align-items-center flex-wrap gap-3" style="background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <div>
                <h5 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-list-check text-primary"></i>我的接單管理中心
                </h5>
                <p class="text-secondary small mb-0">依自訂日期區間與訂單狀態過濾工單，即時核算每筆單的分潤金額</p>
            </div>

            <!-- 右側操作按鈕群 (支援主動點擊相容性) -->
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-income-info" data-bs-toggle="modal" data-bs-target="#commissionRatesModal">
                    <i class="fa-solid fa-circle-info text-info"></i>
                    <span>當前分潤成數表</span>
                </button>

                <button type="button" class="btn btn-income-orders" data-bs-toggle="modal" data-bs-target="#ordersHistoryModal">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>開啟我的接單清單</span>
                    <span class="orders-count-badge"><%= orders ? orders.length : 0 %></span>
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/income_withdrawal_modal', { payoutOverview: payoutOverview }) %>
<%- include('modals/withdrawal_terms_modal', { settings: payoutOverview.settings }) %>
<%- include('partials/income_salary_detail_modal', {
    incomeDetail: incomeDetail || null,
    incomeMonthlySummary: incomeMonthlySummary || null,
    incomeSummaryMonth: incomeSummaryMonth || '',
    openIncomeDetailModal: openIncomeDetailModal === true
}) %>
<%- include('modals/income_category_detail_modal') %>

<!-- 🚀 3. 載入獨立模組：分潤成數彈窗 -->
<%- include('partials/income_commission_modal') %>

<!-- 🚀 4. 載入獨立模組：獨立【我的接單】彈窗 -->
<%- include('partials/income_orders_modal') %>

<!-- 🚀 5. 載入獨立模組：單筆工單詳情彈窗 -->
<%- include('partials/income_detail_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const shouldOpenIncomeDetailModal = <%= openIncomeDetailModal === true ? 'true' : 'false' %>;
    (() => {
        const termsModalEl = document.getElementById('withdrawalTermsModal');
        const amountModalEl = document.getElementById('withdrawalRequestModal');
        const termsButton = document.getElementById('showWithdrawalTerms');
        const applyButton = document.getElementById('beginWithdrawalFlow');
        const continueButton = document.getElementById('withdrawalTermsContinue');
        const frontendError = document.getElementById('withdrawalFrontendError');
        const gateNotice = document.getElementById('withdrawalGateNotice');
        const statusBadge = document.getElementById('withdrawalWindowStatusBadge');
        const nowLabel = document.getElementById('withdrawalNowLabel');
        const nextOpenLabel = document.getElementById('withdrawalNextOpenLabel');
        const amountInput = document.getElementById('withdrawalAmount');

        function showFrontendError(message) {
            if (!frontendError) return;
            frontendError.hidden = false;
            frontendError.textContent = message;
        }

        function clearFrontendError() {
            if (!frontendError) return;
            frontendError.hidden = true;
            frontendError.textContent = '';
        }

        if (!termsModalEl || !amountModalEl || !termsButton || !applyButton || !continueButton || !window.bootstrap?.Modal) {
            showFrontendError('提款按鈕前端載入不完整，請重新整理；若持續發生請聯絡管理員。');
            return;
        }

        const termsModal = bootstrap.Modal.getOrCreateInstance(termsModalEl);
        const amountModal = bootstrap.Modal.getOrCreateInstance(amountModalEl);
        let flowContext = 'READ_ONLY';
        let transitionPending = false;
        let continueToAmount = false;

        function parseGateReasons() {
            try {
                const reasons = JSON.parse(applyButton.dataset.gateReasons || '[]');
                return Array.isArray(reasons) ? reasons : [];
            } catch {
                return [];
            }
        }

        function renderGateReasons(reasons) {
            if (!gateNotice) return;
            gateNotice.querySelectorAll('[data-gate-item="true"]').forEach(node => node.remove());

            const items = Array.isArray(reasons) ? reasons : [];
            if (!items.length) {
                const ok = document.createElement('p');
                ok.className = 'withdrawal-card-note';
                ok.dataset.gateItem = 'true';
                ok.textContent = '• 目前符合提款申請條件，可繼續下一步確認金額。';
                gateNotice.insertBefore(ok, frontendError || null);
                return;
            }

            for (const reason of items) {
                const line = document.createElement('p');
                line.className = 'withdrawal-card-note';
                line.dataset.gateItem = 'true';
                line.textContent = `• ${reason && reason.message ? reason.message : '目前不符合提款條件'}`;
                if (reason && reason.actionUrl) {
                    const link = document.createElement('a');
                    link.href = reason.actionUrl;
                    link.className = 'ms-1 text-info text-decoration-underline';
                    link.textContent = reason.actionText || '前往設定';
                    line.appendChild(link);
                }
                gateNotice.insertBefore(line, frontendError || null);
            }
        }

        function syncApplyStateFromOverview(overview) {
            if (!overview || typeof overview !== 'object') return;
            const gate = overview.withdrawalGate || { allowed: false, reasons: [] };
            const allowed = gate.allowed === true;
            applyButton.dataset.windowOpen = overview.windowOpen ? 'true' : 'false';
            applyButton.dataset.bankReady = overview.bankDetailsReady ? 'true' : 'false';
            applyButton.dataset.available = String(Number(overview.availableAmount || 0));
            applyButton.dataset.minimum = String(Number(overview.settings && overview.settings.minimumAmount || 0));
            applyButton.dataset.gateAllowed = allowed ? 'true' : 'false';
            applyButton.dataset.gateReasons = JSON.stringify(Array.isArray(gate.reasons) ? gate.reasons : []);
            applyButton.setAttribute('aria-disabled', allowed ? 'false' : 'true');
            if (amountInput) {
                amountInput.max = String(Number(overview.availableAmount || 0));
                amountInput.min = String(Number(overview.settings && overview.settings.minimumAmount || 0));
            }

            if (statusBadge) {
                statusBadge.innerHTML = `<i class="fa-solid ${overview.windowOpen ? 'fa-circle-check' : 'fa-circle-xmark'}" aria-hidden="true"></i>提領狀態：${overview.windowOpen ? '開放中' : '未開放'}`;
            }
            if (nowLabel) {
                nowLabel.innerHTML = `<i class="fa-regular fa-clock" aria-hidden="true"></i>台北現在：${overview.timeline && overview.timeline.now ? overview.timeline.now : '-'}`;
            }
            if (nextOpenLabel) {
                nextOpenLabel.innerHTML = `<i class="fa-solid fa-door-open" aria-hidden="true"></i>下次開放：${overview.timeline && overview.timeline.nextOpenAt ? overview.timeline.nextOpenAt : '-'}`;
            }
            renderGateReasons(gate.reasons || []);
        }

        function renderGateReasonFallback() {
            const reasons = parseGateReasons();
            if (!reasons.length) return;
            showFrontendError(reasons.map(item => `• ${item.message}`).join(' '));
        }

        function openTerms(context) {
            if (transitionPending || termsModalEl.classList.contains('show') || amountModalEl.classList.contains('show')) return;
            flowContext = context;
            termsModalEl.dataset.flowContext = context;
            continueButton.hidden = context !== 'WITHDRAWAL_GATE';
            termsModal.show();
        }

        termsButton.addEventListener('click', () => openTerms('READ_ONLY'));
        applyButton.addEventListener('click', () => {
            clearFrontendError();
            if (transitionPending) return;
            const canRequest = applyButton.dataset.windowOpen === 'true'
                && applyButton.dataset.bankReady === 'true'
                && Number(applyButton.dataset.available) >= Number(applyButton.dataset.minimum);
            if (!canRequest || applyButton.dataset.gateAllowed !== 'true') {
                renderGateReasonFallback();
                return;
            }
            openTerms('WITHDRAWAL_GATE');
        });

        termsModalEl.addEventListener('hidden.bs.modal', () => {
            transitionPending = false;
            const shouldOpenAmount = continueToAmount && flowContext === 'WITHDRAWAL_GATE';
            continueToAmount = false;
            flowContext = 'READ_ONLY';
            termsModalEl.dataset.flowContext = flowContext;
            continueButton.hidden = true;
            if (shouldOpenAmount) amountModal.show();
        });

        continueButton.addEventListener('click', () => {
            if (flowContext !== 'WITHDRAWAL_GATE' || transitionPending) return;
            transitionPending = true;
            continueToAmount = true;
            termsModal.hide();
        });

        window.addEventListener('error', event => {
            const message = event && event.message ? `提款功能腳本發生錯誤：${event.message}` : '提款功能腳本發生錯誤。';
            showFrontendError(message);
        });

        const refreshUrl = applyButton.dataset.refreshUrl;
        async function refreshWithdrawalOverview() {
            if (!refreshUrl) return;
            try {
                const response = await fetch(refreshUrl, {
                    method: 'GET',
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin'
                });
                if (!response.ok) return;
                const payload = await response.json();
                if (!payload || payload.success !== true || !payload.overview) return;
                syncApplyStateFromOverview(payload.overview);
            } catch {
                // 前端定時同步失敗時保持目前畫面，後端送出時仍會再次核對
            }
        }

        setInterval(refreshWithdrawalOverview, 60 * 1000);
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') refreshWithdrawalOverview();
        });
    })();

    let withdrawalSubmitting = false;
    const submitWithdrawalButton = document.getElementById('submitWithdrawalRequest');
    const originalSubmitMarkup = submitWithdrawalButton ? submitWithdrawalButton.innerHTML : '';

    submitWithdrawalButton?.addEventListener('click', async () => {
        if (withdrawalSubmitting) return;
        const amountInput = document.getElementById('withdrawalAmount');
        const errorBox = document.getElementById('withdrawalRequestError');
        const amount = Number(amountInput.value);
        if (!amountInput.checkValidity()) {
            amountInput.reportValidity();
            return;
        }
        if (!window.confirm(`確定申請提款 $${amount.toLocaleString()}？申請後無法自行取消。`)) return;
        withdrawalSubmitting = true;
        submitWithdrawalButton.disabled = true;
        submitWithdrawalButton.textContent = '處理中...';
        errorBox.textContent = '';
        try {
            const response = await fetch('/api/withdrawals/request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
                body: JSON.stringify({ amount })
            });
            const result = await response.json();
            if (window.MiHuFeedback?.isPermissionDeniedResponse(response)) {
                withdrawalSubmitting = false;
                submitWithdrawalButton.disabled = false;
                submitWithdrawalButton.innerHTML = originalSubmitMarkup;
                return;
            }
            if (!response.ok || !result.success) throw new Error(result.message || '提款申請失敗');
            window.location.reload();
        } catch (error) {
            errorBox.textContent = error.message;
            withdrawalSubmitting = false;
            submitWithdrawalButton.disabled = false;
            submitWithdrawalButton.innerHTML = originalSubmitMarkup;
        }
    });

    // 🚀 安全開啟 Modal 函式 (防範 bootstrap backdrop 報錯)
    function safeShowModal(modalId) {
        const modalEl = document.getElementById(modalId);
        if (!modalEl) {
            console.warn(`⚠️ 找不到 Modal 元素 #${modalId}，請確認 Partials 是否正確引入！`);
            return;
        }

        try {
            // 優先使用 Bootstrap 5 官方 Instance
            if (window.bootstrap && window.bootstrap.Modal) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
                    backdrop: true,
                    keyboard: true,
                    focus: true
                });
                modal.show();
            } else {
                // 備用防護：若 Bootstrap JS 加載異常，手動顯示
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                document.body.classList.add('modal-open');
            }
        } catch (err) {
            console.error(`❌ 開啟 Modal #${modalId} 失敗:`, err);
        }
    }

    const orderDetailFlowState = {
        returnToOrders: false,
        triggerEl: null
    };

    // 🚀 單筆工單詳情顯示
    function showOrderIncomeDetail(data, triggerEl = null) {
        if (!data) return;

        const setElText = (id, text) => {
            const el = document.getElementById(id);
            if (el) el.textContent = text;
        };

        setElText('detailOrderNo', data.orderNo || '--');
        setElText('detailStatus', data.statusName || '--');
        setElText('detailBoss', data.bossName || '--');
        setElText('detailGameAndDuration', `${data.game || '一般服務'} (${data.duration || 1}${data.unit || 'h'} / ${data.headcount || 1}人)`);
        setElText('detailTotalAmount', `$${Number(data.totalAmount || 0).toLocaleString()} NTD`);
        setElText('detailMyIncome', (data.myIncome && data.myIncome > 0) ? `+$${Number(data.myIncome).toLocaleString()} NTD` : '$0 NTD (未入帳)');
        setElText('detailStartTime', data.startTime || '尚未開始');
        setElText('detailEndTime', data.endTime || '尚未結束');
        setElText('detailNote', data.note || '無特別備註');

        const ordersModalEl = document.getElementById('ordersHistoryModal');
        const detailModalEl = document.getElementById('incomeDetailModal');
        const canSwitchSingleModal = Boolean(
            window.bootstrap?.Modal
            && ordersModalEl
            && detailModalEl
            && ordersModalEl.classList.contains('show')
        );

        if (!canSwitchSingleModal) {
            safeShowModal('incomeDetailModal');
            return;
        }

        orderDetailFlowState.returnToOrders = true;
        orderDetailFlowState.triggerEl = triggerEl;

        const ordersModal = bootstrap.Modal.getOrCreateInstance(ordersModalEl, {
            backdrop: true,
            keyboard: true,
            focus: true
        });
        const detailModal = bootstrap.Modal.getOrCreateInstance(detailModalEl, {
            backdrop: true,
            keyboard: true,
            focus: true
        });

        const handleOrdersHidden = () => {
            detailModal.show();
        };
        ordersModalEl.addEventListener('hidden.bs.modal', handleOrdersHidden, { once: true });
        ordersModal.hide();
    }

    document.addEventListener('DOMContentLoaded', () => {
        // 🚀 1. 手動綁定按鈕點擊事件 (安全觸發，不依賴可能失敗的 data-bs-toggle)
        const btnCommission = document.querySelector('.btn-income-info');
        const btnOrders = document.querySelector('.btn-income-orders');
        const btnIncomeLedger = document.getElementById('openIncomeLedgerButton');

        if (btnCommission) {
            btnCommission.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('commissionRatesModal');
            });
        }

        if (btnOrders) {
            btnOrders.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('ordersHistoryModal');
            });
        }

        if (btnIncomeLedger) {
            btnIncomeLedger.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('incomeLedgerModal');
            });
        }

        const ordersModalEl = document.getElementById('ordersHistoryModal');
        const detailModalEl = document.getElementById('incomeDetailModal');
        if (ordersModalEl && detailModalEl && window.bootstrap?.Modal) {
            const ordersModal = bootstrap.Modal.getOrCreateInstance(ordersModalEl, {
                backdrop: true,
                keyboard: true,
                focus: true
            });

            detailModalEl.addEventListener('hidden.bs.modal', () => {
                if (!orderDetailFlowState.returnToOrders) return;

                const focusTarget = orderDetailFlowState.triggerEl;
                orderDetailFlowState.returnToOrders = false;
                orderDetailFlowState.triggerEl = null;

                ordersModalEl.addEventListener('shown.bs.modal', () => {
                    window.setTimeout(() => {
                        if (focusTarget && typeof focusTarget.focus === 'function') {
                            focusTarget.focus();
                            if (document.activeElement === focusTarget) return;
                        }
                        const fallbackTrigger = ordersModalEl.querySelector('.btn-detail-trigger');
                        if (fallbackTrigger && typeof fallbackTrigger.focus === 'function') {
                            fallbackTrigger.focus();
                        }
                    }, 120);
                }, { once: true });

                ordersModal.show();
            });
        }

        const incomeLedgerFilterForm = document.querySelector('#incomeLedgerModal [data-income-ledger-filter-form="true"]');
        const incomeLedgerUpdateButton = document.querySelector('#incomeLedgerModal [data-income-ledger-update-button="true"]');
        const incomeLedgerLoadingState = document.getElementById('incomeLedgerLoadingState');
        if (incomeLedgerFilterForm && incomeLedgerUpdateButton) {
            let incomeLedgerSubmitting = false;
            incomeLedgerFilterForm.addEventListener('submit', event => {
                if (incomeLedgerSubmitting) {
                    event.preventDefault();
                    return;
                }
                if (ledgerSummaryMonthHidden && summaryMonthInput) {
                    ledgerSummaryMonthHidden.value = summaryMonthInput.value || '';
                }
                incomeLedgerSubmitting = true;
                if (incomeLedgerLoadingState) incomeLedgerLoadingState.hidden = false;
                incomeLedgerUpdateButton.disabled = true;
                incomeLedgerUpdateButton.textContent = '更新中...';
            });
            document.getElementById('incomeLedgerModal')?.addEventListener('hidden.bs.modal', () => {
                incomeLedgerSubmitting = false;
                if (incomeLedgerLoadingState) incomeLedgerLoadingState.hidden = true;
                incomeLedgerUpdateButton.disabled = false;
                incomeLedgerUpdateButton.textContent = '更新明細';
            });
        }

        if (shouldOpenIncomeDetailModal) safeShowModal('incomeLedgerModal');

        const summaryMonthInput = document.getElementById('incomeSummaryMonthInput');
        const ledgerModalEl = document.getElementById('incomeLedgerModal');
        const ledgerModal = ledgerModalEl && window.bootstrap?.Modal
            ? bootstrap.Modal.getOrCreateInstance(ledgerModalEl)
            : null;
        const ledgerSummaryMonthHidden = document.querySelector('#incomeLedgerModal input[name="summary_month"]');
        const summaryTableBody = document.getElementById('incomeSummaryTableBody');
        const summaryError = document.getElementById('incomeSummaryError');
        const summaryContract = document.getElementById('incomeSummaryContractNotice');
        const monthlyNetAmountEl = document.getElementById('incomeMonthlyNetAmount');
        const paidAmountEl = document.getElementById('incomePaidAmount');
        const pendingAmountEl = document.getElementById('incomePendingAmount');
        const availableAmountEl = document.getElementById('incomeAvailableAmount');
        const categoryModalEl = document.getElementById('incomeCategoryDetailModal');
        const categoryDetailBody = document.getElementById('incomeCategoryDetailBody');
        const categoryDetailMeta = document.getElementById('incomeCategoryDetailMeta');
        const categoryDetailPagination = document.getElementById('incomeCategoryDetailPagination');
        const categoryDetailLoading = document.getElementById('incomeCategoryDetailLoading');
        const categoryDetailError = document.getElementById('incomeCategoryDetailError');
        const detailPrevButton = document.getElementById('incomeCategoryDetailPrevPage');
        const detailNextButton = document.getElementById('incomeCategoryDetailNextPage');
        const categoryModal = categoryModalEl && window.bootstrap?.Modal
            ? bootstrap.Modal.getOrCreateInstance(categoryModalEl)
            : null;
        const detailState = {
            sourceType: '',
            category: '',
            month: summaryMonthInput ? summaryMonthInput.value : '',
            page: 1,
            totalPages: 1,
            loading: false,
            requestSeq: 0
        };
        let categoryDetailTriggerButton = null;
        const categoryDetailFlowState = {
            returnToLedger: false,
            triggerEl: null
        };
        let summaryRequestSeq = 0;

        function setSummaryError(message) {
            if (!summaryError) return;
            if (!message) {
                summaryError.hidden = true;
                summaryError.textContent = '';
                return;
            }
            summaryError.hidden = false;
            summaryError.textContent = message;
        }

        function formatSignedAmount(value) {
            const amount = Number(value || 0);
            const absText = Math.abs(amount).toLocaleString();
            if (amount > 0) return { text: `+$${absText}`, cls: 'income-amount-positive' };
            if (amount < 0) return { text: `-$${absText}`, cls: 'income-amount-negative' };
            return { text: `$${absText}`, cls: 'income-amount-zero' };
        }

        function renderSummaryRows(rows) {
            if (!summaryTableBody) return;
            summaryTableBody.innerHTML = '';
            if (!Array.isArray(rows) || rows.length === 0) {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td colspan="5" class="text-center py-3 text-secondary">本月沒有可顯示的薪資與分潤項目</td>';
                summaryTableBody.appendChild(tr);
                return;
            }

            rows.forEach(item => {
                const signed = formatSignedAmount(item.totalAmount);
                const tr = document.createElement('tr');
                const desc = Array.isArray(item.descriptions) && item.descriptions.length ? item.descriptions.join('、') : '-';
                const categoryTd = document.createElement('td');
                const categoryChip = document.createElement('span');
                categoryChip.className = 'income-category-chip';
                categoryChip.textContent = item.category || '未分類收入';
                categoryTd.appendChild(categoryChip);

                const countTd = document.createElement('td');
                countTd.className = 'text-center';
                countTd.textContent = item.countLabel || `${Number(item.count || 0)} 筆`;

                const amountTd = document.createElement('td');
                amountTd.className = `text-end ${signed.cls}`;
                amountTd.textContent = signed.text;

                const descTd = document.createElement('td');
                descTd.textContent = desc;

                const actionTd = document.createElement('td');
                actionTd.className = 'text-center';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm income-neon-detail-btn income-open-detail';
                btn.setAttribute('data-source-type', item.sourceType || '');
                btn.setAttribute('data-category', item.category || '');
                btn.textContent = '查看明細';
                actionTd.appendChild(btn);

                tr.append(categoryTd, countTd, amountTd, descTd, actionTd);
                summaryTableBody.appendChild(tr);
            });
        }

        function renderLimitations(limitations) {
            if (!summaryContract) return;
            summaryContract.innerHTML = '';
            const items = Array.isArray(limitations) ? limitations : [];
            items.forEach(text => {
                const p = document.createElement('p');
                p.className = 'mb-1';
                p.textContent = `• ${text}`;
                summaryContract.appendChild(p);
            });
        }

        function renderSummary(snapshot) {
            const totals = snapshot && snapshot.totals ? snapshot.totals : {};
            const netSalary = Number((snapshot && snapshot.netSalary) || totals.netSalary || totals.monthlyNetAmount || 0);
            if (monthlyNetAmountEl) monthlyNetAmountEl.textContent = `$${netSalary.toLocaleString()}`;
            if (paidAmountEl) paidAmountEl.textContent = `$${Number(totals.paidAmount || 0).toLocaleString()}`;
            if (pendingAmountEl) pendingAmountEl.textContent = `$${Number(totals.pendingAmount || 0).toLocaleString()}`;
            if (availableAmountEl) availableAmountEl.textContent = `$${Number(totals.availableAmount || 0).toLocaleString()}`;
            renderSummaryRows(snapshot && Array.isArray(snapshot.rows) ? snapshot.rows : []);
            renderLimitations(snapshot && snapshot.limitations ? snapshot.limitations : []);
        }

        async function refreshIncomeSummary(month) {
            const currentSeq = ++summaryRequestSeq;
            setSummaryError('');
            try {
                const response = await fetch(`/api/income/monthly-summary?month=${encodeURIComponent(month)}`, {
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin'
                });
                const payload = await response.json();
                if (currentSeq !== summaryRequestSeq) return;
                if (!response.ok || payload.success !== true || !payload.summary) {
                    throw new Error(payload && payload.message ? payload.message : '無法更新收入摘要');
                }
                renderSummary(payload.summary);
            } catch (error) {
                if (currentSeq !== summaryRequestSeq) return;
                setSummaryError(error.message || '無法更新收入摘要');
            }
        }

        function setDetailLoading(loading) {
            detailState.loading = loading;
            if (categoryDetailLoading) categoryDetailLoading.hidden = !loading;
            if (detailPrevButton) detailPrevButton.disabled = loading || detailState.page <= 1;
            if (detailNextButton) detailNextButton.disabled = loading || detailState.page >= detailState.totalPages;
        }

        function setDetailError(message) {
            if (!categoryDetailError) return;
            if (!message) {
                categoryDetailError.hidden = true;
                categoryDetailError.textContent = '';
                return;
            }
            categoryDetailError.hidden = false;
            categoryDetailError.textContent = message;
        }

        function renderDetailRows(rows) {
            if (!categoryDetailBody) return;
            categoryDetailBody.innerHTML = '';
            if (!Array.isArray(rows) || rows.length === 0) {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td colspan="6" class="text-center text-secondary py-3">沒有符合條件的明細</td>';
                categoryDetailBody.appendChild(tr);
                return;
            }
            rows.forEach(row => {
                const signed = formatSignedAmount(row.amount);
                const tr = document.createElement('tr');

                const timeTd = document.createElement('td');
                timeTd.textContent = String(row.occurredAt || '-').replace('T', ' ').slice(0, 19);

                const sourceTd = document.createElement('td');
                sourceTd.textContent = row.sourceNo || row.sourceId || '-';

                const categoryTd = document.createElement('td');
                categoryTd.textContent = row.category || '-';

                const amountTd = document.createElement('td');
                amountTd.className = `text-end ${signed.cls}`;
                amountTd.textContent = signed.text;

                const reasonTd = document.createElement('td');
                reasonTd.textContent = row.description || '-';

                const statusTd = document.createElement('td');
                statusTd.textContent = row.status || '-';

                tr.append(timeTd, sourceTd, categoryTd, amountTd, reasonTd, statusTd);
                categoryDetailBody.appendChild(tr);
            });
        }

        async function loadCategoryDetails() {
            if (!detailState.month || !detailState.sourceType || !detailState.category) return;
            const currentSeq = ++detailState.requestSeq;
            setDetailError('');
            setDetailLoading(true);
            try {
                const query = new URLSearchParams({
                    month: detailState.month,
                    sourceType: detailState.sourceType,
                    category: detailState.category,
                    page: String(detailState.page),
                    limit: '12'
                });
                const response = await fetch(`/api/income/monthly-details?${query.toString()}`, {
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin'
                });
                const payload = await response.json();
                if (currentSeq !== detailState.requestSeq) return;
                if (!response.ok || payload.success !== true || !payload.details) {
                    throw new Error(payload && payload.message ? payload.message : '無法載入明細');
                }
                const details = payload.details;
                detailState.totalPages = Number(details.totalPages || 1);
                detailState.page = Number(details.page || 1);
                renderDetailRows(details.rows || []);
                if (categoryDetailMeta) {
                    categoryDetailMeta.textContent = `${details.month}｜${details.sourceType || '-'}｜${details.category || '-'}｜本頁合計：$${Number(details.pageAmount || 0).toLocaleString()}｜分類總計：$${Number(details.totalAmount || 0).toLocaleString()}`;
                }
                if (categoryDetailPagination) {
                    categoryDetailPagination.textContent = `第 ${detailState.page} / ${detailState.totalPages} 頁`;
                }
            } catch (error) {
                if (currentSeq !== detailState.requestSeq) return;
                renderDetailRows([]);
                setDetailError(error.message || '無法載入明細');
            } finally {
                if (currentSeq === detailState.requestSeq) setDetailLoading(false);
            }
        }

        summaryTableBody?.addEventListener('click', event => {
            const trigger = event.target && event.target.closest ? event.target.closest('.income-open-detail') : null;
            if (!trigger) return;
            categoryDetailTriggerButton = trigger;
            detailState.sourceType = String(trigger.getAttribute('data-source-type') || '').trim();
            detailState.category = String(trigger.getAttribute('data-category') || '').trim();
            detailState.month = summaryMonthInput ? summaryMonthInput.value : detailState.month;
            detailState.page = 1;

            const openCategoryModal = () => {
                if (categoryModal) {
                    categoryModal.show();
                } else {
                    safeShowModal('incomeCategoryDetailModal');
                }
                loadCategoryDetails();
            };

            const ledgerIsOpen = Boolean(ledgerModalEl && ledgerModalEl.classList.contains('show'));
            if (ledgerIsOpen && ledgerModal) {
                categoryDetailFlowState.returnToLedger = true;
                categoryDetailFlowState.triggerEl = trigger;
                ledgerModalEl.addEventListener('hidden.bs.modal', openCategoryModal, { once: true });
                ledgerModal.hide();
                return;
            }

            categoryDetailFlowState.returnToLedger = false;
            categoryDetailFlowState.triggerEl = trigger;
            openCategoryModal();
        });

        categoryModalEl?.addEventListener('hidden.bs.modal', () => {
            if (categoryDetailFlowState.returnToLedger && ledgerModal && ledgerModalEl) {
                const focusTarget = categoryDetailFlowState.triggerEl;
                categoryDetailFlowState.returnToLedger = false;
                categoryDetailFlowState.triggerEl = null;
                ledgerModalEl.addEventListener('shown.bs.modal', () => {
                    window.setTimeout(() => {
                        if (focusTarget && typeof focusTarget.focus === 'function') {
                            focusTarget.focus();
                        }
                    }, 120);
                }, { once: true });
                ledgerModal.show();
                return;
            }

            if (categoryDetailTriggerButton && typeof categoryDetailTriggerButton.focus === 'function') {
                categoryDetailTriggerButton.focus();
            }
        });

        detailPrevButton?.addEventListener('click', () => {
            if (detailState.loading || detailState.page <= 1) return;
            detailState.page -= 1;
            loadCategoryDetails();
        });

        detailNextButton?.addEventListener('click', () => {
            if (detailState.loading || detailState.page >= detailState.totalPages) return;
            detailState.page += 1;
            loadCategoryDetails();
        });

        summaryMonthInput?.addEventListener('change', () => {
            const selectedMonth = String(summaryMonthInput.value || '').trim();
            if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(selectedMonth)) {
                setSummaryError('月份格式無效，請使用 YYYY-MM');
                return;
            }
            if (ledgerSummaryMonthHidden) ledgerSummaryMonthHidden.value = selectedMonth;
            refreshIncomeSummary(selectedMonth);
        });

        // 🚀 2. 訂單篩選與明細綁定
        const rows = document.querySelectorAll('.order-income-row');
        const searchInput = document.getElementById('orderSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const startDateInput = document.getElementById('filterStartDate');
        const endDateInput = document.getElementById('filterEndDate');
        const statusSelect = document.getElementById('filterStatusSelect');
        const resetBtn = document.getElementById('resetFiltersBtn');
        const noMatchRow = document.getElementById('noMatchRow');

        function applyOrderFilters() {
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
            const start = startDateInput ? startDateInput.value : '';
            const end = endDateInput ? endDateInput.value : '';
            const status = statusSelect ? statusSelect.value : 'all';
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const rowDate = row.getAttribute('data-date') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesQuery = !query || searchData.includes(query);
                const matchesStatus = status === 'all' || rowStatus === status;
                
                let matchesDate = true;
                if (start && rowDate && rowDate < start) matchesDate = false;
                if (end && rowDate && rowDate > end) matchesDate = false;

                if (matchesQuery && matchesStatus && matchesDate) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                if (clearBtn) clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
                applyOrderFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                applyOrderFilters();
                searchInput.focus();
            });
        }

        if (startDateInput) startDateInput.addEventListener('change', applyOrderFilters);
        if (endDateInput) endDateInput.addEventListener('change', applyOrderFilters);
        if (statusSelect) statusSelect.addEventListener('change', applyOrderFilters);

        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                if (startDateInput) startDateInput.value = '';
                if (endDateInput) endDateInput.value = '';
                if (statusSelect) statusSelect.value = 'all';
                if (searchInput) searchInput.value = '';
                if (clearBtn) clearBtn.style.display = 'none';
                applyOrderFilters();
            });
        }

        // 🚀 3. 解析 JSON 綁定每筆工單明細點擊
        rows.forEach(row => {
            try {
                const rawAttr = row.getAttribute('data-order');
                if (rawAttr) {
                    const data = JSON.parse(rawAttr);
                    row.addEventListener('click', () => showOrderIncomeDetail(data, row));

                    const btn = row.querySelector('.btn-detail-trigger');
                    if (btn) {
                        btn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            showOrderIncomeDetail(data, btn);
                        });
                    }
                }
            } catch (jsonErr) {
                console.warn('⚠️ 解析單筆訂單 JSON 失敗:', jsonErr);
            }
        });
    });
</script>
</body>
</html>