<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的收入 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        img { max-width: 100%; height: auto; }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            min-width: 0;
        }

        .content-body { padding: 20px 36px 32px; flex-grow: 1; }

        .page-header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 14px;
            width: 100%;
        }

        .page-title-text {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
        }

        .income-stat-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 26px 28px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            height: 100%;
        }
        .income-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55);
        }

        .stat-card-glow {
            position: absolute; right: -20px; bottom: -20px;
            font-size: 5.5rem; opacity: 0.04; pointer-events: none;
        }

        .stat-label-text {
            font-size: 0.84rem; font-weight: 700; color: #94a3b8;
            text-transform: uppercase; letter-spacing: 0.6px;
            display: flex; align-items: center; gap: 8px;
        }

        .stat-val-huge {
            font-size: 2.1rem; font-weight: 800; font-family: monospace;
            line-height: 1.1; margin: 12px 0 6px 0;
        }

        .stat-sub-note { font-size: 0.76rem; color: #8b83a8; }

        .scrollable-modal-table-wrap { max-height: 380px; overflow-y: auto; overflow-x: auto; }
        .scrollable-modal-table-wrap::-webkit-scrollbar { width: 5px; height: 5px; }
        .scrollable-modal-table-wrap::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.35); border-radius: 4px; }

        .mihu-table { width: 100%; margin-bottom: 0; color: #f3f4f6; border-collapse: separate; border-spacing: 0; }
        .mihu-table th {
            background: rgba(0, 0, 0, 0.55); color: #94a3b8; font-weight: 700; font-size: 0.82rem;
            text-transform: uppercase; letter-spacing: 0.6px; padding: 14px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08); white-space: nowrap; position: sticky; top: 0; z-index: 2;
        }
        .mihu-table td { padding: 13px 18px; vertical-align: middle; border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.9rem; white-space: nowrap; }
        .mihu-table tbody tr.order-income-row { cursor: pointer; transition: background 0.15s ease; }
        .mihu-table tbody tr.order-income-row:hover { background: rgba(168, 85, 247, 0.09); }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97); border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px); color: #fff;
        }

        .filter-input-glass {
            background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important; border-radius: 12px; padding: 7px 12px; font-size: 0.86rem;
        }
        .filter-input-glass:focus {
            background-color: rgba(255, 255, 255, 0.09); border-color: var(--mihu-purple-light);
            outline: none; box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }

        .search-box-wrap { position: relative; flex-grow: 1; }
        .search-icon-left { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.86rem; pointer-events: none; }
        .search-clear-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.82rem; cursor: pointer; display: none; border: none; background: transparent; padding: 0; }

        .status-badge-completed { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; }
        .status-badge-active     { background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; }
        .status-badge-pending   { background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde047; }
        .status-badge-cancelled { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; }
        .status-badge-rejected  { background: rgba(148, 163, 184, 0.15); border: 1px solid rgba(148, 163, 184, 0.3); color: #94a3b8; }

        .user-mini-col { display: flex; align-items: center; gap: 8px; }
        .user-mini-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255, 255, 255, 0.15); }

        .info-detail-box {
            background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: center;
        }
        .info-detail-label { font-size: 0.74rem; color: #94a3b8; margin-bottom: 4px; }
        .info-detail-val { font-size: 0.92rem; font-weight: 700; color: #ffffff; font-family: monospace; word-break: break-all; }

        /* 按鈕樣式 */
        .btn-income-info {
            background: rgba(56, 189, 248, 0.08);
            border: 1px solid rgba(56, 189, 248, 0.35);
            color: #38bdf8 !important;
            font-weight: 600;
            border-radius: 50rem;
            padding: 8px 18px;
            font-size: 0.85rem;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(10px);
        }
        .btn-income-info:hover {
            background: rgba(56, 189, 248, 0.2);
            border-color: #38bdf8;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(56, 189, 248, 0.35);
        }

        .btn-income-orders {
            background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
            border: 1px solid rgba(192, 132, 252, 0.4);
            color: #ffffff !important;
            font-weight: 700;
            border-radius: 50rem;
            padding: 8px 22px;
            font-size: 0.88rem;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            box-shadow: 0 4px 15px rgba(147, 51, 234, 0.4);
        }
        .btn-income-orders:hover {
            background: linear-gradient(135deg, #c084fc 0%, #9333ea 100%);
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.6);
            color: #ffffff !important;
        }

        .orders-count-badge {
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fde047;
            font-family: monospace;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.78rem;
            margin-left: 2px;
        }

        .withdrawal-card-shell {
            margin-bottom: 24px;
            padding: 20px 22px;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            background: var(--card-bg);
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
        }
        .withdrawal-card-header { display: flex; justify-content: space-between; align-items: center; gap: 18px; margin-bottom: 18px; }
        .withdrawal-card-heading { min-width: 0; }
        .withdrawal-card-heading h5 { margin: 0 0 4px; font-weight: 800; }
        .withdrawal-card-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
        .withdrawal-card-info-btn,
        .withdrawal-card-apply-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 40px;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 0.86rem;
            font-weight: 700;
            transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }
        .withdrawal-card-info-btn { color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.38); background: rgba(100, 116, 139, 0.08); }
        .withdrawal-card-info-btn:hover { color: #f8fafc; border-color: #94a3b8; background: rgba(100, 116, 139, 0.18); }
        .withdrawal-card-apply-btn { color: #f8fafc; border: 1px solid rgba(52, 211, 153, 0.48); background: linear-gradient(120deg, #059669, #6d28d9); box-shadow: 0 0 18px rgba(52, 211, 153, 0.18), 0 5px 18px rgba(109, 40, 217, 0.24); }
        .withdrawal-card-apply-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 0 24px rgba(52, 211, 153, 0.28), 0 7px 22px rgba(109, 40, 217, 0.32); }
        .withdrawal-card-apply-btn:disabled { opacity: 0.48; cursor: not-allowed; box-shadow: none; }
        .withdrawal-card-metrics { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
        .withdrawal-pending-badge { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border: 1px solid rgba(253, 224, 71, 0.7); border-radius: 8px; color: #fde047; background: rgba(253, 224, 71, 0.08); font-weight: 700; }
        .withdrawal-card-period { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border: 1px solid rgba(125, 211, 252, 0.28); border-radius: 8px; color: #bae6fd; background: rgba(56, 189, 248, 0.07); font-size: 0.9rem; }
        .withdrawal-card-notes { display: grid; gap: 5px; margin-top: 15px; }
        .withdrawal-card-note { margin: 0; color: #94a3b8; font-size: 0.8rem; line-height: 1.5; }
        @media (max-width: 575px) {
            .withdrawal-card-shell { padding: 16px; }
            .withdrawal-card-header { align-items: stretch; flex-direction: column; gap: 14px; }
            .withdrawal-card-actions { display: grid; grid-template-columns: 1fr; width: 100%; }
            .withdrawal-card-actions button { width: 100%; }
            .withdrawal-card-metrics { align-items: flex-start; flex-direction: column; }
        }

        #incomeLedgerModal.income-ledger-modal .modal-content {
            background: rgba(10, 7, 22, 0.95);
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.3);
            color: #e2e8f0;
        }

        #incomeLedgerModal.income-ledger-modal .modal-header,
        #incomeLedgerModal.income-ledger-modal .modal-body,
        #incomeLedgerModal.income-ledger-modal .modal-footer {
            background: rgba(10, 7, 22, 0.95);
            border-color: rgba(168, 85, 247, 0.24);
        }

        #incomeLedgerModal.income-ledger-modal .modal-header {
            border-bottom: 1px solid rgba(168, 85, 247, 0.24);
        }

        #incomeLedgerModal.income-ledger-modal .modal-footer {
            border-top: 1px solid rgba(168, 85, 247, 0.24);
            justify-content: flex-end;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-bar {
            display: flex;
            gap: 10px;
            align-items: flex-end;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-month {
            min-width: 200px;
            flex: 1 1 240px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-submit {
            width: 180px;
            max-width: 100%;
            flex: 0 1 180px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-summary {
            flex: 1 1 220px;
            text-align: right;
            color: #94a3b8;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-bar .form-control {
            background: rgba(76, 29, 149, 0.24);
            border: 1px solid rgba(168, 85, 247, 0.45);
            color: #e2e8f0;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-bar .form-control:focus-visible,
        #incomeLedgerModal.income-ledger-modal .income-ledger-filter-bar .form-control:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3);
            outline: none;
        }

        #incomeLedgerModal.income-ledger-modal [data-income-ledger-update-button="true"] {
            background: linear-gradient(135deg, #a855f7, #6366f1);
            border: none;
            color: #fff;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.4);
            min-height: 36px;
        }

        #incomeLedgerModal.income-ledger-modal [data-income-ledger-update-button="true"]:focus-visible {
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.35), 0 0 12px rgba(168, 85, 247, 0.4);
            outline: none;
        }

        #incomeLedgerModal.income-ledger-modal [data-income-ledger-update-button="true"]:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            box-shadow: none;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-state {
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 12px;
            margin-bottom: 12px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-state-loading {
            color: #cbd5e1;
            background: rgba(79, 70, 229, 0.16);
            border-left: 3px solid #6366f1;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(168, 85, 247, 0.25);
            border-radius: 10px;
            padding: 10px;
            height: 100%;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-card .small {
            color: #94a3b8;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-net {
            color: #c084fc;
            text-shadow: 0 0 8px rgba(192, 132, 252, 0.35);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-paid {
            color: #34d399;
            text-shadow: 0 0 8px rgba(16, 185, 129, 0.35);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-pending {
            color: #38bdf8;
            text-shadow: 0 0 8px rgba(56, 189, 248, 0.35);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-kpi-available {
            color: #a78bfa;
            text-shadow: 0 0 8px rgba(167, 139, 250, 0.35);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-note {
            background: rgba(168, 85, 247, 0.1);
            border-left: 3px solid #a855f7;
            color: #cbd5e1;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 12px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-totals .badge {
            background: rgba(30, 41, 59, 0.8);
            color: #cbd5e1;
            border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 50px;
            font-weight: 500;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-table-wrap {
            overflow-x: auto;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-table {
            min-width: 640px;
            color: #e2e8f0;
            margin-bottom: 0;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-table thead th {
            background: rgba(15, 23, 42, 0.78);
            color: #a5b4fc;
            border-bottom: 1px solid rgba(168, 85, 247, 0.3);
            white-space: nowrap;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-table tbody td {
            background: rgba(2, 6, 23, 0.42);
            border-bottom: 1px solid rgba(148, 163, 184, 0.16);
            color: #e2e8f0;
            vertical-align: top;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-empty-row td {
            color: #94a3b8;
            background: rgba(2, 6, 23, 0.28);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-pill {
            display: inline-flex;
            align-items: center;
            max-width: 100%;
            padding: 4px 10px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid transparent;
            white-space: normal;
            word-break: break-word;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-pill.tone-commission {
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border-color: rgba(56, 189, 248, 0.4);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-pill.tone-allowance {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border-color: rgba(16, 185, 129, 0.4);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-pill.tone-deduction {
            background: rgba(255, 70, 85, 0.15);
            color: #ff4655;
            border-color: rgba(255, 70, 85, 0.4);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-category-pill.tone-fallback {
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            border-color: rgba(168, 85, 247, 0.38);
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-source-cell {
            min-width: 200px;
            white-space: normal;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-source-title {
            color: #f8fafc;
            font-weight: 600;
            line-height: 1.3;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-source-desc {
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.35;
            margin-top: 3px;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        #incomeLedgerModal.income-ledger-modal .amount-positive,
        #incomeLedgerModal.income-ledger-modal .amount-negative,
        #incomeLedgerModal.income-ledger-modal .amount-zero {
            font-weight: 600;
            white-space: nowrap;
        }

        #incomeLedgerModal.income-ledger-modal .amount-positive {
            color: #10b981;
            text-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
        }

        #incomeLedgerModal.income-ledger-modal .amount-negative {
            color: #ff4655;
            text-shadow: 0 0 8px rgba(255, 70, 85, 0.3);
        }

        #incomeLedgerModal.income-ledger-modal .amount-zero {
            color: #94a3b8;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-pagination {
            gap: 8px;
            flex-wrap: wrap;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn {
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(168, 85, 247, 0.3);
            color: #c084fc;
            border-radius: 6px;
            min-width: 88px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn:hover,
        #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn:focus-visible {
            border-color: rgba(168, 85, 247, 0.6);
            color: #e9d5ff;
            box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.26);
            outline: none;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn.disabled,
        #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn[aria-disabled="true"] {
            opacity: 0.45;
            pointer-events: none;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-close-btn {
            background: rgba(30, 41, 59, 0.84);
            border: 1px solid rgba(148, 163, 184, 0.4);
            color: #cbd5e1;
            border-radius: 8px;
            padding-inline: 14px;
        }

        #incomeLedgerModal.income-ledger-modal .income-ledger-close-btn:hover,
        #incomeLedgerModal.income-ledger-modal .income-ledger-close-btn:focus-visible {
            border-color: rgba(168, 85, 247, 0.52);
            color: #f8fafc;
            box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.2);
            outline: none;
        }

        @media (max-width: 390px) {
            #incomeLedgerModal.income-ledger-modal .income-ledger-filter-summary {
                text-align: left;
                width: 100%;
            }

            #incomeLedgerModal.income-ledger-modal .income-ledger-filter-submit {
                width: 100%;
                flex: 1 1 100%;
            }

            #incomeLedgerModal.income-ledger-modal .income-ledger-table {
                min-width: 580px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            #incomeLedgerModal.income-ledger-modal .income-ledger-page-btn,
            #incomeLedgerModal.income-ledger-modal [data-income-ledger-update-button="true"] {
                transition: none;
            }
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'income' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'income' }) %>

    <div class="content-body admin-page-content">
        <%- include('partials/admin_page_header', { icon: 'fa-sack-dollar', title: '我的收入與接單分潤', description: '即時掌握個人接單歷史累積分潤、當月結算收入與可提領薪資 (分潤依原價計算，不承擔折扣)' }) %>

        <!-- 🚀 1. 載入獨立模組：四大金流卡片 -->
        <%- include('partials/income_stat_cards') %>

        <% const minimumWithdrawalAmount = Number(payoutOverview.settings.minimumAmount); %>
        <% const withdrawalGate = payoutOverview.withdrawalGate || { allowed: false, reasons: [] }; %>
        <% const withdrawalReasons = Array.isArray(withdrawalGate.reasons) ? withdrawalGate.reasons : []; %>
        <section class="withdrawal-card-shell" aria-labelledby="withdrawalCardTitle">
            <div class="withdrawal-card-header">
                <div class="withdrawal-card-heading">
                    <h5 class="text-white" id="withdrawalCardTitle"><i class="fa-solid fa-building-columns text-info me-2"></i>薪資提款</h5>
                </div>
                <div class="withdrawal-card-actions">
                    <button type="button" class="withdrawal-card-info-btn" id="showWithdrawalTerms"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>提款須知</button>
                    <button type="button" class="withdrawal-card-apply-btn" id="beginWithdrawalFlow"
                        data-window-open="<%= payoutOverview.windowOpen ? 'true' : 'false' %>"
                        data-bank-ready="<%= payoutOverview.bankDetailsReady ? 'true' : 'false' %>"
                        data-available="<%= Number(payoutOverview.availableAmount) %>"
                        data-minimum="<%= minimumWithdrawalAmount %>"
                        data-gate-allowed="<%= withdrawalGate.allowed ? 'true' : 'false' %>"
                        data-gate-reasons="<%- JSON.stringify(withdrawalReasons) %>"
                        data-profile-url="/profile"
                        data-timezone="<%= payoutOverview.settings.timeZone %>"
                        <% if (!withdrawalGate.allowed) { %>disabled<% } %>>
                        <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>申請提款
                    </button>
                </div>
            </div>
            <div class="withdrawal-card-metrics">
                <span class="withdrawal-pending-badge"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>撥款中：$<%= Number(payoutOverview.pendingAmount).toLocaleString() %> NTD</span>
                <span class="withdrawal-card-period"><i class="fa-regular fa-calendar" aria-hidden="true"></i>申請期間：每月 <%= payoutOverview.settings.startDay %> 日 ~ <%= payoutOverview.settings.endDay %> 日（<%= payoutOverview.settings.timeZone %>）</span>
            </div>
            <div class="withdrawal-card-notes">
                <p class="withdrawal-card-note">• 最低申請金額 $<%= minimumWithdrawalAmount.toLocaleString() %> · <%= payoutOverview.bankDetailsReady ? '薪轉帳戶已設定' : '薪轉帳戶尚未設定' %></p>
                <p class="withdrawal-card-note">• 非玉山銀行 (808) 帳戶設為薪轉，可能會需要負擔跨行轉帳手續費。</p>
            </div>
            <div class="withdrawal-card-notes mt-2" id="withdrawalGateNotice" aria-live="polite">
                <% if (withdrawalReasons.length) { %>
                    <% withdrawalReasons.forEach(reason => { %>
                        <p class="withdrawal-card-note">• <%= reason.message %>
                            <% if (reason.actionUrl) { %>
                                <a href="<%= reason.actionUrl %>" class="ms-1 text-info text-decoration-underline"><%= reason.actionText || '前往設定' %></a>
                            <% } %>
                        </p>
                    <% }) %>
                <% } else { %>
                    <p class="withdrawal-card-note">• 目前符合提款申請條件，可繼續下一步確認金額。</p>
                <% } %>
                <p class="withdrawal-card-note text-danger" id="withdrawalFrontendError" hidden></p>
            </div>
            <% if (payoutOverview.payouts.length) { %>
                <div class="table-responsive mt-3">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr><th>申請編號</th><th>申請時間</th><th class="text-end">金額</th><th>狀態</th><th>薪轉帳戶</th><th>退回原因</th></tr></thead>
                        <tbody>
                            <% payoutOverview.payouts.forEach(payout => { %>
                                <tr>
                                    <td><%= payout.withdrawal_no || `#${payout.id}` %></td>
                                    <td><%= payout.requested_at || '-' %></td>
                                    <td class="text-end">$<%= Number(payout.amount).toLocaleString() %></td>
                                    <td><%= payout.status === 'pending' ? '撥款中' : payout.status === 'paid' ? '已撥款' : payout.status === 'rejected' ? '已退回' : '歷史紀錄' %></td>
                                    <td><%= payout.bank_name || '-' %> · <%= payout.account_name_masked || '-' %> · <%= payout.bank_account_masked || '-' %></td>
                                    <td><%= payout.rejected_reason || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-secondary small mb-0 mt-3">尚無提款申請紀錄</p>
            <% } %>
        </section>

        <!-- 🚀 2. 我的接單管理中心 -->
        <div class="p-4 rounded-4 d-flex justify-content-between align-items-center flex-wrap gap-3" style="background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <div>
                <h5 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-list-check text-primary"></i>我的接單管理中心
                </h5>
                <p class="text-secondary small mb-0">依自訂日期區間與訂單狀態過濾工單，即時核算每筆單的分潤金額</p>
            </div>

            <!-- 右側操作按鈕群 (支援主動點擊相容性) -->
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-outline-warning rounded-pill px-3 py-2 small fw-semibold" data-bs-toggle="modal" data-bs-target="#incomeLedgerModal" id="openIncomeLedgerButton">
                    <i class="fa-solid fa-file-invoice-dollar me-1"></i>
                    <span>薪資與分潤明細</span>
                </button>
                <button type="button" class="btn btn-income-info" data-bs-toggle="modal" data-bs-target="#commissionRatesModal">
                    <i class="fa-solid fa-circle-info text-info"></i>
                    <span>當前分潤成數表</span>
                </button>

                <button type="button" class="btn btn-income-orders" data-bs-toggle="modal" data-bs-target="#ordersHistoryModal">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>開啟我的接單清單</span>
                    <span class="orders-count-badge"><%= orders ? orders.length : 0 %></span>
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/income_withdrawal_modal', { payoutOverview: payoutOverview }) %>
<%- include('modals/withdrawal_terms_modal', { settings: payoutOverview.settings }) %>
<%- include('partials/income_salary_detail_modal', { incomeDetail: incomeDetail || null, openIncomeDetailModal: openIncomeDetailModal === true }) %>

<!-- 🚀 3. 載入獨立模組：分潤成數彈窗 -->
<%- include('partials/income_commission_modal') %>

<!-- 🚀 4. 載入獨立模組：獨立【我的接單】彈窗 -->
<%- include('partials/income_orders_modal') %>

<!-- 🚀 5. 載入獨立模組：單筆工單詳情彈窗 -->
<%- include('partials/income_detail_modal') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const shouldOpenIncomeDetailModal = <%= openIncomeDetailModal === true ? 'true' : 'false' %>;
    (() => {
        const termsModalEl = document.getElementById('withdrawalTermsModal');
        const amountModalEl = document.getElementById('withdrawalRequestModal');
        const termsButton = document.getElementById('showWithdrawalTerms');
        const applyButton = document.getElementById('beginWithdrawalFlow');
        const continueButton = document.getElementById('withdrawalTermsContinue');
        const frontendError = document.getElementById('withdrawalFrontendError');

        function showFrontendError(message) {
            if (!frontendError) return;
            frontendError.hidden = false;
            frontendError.textContent = message;
        }

        if (!termsModalEl || !amountModalEl || !termsButton || !applyButton || !continueButton || !window.bootstrap?.Modal) {
            showFrontendError('提款按鈕前端載入不完整，請重新整理；若持續發生請聯絡管理員。');
            return;
        }

        const termsModal = bootstrap.Modal.getOrCreateInstance(termsModalEl);
        const amountModal = bootstrap.Modal.getOrCreateInstance(amountModalEl);
        let flowContext = 'READ_ONLY';
        let transitionPending = false;
        let continueToAmount = false;

        function parseGateReasons() {
            try {
                const reasons = JSON.parse(applyButton.dataset.gateReasons || '[]');
                return Array.isArray(reasons) ? reasons : [];
            } catch {
                return [];
            }
        }

        function renderGateReasonFallback() {
            const reasons = parseGateReasons();
            if (!reasons.length) return;
            showFrontendError(reasons.map(item => `• ${item.message}`).join(' '));
        }

        function openTerms(context) {
            if (transitionPending || termsModalEl.classList.contains('show') || amountModalEl.classList.contains('show')) return;
            flowContext = context;
            termsModalEl.dataset.flowContext = context;
            continueButton.hidden = context !== 'WITHDRAWAL_GATE';
            termsModal.show();
        }

        termsButton.addEventListener('click', () => openTerms('READ_ONLY'));
        applyButton.addEventListener('click', () => {
            if (applyButton.disabled) {
                renderGateReasonFallback();
                return;
            }
            if (transitionPending) return;
            const canRequest = applyButton.dataset.windowOpen === 'true'
                && applyButton.dataset.bankReady === 'true'
                && Number(applyButton.dataset.available) >= Number(applyButton.dataset.minimum);
            if (!canRequest || applyButton.dataset.gateAllowed !== 'true') {
                renderGateReasonFallback();
                return;
            }
            openTerms('WITHDRAWAL_GATE');
        });

        termsModalEl.addEventListener('hidden.bs.modal', () => {
            transitionPending = false;
            const shouldOpenAmount = continueToAmount && flowContext === 'WITHDRAWAL_GATE';
            continueToAmount = false;
            flowContext = 'READ_ONLY';
            termsModalEl.dataset.flowContext = flowContext;
            continueButton.hidden = true;
            if (shouldOpenAmount) amountModal.show();
        });

        continueButton.addEventListener('click', () => {
            if (flowContext !== 'WITHDRAWAL_GATE' || transitionPending) return;
            transitionPending = true;
            continueToAmount = true;
            termsModal.hide();
        });

        window.addEventListener('error', event => {
            const message = event && event.message ? `提款功能腳本發生錯誤：${event.message}` : '提款功能腳本發生錯誤。';
            showFrontendError(message);
        });
    })();

    let withdrawalSubmitting = false;
    const submitWithdrawalButton = document.getElementById('submitWithdrawalRequest');
    const originalSubmitMarkup = submitWithdrawalButton ? submitWithdrawalButton.innerHTML : '';

    submitWithdrawalButton?.addEventListener('click', async () => {
        if (withdrawalSubmitting) return;
        const amountInput = document.getElementById('withdrawalAmount');
        const errorBox = document.getElementById('withdrawalRequestError');
        const amount = Number(amountInput.value);
        if (!amountInput.checkValidity()) {
            amountInput.reportValidity();
            return;
        }
        if (!window.confirm(`確定申請提款 $${amount.toLocaleString()}？申請後無法自行取消。`)) return;
        withdrawalSubmitting = true;
        submitWithdrawalButton.disabled = true;
        submitWithdrawalButton.textContent = '處理中...';
        errorBox.textContent = '';
        try {
            const response = await fetch('/api/withdrawals/request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
                body: JSON.stringify({ amount })
            });
            const result = await response.json();
            if (window.MiHuFeedback?.isPermissionDeniedResponse(response)) {
                withdrawalSubmitting = false;
                submitWithdrawalButton.disabled = false;
                submitWithdrawalButton.innerHTML = originalSubmitMarkup;
                return;
            }
            if (!response.ok || !result.success) throw new Error(result.message || '提款申請失敗');
            window.location.reload();
        } catch (error) {
            errorBox.textContent = error.message;
            withdrawalSubmitting = false;
            submitWithdrawalButton.disabled = false;
            submitWithdrawalButton.innerHTML = originalSubmitMarkup;
        }
    });

    // 🚀 安全開啟 Modal 函式 (防範 bootstrap backdrop 報錯)
    function safeShowModal(modalId) {
        const modalEl = document.getElementById(modalId);
        if (!modalEl) {
            console.warn(`⚠️ 找不到 Modal 元素 #${modalId}，請確認 Partials 是否正確引入！`);
            return;
        }

        try {
            // 優先使用 Bootstrap 5 官方 Instance
            if (window.bootstrap && window.bootstrap.Modal) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
                    backdrop: true,
                    keyboard: true,
                    focus: true
                });
                modal.show();
            } else {
                // 備用防護：若 Bootstrap JS 加載異常，手動顯示
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
                document.body.classList.add('modal-open');
            }
        } catch (err) {
            console.error(`❌ 開啟 Modal #${modalId} 失敗:`, err);
        }
    }

    // 🚀 單筆工單詳情顯示
    function showOrderIncomeDetail(data) {
        if (!data) return;

        const setElText = (id, text) => {
            const el = document.getElementById(id);
            if (el) el.textContent = text;
        };

        setElText('detailOrderNo', data.orderNo || '--');
        setElText('detailStatus', data.statusName || '--');
        setElText('detailBoss', data.bossName || '--');
        setElText('detailGameAndDuration', `${data.game || '一般服務'} (${data.duration || 1}${data.unit || 'h'} / ${data.headcount || 1}人)`);
        setElText('detailTotalAmount', `$${Number(data.totalAmount || 0).toLocaleString()} NTD`);
        setElText('detailMyIncome', (data.myIncome && data.myIncome > 0) ? `+$${Number(data.myIncome).toLocaleString()} NTD` : '$0 NTD (未入帳)');
        setElText('detailStartTime', data.startTime || '尚未開始');
        setElText('detailEndTime', data.endTime || '尚未結束');
        setElText('detailNote', data.note || '無特別備註');

        safeShowModal('incomeDetailModal');
    }

    document.addEventListener('DOMContentLoaded', () => {
        // 🚀 1. 手動綁定按鈕點擊事件 (安全觸發，不依賴可能失敗的 data-bs-toggle)
        const btnCommission = document.querySelector('.btn-income-info');
        const btnOrders = document.querySelector('.btn-income-orders');
        const btnIncomeLedger = document.getElementById('openIncomeLedgerButton');

        if (btnCommission) {
            btnCommission.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('commissionRatesModal');
            });
        }

        if (btnOrders) {
            btnOrders.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('ordersHistoryModal');
            });
        }

        if (btnIncomeLedger) {
            btnIncomeLedger.addEventListener('click', (e) => {
                e.preventDefault();
                safeShowModal('incomeLedgerModal');
            });
        }

        const incomeLedgerFilterForm = document.querySelector('#incomeLedgerModal [data-income-ledger-filter-form="true"]');
        const incomeLedgerUpdateButton = document.querySelector('#incomeLedgerModal [data-income-ledger-update-button="true"]');
        const incomeLedgerLoadingState = document.getElementById('incomeLedgerLoadingState');
        if (incomeLedgerFilterForm && incomeLedgerUpdateButton) {
            let incomeLedgerSubmitting = false;
            incomeLedgerFilterForm.addEventListener('submit', event => {
                if (incomeLedgerSubmitting) {
                    event.preventDefault();
                    return;
                }
                incomeLedgerSubmitting = true;
                if (incomeLedgerLoadingState) incomeLedgerLoadingState.hidden = false;
                incomeLedgerUpdateButton.disabled = true;
                incomeLedgerUpdateButton.textContent = '更新中...';
            });
            document.getElementById('incomeLedgerModal')?.addEventListener('hidden.bs.modal', () => {
                incomeLedgerSubmitting = false;
                if (incomeLedgerLoadingState) incomeLedgerLoadingState.hidden = true;
                incomeLedgerUpdateButton.disabled = false;
                incomeLedgerUpdateButton.textContent = '更新明細';
            });
        }

        if (shouldOpenIncomeDetailModal) safeShowModal('incomeLedgerModal');

        // 🚀 2. 訂單篩選與明細綁定
        const rows = document.querySelectorAll('.order-income-row');
        const searchInput = document.getElementById('orderSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const startDateInput = document.getElementById('filterStartDate');
        const endDateInput = document.getElementById('filterEndDate');
        const statusSelect = document.getElementById('filterStatusSelect');
        const resetBtn = document.getElementById('resetFiltersBtn');
        const noMatchRow = document.getElementById('noMatchRow');

        function applyOrderFilters() {
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
            const start = startDateInput ? startDateInput.value : '';
            const end = endDateInput ? endDateInput.value : '';
            const status = statusSelect ? statusSelect.value : 'all';
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const rowDate = row.getAttribute('data-date') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesQuery = !query || searchData.includes(query);
                const matchesStatus = status === 'all' || rowStatus === status;
                
                let matchesDate = true;
                if (start && rowDate && rowDate < start) matchesDate = false;
                if (end && rowDate && rowDate > end) matchesDate = false;

                if (matchesQuery && matchesStatus && matchesDate) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                if (clearBtn) clearBtn.style.display = searchInput.value.trim().length > 0 ? 'block' : 'none';
                applyOrderFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                applyOrderFilters();
                searchInput.focus();
            });
        }

        if (startDateInput) startDateInput.addEventListener('change', applyOrderFilters);
        if (endDateInput) endDateInput.addEventListener('change', applyOrderFilters);
        if (statusSelect) statusSelect.addEventListener('change', applyOrderFilters);

        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                if (startDateInput) startDateInput.value = '';
                if (endDateInput) endDateInput.value = '';
                if (statusSelect) statusSelect.value = 'all';
                if (searchInput) searchInput.value = '';
                if (clearBtn) clearBtn.style.display = 'none';
                applyOrderFilters();
            });
        }

        // 🚀 3. 解析 JSON 綁定每筆工單明細點擊
        rows.forEach(row => {
            try {
                const rawAttr = row.getAttribute('data-order');
                if (rawAttr) {
                    const data = JSON.parse(rawAttr);
                    row.addEventListener('click', () => showOrderIncomeDetail(data));

                    const btn = row.querySelector('.btn-detail-trigger');
                    if (btn) {
                        btn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            showOrderIncomeDetail(data);
                        });
                    }
                }
            } catch (jsonErr) {
                console.warn('⚠️ 解析單筆訂單 JSON 失敗:', jsonErr);
            }
        });
    });
</script>
</body>
</html>