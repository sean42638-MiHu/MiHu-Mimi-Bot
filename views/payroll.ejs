<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>薪轉管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/payroll-export.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            min-width: 0;
        }

        .content-body { 
            padding: 20px 36px 32px;
            flex-grow: 1; 
        }

        .search-box-wrap { position: relative; width: 260px; flex-shrink: 0; }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
        }
        .search-input-glass::placeholder { color: #94a3b8 !important; }
        .search-icon-left {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%); color: #94a3b8; font-size: 0.88rem;
        }
        .search-clear-btn {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%); color: #94a3b8; display: none; border: none; background: transparent;
        }

        /* 🚀 專屬 Excel 匯出按鈕樣式 */
        .btn-excel-export {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.88rem;
            border-radius: 30px;
            padding: 8px 20px;
            border: 1px solid rgba(16, 185, 129, 0.4);
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-excel-export:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: #ffffff;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

<div class="app-layout">
<%- include('partials/sidebar', { activePage: 'payroll' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'payroll' }) %>

    <div class="content-body admin-page-content">
        <header class="admin-page-header">
            <div>
                <div class="admin-page-header__main"><span class="admin-page-header__icon"><i class="fa-solid fa-money-check-dollar" aria-hidden="true"></i></span><div class="admin-page-header__content"><h1 class="admin-page-header__title">薪轉管理</h1>
                <p class="admin-page-header__description">工作室員工與陪陪個人隱私薪轉個資清算與累積發放薪資總額核算</p></div></div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <% if (canExportPayouts) { %>
                    <button type="button" class="btn-excel-export" data-bs-toggle="modal" data-bs-target="#payrollExportModal" title="匯出薪轉資料">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>匯出資料</span>
                    </button>
                <% } %>

                <div class="search-box-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                    <input type="text" id="payrollSearchInput" class="search-input-glass" placeholder="搜尋員工暱稱...">
                    <button type="button" id="clearPayrollSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
                </div>
            </div>
        </header>

        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ <%= successMsg %>
            </div>
        <% } %>
        <% if (errorMsg) { %>
            <div class="alert alert-danger py-2 px-3 small mb-4"><%= errorMsg %></div>
        <% } %>

        <% if (canViewPayouts) { %>
            <section class="mb-4 p-3 p-lg-4 rounded-3" style="background: var(--card-bg); border: 1px solid var(--card-border);">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">提款申請</h2>
                        <div class="small text-secondary">僅顯示目前工作室紀錄；已撥款不會再次扣除會員錢包</div>
                    </div>
                    <% if (canMarkPayoutPaid) { %>
                        <button type="button" class="btn btn-sm btn-success" id="batchPaidButton" disabled><i class="fa-solid fa-check-double me-1"></i>批次標記已撥款</button>
                    <% } %>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr>
                            <% if (canMarkPayoutPaid) { %><th><input class="form-check-input" type="checkbox" id="selectAllPending" aria-label="全選待撥款"></th><% } %>
                            <th>提款編號</th><th>員工</th><th class="text-end">金額</th><th>狀態</th><th>薪轉資料</th><th>申請時間</th><th>處理</th>
                        </tr></thead>
                        <tbody>
                            <% if (!payouts.length) { %>
                                <tr><td colspan="8" class="text-center text-secondary py-4">目前沒有提款紀錄</td></tr>
                            <% } %>
                            <% payouts.forEach(payout => { %>
                                <tr>
                                    <% if (canMarkPayoutPaid) { %><td><% if (payout.status === 'pending') { %><input class="form-check-input pending-payout-check" type="checkbox" value="<%= payout.id %>" aria-label="選取 <%= payout.withdrawal_no %>"><% } %></td><% } %>
                                    <td><%= payout.withdrawal_no || `#${payout.id}` %></td>
                                    <td><%= payout.custom_nickname || payout.global_name || payout.username %><div class="text-secondary small"><%= payout.real_name || '' %></div></td>
                                    <td class="text-end">$<%= Number(payout.amount).toLocaleString() %></td>
                                    <td><%= payout.status === 'pending' ? '撥款中' : payout.status === 'paid' ? '已撥款' : payout.status === 'rejected' ? '已退回' : payout.status %></td>
                                    <td>
                                        <% if (canViewSensitive) { %>
                                            <%= payout.bank_name_snapshot || '-' %> <%= payout.bank_code_snapshot || '' %> <%= payout.bank_branch_snapshot || '' %><br>
                                            <%= payout.account_name || '-' %> · <span class="font-monospace"><%= payout.bank_account || '-' %></span>
                                        <% } else { %>敏感資料已遮罩<% } %>
                                    </td>
                                    <td><%= payout.requested_at || '-' %></td>
                                    <td class="text-nowrap">
                                        <% if (payout.status === 'pending' && canMarkPayoutPaid) { %><button class="btn btn-sm btn-outline-success payout-paid-button" data-payout-id="<%= payout.id %>" title="標記已撥款"><i class="fa-solid fa-check"></i></button><% } %>
                                        <% if (payout.status === 'pending' && canRejectPayout) { %><button class="btn btn-sm btn-outline-danger payout-reject-button" data-payout-id="<%= payout.id %>" title="退回申請"><i class="fa-solid fa-rotate-left"></i></button><% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>

        <% if (canViewStaffPayroll) { %>
            <!-- 📊 3. 7 列自訂滾動表格清單組件 -->
            <%- include('partials/payroll_table', { staffList: typeof staffList !== 'undefined' ? staffList : [], canViewSensitive }) %>
        <% } %>
    </div>
</div>
</div>

<%- include('modals/payroll_export_modal', { canExportPayouts, canExportBankAccounts }) %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/payroll-export.js" defer></script>
<script>
    async function payoutPost(path, payload = {}) {
        const response = await fetch(path, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
            body: JSON.stringify(payload)
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || '操作失敗');
        window.location.reload();
    }

    document.querySelectorAll('.payout-paid-button').forEach(button => button.addEventListener('click', async () => {
        if (!window.confirm('確認此提款已完成匯款？系統只會更新提款狀態，不會再次扣款。')) return;
        try { await payoutPost(`/management/payroll/payouts/${button.dataset.payoutId}/paid`); }
        catch (error) { window.alert(error.message); }
    }));

    document.querySelectorAll('.payout-reject-button').forEach(button => button.addEventListener('click', async () => {
        const reason = window.prompt('請填寫退回原因');
        if (!reason || !reason.trim()) return;
        try { await payoutPost(`/management/payroll/payouts/${button.dataset.payoutId}/reject`, { reason }); }
        catch (error) { window.alert(error.message); }
    }));

    const payoutChecks = Array.from(document.querySelectorAll('.pending-payout-check'));
    const batchPaidButton = document.getElementById('batchPaidButton');
    const selectAllPending = document.getElementById('selectAllPending');
    function updateBatchButton() {
        if (batchPaidButton) batchPaidButton.disabled = !payoutChecks.some(check => check.checked);
    }
    payoutChecks.forEach(check => check.addEventListener('change', updateBatchButton));
    selectAllPending?.addEventListener('change', () => {
        payoutChecks.forEach(check => { check.checked = selectAllPending.checked; });
        updateBatchButton();
    });
    batchPaidButton?.addEventListener('click', async () => {
        const payoutIds = payoutChecks.filter(check => check.checked).map(check => Number(check.value));
        if (!payoutIds.length || !window.confirm(`整批標記 ${payoutIds.length} 筆提款已撥款？`)) return;
        try { await payoutPost('/management/payroll/payouts/batch-paid', { payout_ids: payoutIds }); }
        catch (error) { window.alert(error.message); }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('payrollSearchInput');
        const clearBtn = document.getElementById('clearPayrollSearchBtn');
        const rows = document.querySelectorAll('.payroll-row');
        const noMatchRow = document.getElementById('noPayrollMatchRow');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                if (clearBtn) clearBtn.style.display = query.length > 0 ? 'block' : 'none';

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    if (searchData.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchRow) noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    searchInput.value = '';
                    clearBtn.style.display = 'none';
                    rows.forEach(row => row.style.display = '');
                    if (noMatchRow) noMatchRow.style.display = 'none';
                    searchInput.focus();
                });
                document.getElementById('clearPayrollFilterState')?.addEventListener('click', () => clearBtn.click());
            }
        }
    });
</script>
</body>
</html>