<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>機器人指令設定 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/discord-command-deploy-modal.css">
    <style>
        html, body {
            background-color: #0b0914 !important;
            color: #f3f4f6 !important;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        .app-layout {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            min-width: 0;
        }

        .content-body {
            padding: 28px 36px;
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }
    </style>
</head>
<body>

<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'bot-settings' }) %>

    <div class="main-wrapper">
        <%- include('partials/navbar', { activePage: 'bot-settings' }) %>

        <div class="content-body">
            <!-- 頂部標題列 -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <div class="h3 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-robot text-info"></i>
                        <span>Discord 機器人設定</span>
                    </div>
                    <p class="text-secondary small mb-0">顯示 Web Runtime 已載入的指令；Discord 部署需由操作人員明確執行</p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="/system/payout-settings" class="btn btn-outline-light rounded-pill px-3 py-2 small fw-semibold">
                        <i class="fa-solid fa-calendar-days me-1"></i>薪資提款設定
                    </a>
                    <button type="button" class="btn btn-outline-info rounded-pill px-3 py-2 small fw-semibold"
                        data-bs-toggle="modal" data-bs-target="#discordCommandDeployModal"
                        aria-controls="discordCommandDeployModal">
                        <i class="fa-solid fa-terminal me-1" aria-hidden="true"></i>指令部署
                    </button>
                </div>
            </div>

            <%
                // 預設完整的 9 大核心指令資料庫降級預設值 (若後端未傳入時備用)
                const defaultCommands = [
                    { name: '會員充值調帳', command: '/topup (/充值)', minRole: 'admin', desc: '【管理員專用】彈窗輸入實充金額、贈送金與備註原因，自動寫入帳務與重算 VIP' },
                    { name: '發布派單卡片', command: '/dispatch (/派單)', minRole: 'cs', desc: '發布工作室派單訊息至指定頻道，卡片顯示標題與底部廣播 Tag' },
                    { name: '玩家自主註冊', command: '/register', minRole: 'member', desc: '玩家於 Discord 自行綁定與註冊米胡電競會員帳號' },
                    { name: '管理員代註冊', command: '/register-for', minRole: 'cs', desc: '管理員或客服協助特定 Discord 用戶強制建立帳號與資料綁定' },
                    { name: '用戶帳號綁定', command: '/bind', minRole: 'member', desc: '引導 Discord 用戶完成網站與 Discord 身分無縫對接' },
                    { name: '管理員代綁定', command: '/bind-for', minRole: 'cs', desc: '管理員手動協助指定會員進行 Discord 與網站 ID 關聯' },
                    { name: '發布系統公告', command: '/announcement', minRole: 'admin', desc: '發布工作室最新活動與頻道公告，同步於後台 Dashboard 顯示' },
                    { name: '互動陪陪挑選', command: '/select', minRole: 'member', desc: '彈出互動式下拉選單，供闆闆進行特定項目陪陪篩選與點單' },
                    { name: '熱重載指令模組', command: '/reload', minRole: 'manager', desc: '即時重新載入機器人斜線指令與內部參數設定，無需重啟伺服器' }
                ];

                const commandList = Array.isArray(commands) ? commands : [];
            %>

            <% if (syncResult === 'success') { %>
                <div class="alert alert-success py-2 px-3 small mb-3">Discord 斜線指令已同步。</div>
            <% } else if (syncResult === 'partial') { %>
                <div class="alert alert-warning py-2 px-3 small mb-3">
                    <div class="fw-bold">部分 Discord 伺服器同步失敗。</div>
                    <% if (registration && registration.failedGuilds && registration.failedGuilds.length > 0) { %>
                        <ul class="mb-0 mt-2">
                            <% registration.failedGuilds.forEach(failure => { %>
                                <li><%= guildLabels[failure.guildKey] || failure.guildKey %>：<%= failure.errorMessage %> <%= failure.errorCode ? `(Discord ${failure.errorCode})` : '' %></li>
                            <% }) %>
                        </ul>
                    <% } %>
                    <% if (registration && !registration.globalCommandsCleared && registration.globalError) { %>
                        <div class="mt-2">Global 指令清除也失敗：<%= registration.globalError.message %> <%= registration.globalError.code ? `(Discord ${registration.globalError.code})` : '' %></div>
                    <% } %>
                </div>
            <% } else if (syncResult === 'failed') { %>
                <div class="alert alert-warning py-2 px-3 small mb-3">同步失敗：<%= registration && registration.error ? registration.error : '請確認 Bot Token、Application ID 與 Guild 設定。' %></div>
            <% } %>

            <!-- 🚀 模組化：引進 10 則動態滾動表格組件 -->
            <%- include('partials/bot_commands_table', { commands: commandList }) %>

            <%- include('modals/discord_command_deploy_modal', {
                devDeploymentCommand,
                formalDeploymentCommand,
                devGuildConfigured,
                botRuntimeStatus
            }) %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/discord-command-deploy-modal.js" defer></script>
</body>
</html>