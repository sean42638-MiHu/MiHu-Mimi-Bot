<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>員工管理 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --mihu-purple: #9333ea;
            --mihu-purple-light: #c084fc;
            --mihu-yellow: #fde047;
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            min-width: 0;
        }

        .content-body { 
            padding: 20px 36px 32px;
            flex-grow: 1; 
        }

        .search-box-wrap {
            position: relative;
            width: 280px;
            flex-shrink: 0;
        }
        .search-input-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 30px;
            padding: 8px 36px 8px 38px;
            font-size: 0.88rem;
            width: 100%;
            transition: all 0.2s ease;
        }
        .search-input-glass::placeholder { color: #94a3b8 !important; }
        .search-input-glass:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }
        .search-icon-left {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.88rem;
            pointer-events: none;
        }
        .search-clear-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.82rem;
            cursor: pointer;
            display: none;
            border: none;
            background: transparent;
            padding: 0;
        }
        .search-clear-btn:hover { color: #ffffff; }

        .glass-table-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(15px);
        }

        .action-btns-group {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }
        .btn-circle-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            font-size: 0.86rem;
            transition: all 0.2s ease;
        }
        .btn-circle-icon:hover { transform: scale(1.08); }

        .modal-content-glass {
            background: rgba(20, 16, 35, 0.97);
            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
            backdrop-filter: blur(25px);
            color: #fff;
        }
        .form-control-glass {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.92rem;
        }
        .form-control-glass::placeholder {
            color: #94a3b8 !important;
            opacity: 0.85;
        }
        .form-control-glass:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--mihu-purple-light);
            outline: none;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
        }

        .info-detail-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .info-detail-label {
            font-size: 0.74rem;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .info-detail-val {
            font-size: 0.95rem;
            font-weight: 700;
            color: #ffffff;
            font-family: monospace;
        }
    </style>
</head>
<body>

<div class="app-layout">

<!-- 🚀 1. 引入左側欄 (Sidebar) -->
<%- include('partials/sidebar', { activePage: 'staff' }) %>

<div class="main-wrapper">
    <!-- 🚀 2. 引入頂部導覽列 (Navbar) -->
    <%- include('partials/navbar', { activePage: 'staff' }) %>

    <div class="content-body admin-page-content">
        <%- include('partials/admin_page_header', { icon: 'fa-users-gear', title: '員工列表', description: '管理工作室員工與陪玩師身份、分潤抽成及 Discord 工單頻道綁定' }) %>
        <div class="staff-page-toolbar d-flex justify-content-end mb-3">
            <div class="search-box-wrap">
                <i class="fa-solid fa-magnifying-glass search-icon-left"></i>
                <input type="text" id="staffSearchInput" class="search-input-glass" placeholder="搜尋姓名 / 暱稱 / Discord...">
                <button type="button" id="clearSearchBtn" class="search-clear-btn" title="清除搜尋"><i class="fa-solid fa-circle-xmark"></i></button>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small mb-4 border-0 bg-success bg-opacity-25 text-success">
                ✅ 員工狀態、職位與抽佣已成功更新！
            </div>
        <% } %>

        <!-- 📊 3. 獨立模組：員工清單表格 -->
        <%- include('partials/staff_table', { staffList: typeof staffList !== 'undefined' ? staffList : [], userPerms: typeof userPerms !== 'undefined' ? userPerms : [], currentUser: typeof currentUser !== 'undefined' ? currentUser : null }) %>
    </div>
</div>
</div>

<!-- 🚀 4. 獨立模組：員工相關 Modal 群組 -->
<%- include('modals/staff_modals') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const roleBadgeConfig = Object.freeze(<%- JSON.stringify({
            classMap: typeof roleBadgeClassMap !== 'undefined' ? roleBadgeClassMap : {},
            inlineStyleMap: typeof roleBadgeInlineStyleMap !== 'undefined' ? roleBadgeInlineStyleMap : {},
            defaultInlineStyle: typeof roleBadgeDefaultInlineStyle !== 'undefined' ? roleBadgeDefaultInlineStyle : ''
        }).replace(/</g, "\\u003c") %>);
        const ROLE_BADGE_CLASS_MAP = Object.freeze(roleBadgeConfig.classMap || {});
        const ROLE_BADGE_INLINE_STYLE_MAP = Object.freeze(roleBadgeConfig.inlineStyleMap || {});
        const ROLE_BADGE_DEFAULT_INLINE_STYLE = String(roleBadgeConfig.defaultInlineStyle || '');
        const DEFAULT_ROLE_BADGE_CLASS = 'role-badge role-badge-default';

        function resolveRoleBadgeClass(roleKey) {
            const key = String(roleKey || '').trim().toLowerCase();
            return ROLE_BADGE_CLASS_MAP[key] || DEFAULT_ROLE_BADGE_CLASS;
        }

        function resolveRoleBadgeInlineStyle(roleKey) {
            const key = String(roleKey || '').trim().toLowerCase();
            return ROLE_BADGE_INLINE_STYLE_MAP[key] || ROLE_BADGE_DEFAULT_INLINE_STYLE;
        }

        function applyRoleBadge(element, roleKey, roleName) {
            if (!element) return;
            element.className = resolveRoleBadgeClass(roleKey);
            element.setAttribute('style', resolveRoleBadgeInlineStyle(roleKey));
            const safeName = String(roleName || '會員');
            element.textContent = safeName;
            element.title = safeName;
        }

        const staffDetailModal = new bootstrap.Modal(document.getElementById('staffDetailModal'));
        const staffEditModal = new bootstrap.Modal(document.getElementById('staffEditModal'));
        const staffDetailModalElement = document.getElementById('staffDetailModal');
        const sensitiveVerifyModalElement = document.getElementById('sensitiveDataVerifyModal');
        const sensitiveVerifyModal = sensitiveVerifyModalElement
            ? bootstrap.Modal.getOrCreateInstance(sensitiveVerifyModalElement)
            : null;
        const sensitiveVerifyCodeInput = document.getElementById('sensitiveVerifyCode');
        const sensitiveVerifyMessage = document.getElementById('sensitiveDataVerifyMessage');
        const sensitiveVerifyError = document.getElementById('sensitiveVerifyError');
        const sendSensitiveVerifyCodeBtn = document.getElementById('sendSensitiveVerifyCodeBtn');
        const confirmVerifyBtn = document.getElementById('confirmVerifyBtn');
        const cancelSensitiveVerifyBtn = document.getElementById('cancelSensitiveVerifyBtn');
        const unlockSensitiveDataBtn = document.getElementById('unlockSensitiveDataBtn');
        const sensitiveUnlockStatus = document.getElementById('sensitiveUnlockStatus');
        const sensitiveVerificationEmail = <%- JSON.stringify(currentUser && currentUser.email_verified ? String(currentUser.email || '') : '').replace(/</g, "\\u003c") %>;
        const hasSensitiveVerificationEmail = String(sensitiveVerificationEmail || '').includes('@');
        let currentDetailStaff = null;
        let sensitiveRequestController = null;
        let sensitiveRequestId = 0;
        let detailViewGeneration = 0;
        let detailViewActive = false;
        let sensitiveUnlocked = false;
        let pendingSensitiveVerification = null;

        function getCsrfTokenFromCookie() {
            const cookie = String(document.cookie || '').split(';').map(item => item.trim()).find(item => item.startsWith('csrf_token='));
            return cookie ? decodeURIComponent(cookie.slice('csrf_token='.length)) : '';
        }

        function maskSensitiveFields() {
            const realNameEl = document.getElementById('detailRealName');
            if (!realNameEl) return;
            realNameEl.textContent = '限制查看';
            document.getElementById('detailBankName').textContent = '限制查看';
            document.getElementById('detailBankCode').textContent = '限制查看';
            document.getElementById('detailBankBranch').textContent = '限制查看';
            document.getElementById('detailBankAccount').textContent = '限制查看';
        }

        function isCurrentDetailView(staffId, generation) {
            return Boolean(
                detailViewActive
                && staffDetailModalElement
                && staffDetailModalElement.classList.contains('show')
                && currentDetailStaff
                && currentDetailStaff.id === staffId
                && detailViewGeneration === generation
            );
        }

        function setUnlockButtonLockedState() {
            if (!unlockSensitiveDataBtn) return;
            unlockSensitiveDataBtn.hidden = false;
            unlockSensitiveDataBtn.disabled = false;
            unlockSensitiveDataBtn.classList.remove('btn-success');
            unlockSensitiveDataBtn.classList.add('btn-outline-warning');
            unlockSensitiveDataBtn.innerHTML = '<i class="fa-solid fa-eye me-1"></i>解鎖查看敏感資料';
        }

        function setUnlockButtonUnlockedState() {
            if (!unlockSensitiveDataBtn) return;
            unlockSensitiveDataBtn.hidden = false;
            unlockSensitiveDataBtn.disabled = true;
            unlockSensitiveDataBtn.classList.remove('btn-outline-warning');
            unlockSensitiveDataBtn.classList.add('btn-success');
            unlockSensitiveDataBtn.textContent = '🔒 敏感資料已解鎖';
        }

        function setSensitiveVerifyError(message) {
            if (!sensitiveVerifyError) return;
            const text = String(message || '').trim();
            sensitiveVerifyError.textContent = text;
            sensitiveVerifyError.hidden = !text;
        }

        function maskEmail(email) {
            const value = String(email || '').trim();
            const at = value.indexOf('@');
            if (at <= 1) return value;
            const local = value.slice(0, at);
            const domain = value.slice(at + 1);
            const maskedLocal = `${local.slice(0, 1)}${'*'.repeat(Math.max(local.length - 2, 1))}${local.slice(-1)}`;
            return `${maskedLocal}@${domain}`;
        }

        function clearSensitiveVerifyState() {
            if (sensitiveVerifyCodeInput) sensitiveVerifyCodeInput.value = '';
            setSensitiveVerifyError('');
            if (sendSensitiveVerifyCodeBtn) sendSensitiveVerifyCodeBtn.disabled = false;
            if (confirmVerifyBtn) confirmVerifyBtn.disabled = false;
            if (cancelSensitiveVerifyBtn) cancelSensitiveVerifyBtn.disabled = false;
        }

        function markSensitiveVerifyBackdrop() {
            const backdrops = document.querySelectorAll('.modal-backdrop');
            const latest = backdrops[backdrops.length - 1];
            if (!latest) return;
            latest.classList.add('sensitive-verify-backdrop');
            document.body.classList.add('sensitive-verify-open');
        }

        function clearSensitiveVerifyBackdrop() {
            document.querySelectorAll('.modal-backdrop.sensitive-verify-backdrop').forEach(backdrop => {
                backdrop.classList.remove('sensitive-verify-backdrop');
            });
            document.body.classList.remove('sensitive-verify-open');
        }

        function trapSensitiveVerifyTabFocus(event) {
            if (!sensitiveVerifyModalElement || event.key !== 'Tab') return;
            const focusableSelector = [
                'button:not([disabled])',
                'input:not([disabled])',
                'select:not([disabled])',
                'textarea:not([disabled])',
                '[href]',
                '[tabindex]:not([tabindex="-1"])'
            ].join(',');
            const focusable = [...sensitiveVerifyModalElement.querySelectorAll(focusableSelector)]
                .filter(node => !node.hasAttribute('hidden') && node.tabIndex !== -1);
            if (focusable.length < 1) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey) {
                if (document.activeElement === first || !sensitiveVerifyModalElement.contains(document.activeElement)) {
                    event.preventDefault();
                    last.focus();
                }
                return;
            }

            if (document.activeElement === last || !sensitiveVerifyModalElement.contains(document.activeElement)) {
                event.preventDefault();
                first.focus();
            }
        }

        function resetSensitiveView(options = {}) {
            const { invalidate = false, clearTarget = false } = options;
            if (invalidate) detailViewGeneration += 1;
            sensitiveUnlocked = false;
            pendingSensitiveVerification = null;
            if (sensitiveRequestController) {
                sensitiveRequestController.abort();
                sensitiveRequestController = null;
            }
            sensitiveRequestId += 1;
            maskSensitiveFields();
            setUnlockButtonLockedState();
            if (sensitiveUnlockStatus) {
                sensitiveUnlockStatus.textContent = '尚未解鎖';
                sensitiveUnlockStatus.classList.remove('text-success');
                sensitiveUnlockStatus.classList.add('text-secondary');
            }
            clearSensitiveVerifyState();
            clearSensitiveVerifyBackdrop();
            if (sensitiveVerifyModalElement && sensitiveVerifyModalElement.classList.contains('show') && sensitiveVerifyModal) {
                sensitiveVerifyModal.hide();
            }
            if (clearTarget) currentDetailStaff = null;
        }

        async function unlockSensitiveData() {
            if (!currentDetailStaff || !unlockSensitiveDataBtn) return;
            if (sensitiveUnlocked) return;
            const staffId = currentDetailStaff.id;
            const generation = detailViewGeneration;
            const displayName = currentDetailStaff.displayName || currentDetailStaff.username || String(staffId);
            if (!isCurrentDetailView(staffId, generation)) return;

            pendingSensitiveVerification = { staffId, generation, displayName };
            clearSensitiveVerifyState();
            if (sensitiveVerifyMessage) {
                const targetEmailText = hasSensitiveVerificationEmail
                    ? `驗證碼將寄送至 ${maskEmail(sensitiveVerificationEmail)}。`
                    : '尚未設定或驗證 Email，無法進行敏感資料驗證。';
                sensitiveVerifyMessage.textContent = `即將查看員工${displayName}的本名與薪轉帳戶資料。本次查看將記錄於系統日誌。${targetEmailText}`;
            }
            if (sensitiveUnlockStatus) {
                sensitiveUnlockStatus.textContent = '等待驗證...';
                sensitiveUnlockStatus.classList.remove('text-success');
                sensitiveUnlockStatus.classList.add('text-secondary');
            }
            if (confirmVerifyBtn) confirmVerifyBtn.disabled = !hasSensitiveVerificationEmail;
            if (sendSensitiveVerifyCodeBtn) sendSensitiveVerifyCodeBtn.disabled = !hasSensitiveVerificationEmail;
            if (!hasSensitiveVerificationEmail) {
                setSensitiveVerifyError('請先在個人檔案完成 Email 驗證後，再查看敏感資料。');
            }
            if (sensitiveVerifyModal) {
                sensitiveVerifyModal.show();
            }
        }

        async function sendSensitiveVerifyCode() {
            if (!pendingSensitiveVerification || !hasSensitiveVerificationEmail) {
                setSensitiveVerifyError('請先在個人檔案完成 Email 驗證後，再查看敏感資料。');
                return;
            }
            if (sendSensitiveVerifyCodeBtn) sendSensitiveVerifyCodeBtn.disabled = true;
            setSensitiveVerifyError('');
            try {
                const response = await fetch('/api/email/send-code', {
                    method: 'POST',
                    headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCsrfTokenFromCookie()
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        email: sensitiveVerificationEmail,
                        purpose: 'staff_sensitive_view',
                        targetStaffId: pendingSensitiveVerification.staffId
                    })
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.success) {
                    throw new Error(result.message || '驗證碼寄送失敗');
                }
                if (sensitiveUnlockStatus && pendingSensitiveVerification) {
                    sensitiveUnlockStatus.textContent = '驗證碼已寄送，請完成輸入';
                    sensitiveUnlockStatus.classList.remove('text-success');
                    sensitiveUnlockStatus.classList.add('text-secondary');
                }
                if (sensitiveVerifyCodeInput) sensitiveVerifyCodeInput.focus();
            } catch (error) {
                const failureMessage = error && error.message ? String(error.message) : '驗證碼寄送失敗，請稍後再試';
                setSensitiveVerifyError(failureMessage);
            } finally {
                if (sendSensitiveVerifyCodeBtn && pendingSensitiveVerification) {
                    sendSensitiveVerifyCodeBtn.disabled = false;
                }
            }
        }

        async function confirmSensitiveDataVerification() {
            if (!pendingSensitiveVerification || !unlockSensitiveDataBtn) return;
            const { staffId, generation } = pendingSensitiveVerification;
            if (!isCurrentDetailView(staffId, generation)) return;

            const verifyCode = String(sensitiveVerifyCodeInput && sensitiveVerifyCodeInput.value || '').trim();
            if (!/^\d{6}$/.test(verifyCode)) {
                setSensitiveVerifyError('請輸入 6 位數 Email 驗證碼。');
                if (sensitiveVerifyCodeInput) sensitiveVerifyCodeInput.focus();
                return;
            }
            if (!hasSensitiveVerificationEmail) {
                setSensitiveVerifyError('請先在個人檔案完成 Email 驗證後，再查看敏感資料。');
                return;
            }

            const requestId = ++sensitiveRequestId;
            if (sensitiveRequestController) sensitiveRequestController.abort();
            sensitiveRequestController = new AbortController();
            unlockSensitiveDataBtn.disabled = true;
            if (sendSensitiveVerifyCodeBtn) sendSensitiveVerifyCodeBtn.disabled = true;
            if (confirmVerifyBtn) confirmVerifyBtn.disabled = true;
            if (cancelSensitiveVerifyBtn) cancelSensitiveVerifyBtn.disabled = true;
            setSensitiveVerifyError('');
            if (sensitiveUnlockStatus) {
                sensitiveUnlockStatus.textContent = '資料解鎖中...';
                sensitiveUnlockStatus.classList.remove('text-success');
                sensitiveUnlockStatus.classList.add('text-secondary');
            }

            try {
                const verificationResponse = await fetch('/api/email/verify-code', {
                    method: 'POST',
                    headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCsrfTokenFromCookie()
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        email: sensitiveVerificationEmail,
                        code: verifyCode,
                        purpose: 'staff_sensitive_view',
                        targetStaffId: staffId
                    }),
                    signal: sensitiveRequestController.signal
                });
                const verificationResult = await verificationResponse.json().catch(() => ({}));
                if (requestId !== sensitiveRequestId || !isCurrentDetailView(staffId, generation)) return;
                if (!verificationResponse.ok || !verificationResult.success) {
                    throw new Error(verificationResult.message || '驗證碼錯誤，請重新輸入');
                }

                const response = await fetch(`/management/staff/${encodeURIComponent(String(staffId))}/sensitive-data`, {
                    method: 'POST',
                    headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCsrfTokenFromCookie()
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({ confirmSensitiveView: true }),
                    signal: sensitiveRequestController.signal
                });
                const result = await response.json().catch(() => ({}));
                if (requestId !== sensitiveRequestId || !isCurrentDetailView(staffId, generation)) return;

                if (!response.ok || !result.success || !result.data) {
                    throw new Error(result.message || '敏感資料載入失敗');
                }

                document.getElementById('detailRealName').textContent = result.data.realName || '未填寫';
                document.getElementById('detailBankName').textContent = result.data.bankName || '未填寫';
                document.getElementById('detailBankCode').textContent = result.data.bankCode || '未填寫';
                document.getElementById('detailBankBranch').textContent = result.data.bankBranch || '未填寫';
                document.getElementById('detailBankAccount').textContent = result.data.bankAccount || '未填寫';
                sensitiveUnlocked = true;
                pendingSensitiveVerification = null;
                setUnlockButtonUnlockedState();
                if (sensitiveUnlockStatus) {
                    sensitiveUnlockStatus.textContent = '已解鎖（僅限本次檢視）';
                    sensitiveUnlockStatus.classList.remove('text-secondary');
                    sensitiveUnlockStatus.classList.add('text-success');
                }
                if (sensitiveVerifyModal) sensitiveVerifyModal.hide();
            } catch (error) {
                if (error && error.name === 'AbortError') return;
                if (!isCurrentDetailView(staffId, generation)) return;
                maskSensitiveFields();
                setUnlockButtonLockedState();
                const failureMessage = error && error.message ? String(error.message) : '解鎖失敗，請稍後再試';
                setSensitiveVerifyError(failureMessage);
                if (sensitiveUnlockStatus) {
                    sensitiveUnlockStatus.textContent = '驗證失敗，仍維持遮蔽';
                    sensitiveUnlockStatus.classList.remove('text-success');
                    sensitiveUnlockStatus.classList.add('text-secondary');
                }
            } finally {
                if (requestId === sensitiveRequestId && isCurrentDetailView(staffId, generation) && unlockSensitiveDataBtn) {
                    unlockSensitiveDataBtn.disabled = sensitiveUnlocked;
                }
                if (requestId === sensitiveRequestId && pendingSensitiveVerification && isCurrentDetailView(staffId, generation) && sendSensitiveVerifyCodeBtn) {
                    sendSensitiveVerifyCodeBtn.disabled = false;
                }
                if (requestId === sensitiveRequestId && pendingSensitiveVerification && isCurrentDetailView(staffId, generation)) {
                    if (confirmVerifyBtn) confirmVerifyBtn.disabled = false;
                    if (cancelSensitiveVerifyBtn) cancelSensitiveVerifyBtn.disabled = false;
                }
            }
        }

        function showStaffDetail(data) {
            detailViewGeneration += 1;
            detailViewActive = true;
            currentDetailStaff = data;
            resetSensitiveView();
            document.getElementById('detailAvatar').src = data.avatar;
            document.getElementById('detailDisplayName').textContent = data.displayName;
            const detailRoleBadge = document.getElementById('detailRoleBadge');
            applyRoleBadge(detailRoleBadge, data.role, data.roleName || '陪陪');
            document.getElementById('detailStatusBadge').textContent = data.statusName;
            document.getElementById('detailUsername').textContent = `@${data.username}`;
            document.getElementById('detailId').textContent = `ID: ${data.id}`;
            
            document.getElementById('detailRate').textContent = data.commissionRate !== null 
                ? `${(Number(data.commissionRate) * 100).toFixed(0)}% (個人特例)` 
                : '工作室預設';
                
            document.getElementById('detailOrders').textContent = `${data.totalOrders} 單`;
            document.getElementById('detailRevenue').textContent = `$${Number(data.totalRevenue).toLocaleString()}`;
            document.getElementById('detailBirthday').textContent = data.birthday;
            document.getElementById('detailGender').textContent = data.gender;
            document.getElementById('detailMbti').textContent = data.mbti;
            document.getElementById('detailChannel').textContent = data.staffChannelId || '未綁定';
            maskSensitiveFields();

            staffDetailModal.show();
        }

        function showStaffEdit(data) {
            document.getElementById('staffEditForm').action = `/management/staff/update/${data.id}`;
            document.getElementById('editTargetName').textContent = data.displayName;
            const roleSelect = document.getElementById('editRole');
            if (Array.from(roleSelect.options).some(option => option.value === data.role)) {
                roleSelect.value = data.role;
            } else {
                roleSelect.options[0].textContent = `${data.roleName}（目前職位，無法指派）`;
                roleSelect.value = '';
            }
            document.getElementById('editStatus').value = data.status;
            
            document.getElementById('editRate').value = (data.commissionRate !== null && data.commissionRate !== undefined) ? data.commissionRate : '';
            document.getElementById('editChannel').value = data.staffChannelId || '';

            staffEditModal.show();
        }

        const rows = document.querySelectorAll('.staff-row');
        const searchInput = document.getElementById('staffSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const noMatchRow = document.getElementById('noMatchRow');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                if (query.length > 0) {
                    clearBtn.style.display = 'block';
                } else {
                    clearBtn.style.display = 'none';
                }

                rows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    if (searchData.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchRow) {
                    noMatchRow.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            });

            clearBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearBtn.style.display = 'none';
                rows.forEach(row => row.style.display = '');
                if (noMatchRow) noMatchRow.style.display = 'none';
                searchInput.focus();
            });

            document.getElementById('clearStaffFilterState')?.addEventListener('click', () => clearBtn.click());
        }

        if (unlockSensitiveDataBtn) {
            unlockSensitiveDataBtn.addEventListener('click', event => {
                event.preventDefault();
                unlockSensitiveData();
            });
        }

        if (confirmVerifyBtn) {
            confirmVerifyBtn.addEventListener('click', event => {
                event.preventDefault();
                confirmSensitiveDataVerification();
            });
        }

        if (sendSensitiveVerifyCodeBtn) {
            sendSensitiveVerifyCodeBtn.addEventListener('click', event => {
                event.preventDefault();
                sendSensitiveVerifyCode();
            });
        }

        if (sensitiveVerifyCodeInput) {
            sensitiveVerifyCodeInput.addEventListener('input', () => {
                if (!sensitiveVerifyCodeInput) return;
                const normalized = String(sensitiveVerifyCodeInput.value || '').replace(/[^0-9]/g, '').slice(0, 6);
                if (sensitiveVerifyCodeInput.value !== normalized) sensitiveVerifyCodeInput.value = normalized;
            });
            sensitiveVerifyCodeInput.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    confirmSensitiveDataVerification();
                }
            });
        }

        if (sensitiveVerifyModalElement) {
            sensitiveVerifyModalElement.addEventListener('keydown', trapSensitiveVerifyTabFocus);
            sensitiveVerifyModalElement.addEventListener('shown.bs.modal', () => {
                markSensitiveVerifyBackdrop();
                if (staffDetailModalElement) staffDetailModalElement.setAttribute('inert', '');
                setTimeout(() => {
                    if (sensitiveVerifyCodeInput) sensitiveVerifyCodeInput.focus();
                }, 0);
            });

            sensitiveVerifyModalElement.addEventListener('hidden.bs.modal', () => {
                clearSensitiveVerifyState();
                clearSensitiveVerifyBackdrop();
                if (staffDetailModalElement) staffDetailModalElement.removeAttribute('inert');
                if (detailViewActive && staffDetailModalElement && staffDetailModalElement.classList.contains('show')) {
                    document.body.classList.add('modal-open');
                }
                if (!sensitiveUnlocked) pendingSensitiveVerification = null;
                if (!sensitiveUnlocked && sensitiveUnlockStatus && detailViewActive && staffDetailModalElement && staffDetailModalElement.classList.contains('show')) {
                    sensitiveUnlockStatus.textContent = '尚未解鎖';
                    sensitiveUnlockStatus.classList.remove('text-success');
                    sensitiveUnlockStatus.classList.add('text-secondary');
                }
                if (detailViewActive && staffDetailModalElement && staffDetailModalElement.classList.contains('show') && unlockSensitiveDataBtn) {
                    setTimeout(() => {
                        unlockSensitiveDataBtn.focus();
                        if (typeof requestAnimationFrame === 'function') {
                            requestAnimationFrame(() => unlockSensitiveDataBtn.focus());
                        }
                    }, 0);
                }
            });
        }

        if (staffDetailModalElement) {
            staffDetailModalElement.addEventListener('hide.bs.modal', () => {
                detailViewActive = false;
                resetSensitiveView({ invalidate: true });
            });
            staffDetailModalElement.addEventListener('hidden.bs.modal', () => {
                resetSensitiveView({ clearTarget: true });
                if (!document.querySelector('.modal.show')) {
                    document.body.classList.remove('modal-open');
                    document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                }
            });
        }

        window.addEventListener('pagehide', () => {
            detailViewActive = false;
            resetSensitiveView({ invalidate: true, clearTarget: true });
        });

        window.addEventListener('mihu:protected-page-reset', () => {
            detailViewActive = false;
            resetSensitiveView({ invalidate: true, clearTarget: true });
        });

        rows.forEach(row => {
            const data = JSON.parse(row.getAttribute('data-staff'));

            row.addEventListener('click', () => {
                showStaffDetail(data);
            });

            const detailBtn = row.querySelector('.btn-detail-trigger');
            if (detailBtn) {
                detailBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showStaffDetail(data);
                });
            }

            const editBtn = row.querySelector('.btn-edit-trigger');
            if (editBtn) {
                editBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    showStaffEdit(data);
                });
            }
        });
    });
</script>
</body>
</html>
