<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>薪資設定 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/salary-settings.css">
    <link rel="stylesheet" href="/css/cyberpunk.css">
</head>
<body class="mihu-admin-page text-light salary-settings-page">
<div class="app-layout">
<%- include('partials/sidebar', { activePage: 'salary_settings' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'salary_settings' }) %>

    <div class="content-body admin-page-content salary-settings-container">
        <% const canSalaryAdjust = typeof hasPerm === 'function' ? hasPerm('action_salary_adjust') : userPerms.includes('*') || userPerms.includes('action_salary_adjust'); %>
        <% const canSalaryRuleManage = typeof hasPerm === 'function' ? hasPerm('action_salary_rule_manage') : userPerms.includes('*') || userPerms.includes('action_salary_rule_manage'); %>
        <% const canSalaryDistribute = typeof hasPerm === 'function' ? hasPerm('action_salary_distribute') : userPerms.includes('*') || userPerms.includes('action_salary_distribute'); %>
        <% const canSalaryImport = typeof hasPerm === 'function' ? hasPerm('action_salary_import') : userPerms.includes('*') || userPerms.includes('action_salary_import'); %>
        <% const adjustState = formState && formState.adjust ? formState.adjust : {}; %>
        <% const ruleState = formState && formState.rule ? formState.rule : {}; %>
        <% const distributeState = formState && formState.distribute ? formState.distribute : {}; %>
        <% const importState = formState && formState.import ? formState.import : {}; %>
        <% const distStatus = distributionStatus || { locked: false, totalRules: 0, pendingRules: 0, committedRules: 0, message: '尚未載入派發狀態' }; %>
        <% const roleNameMap = { admin: '店長', owner: '負責人', cfo: '財務長', aftersales: '售後管理', after_sales: '售後管理', manager: '客服主管', cs_director: '客服主管', cs: '客服', reviewer: '審核', talent: '陪陪', staff: '陪陪', member: '會員' }; %>
        <% const roleBadgeMap = { admin: 'role-badge role-badge-admin', owner: 'role-badge role-badge-owner', cfo: 'role-badge role-badge-cfo', aftersales: 'role-badge role-badge-aftersales', after_sales: 'role-badge role-badge-aftersales', manager: 'role-badge role-badge-manager', cs_director: 'role-badge role-badge-manager', cs: 'role-badge role-badge-cs', reviewer: 'role-badge role-badge-reviewer', talent: 'role-badge role-badge-talent', staff: 'role-badge role-badge-talent', member: 'role-badge role-badge-member' }; %>
        <% const salaryHeaderActions = `
            <div class="page-header-action salary-toolbar-actions salary-top-toolbar" role="group" aria-label="薪資設定工具列">
                <button type="button" class="btn salary-tool-btn btn-cyber-primary" data-bs-toggle="modal" data-bs-target="#adjustSalaryModal" ${canSalaryAdjust ? '' : 'disabled aria-disabled="true" title="缺少手動調整權限"'}><i class="fa-solid fa-plus me-1"></i>新增薪資調整</button>
                <button type="button" class="btn salary-tool-btn btn-cyber-secondary" data-bs-toggle="modal" data-bs-target="#monthlySalaryRulesModal" ${canSalaryRuleManage ? '' : 'disabled aria-disabled="true" title="缺少固定月薪規則權限"'}><i class="fa-solid fa-gear me-1"></i>固定月薪設定</button>
                <button type="button" class="btn salary-tool-btn btn-cyber-success" data-bs-toggle="modal" data-bs-target="#distributeBaseSalaryModal" ${canSalaryDistribute ? '' : 'disabled aria-disabled="true" title="缺少派發權限"'}><i class="fa-solid fa-paper-plane me-1"></i>派發本月底薪</button>
                <button type="button" class="btn salary-tool-btn btn-cyber-warning" data-bs-toggle="modal" data-bs-target="#batchImportSalaryModal" ${canSalaryImport ? '' : 'disabled aria-disabled="true" title="缺少匯入權限"'}><i class="fa-solid fa-file-import me-1"></i>CSV / XLSX 匯入</button>
            </div>
        `; %>
        <%- include('partials/admin_page_header', {
            icon: 'fa-money-bill-transfer',
            title: '薪資設定與底薪規則管理',
            description: '管控員工初次匯入帳目、每月固定底薪派發規則與薪資手動微調',
            actions: salaryHeaderActions
        }) %>

        <% if (successMsg) { %><div class="alert alert-success"><%= successMsg %></div><% } %>
        <% if (errorMsg) { %><div class="alert alert-danger"><%= errorMsg %></div><% } %>

        <%- include('partials/salary_settings_overview_card', {
            month,
            totalStaff,
            pageSize,
            page,
            totalPages,
            search,
            salaryRows,
            distStatus,
            recentAdjustments,
            canSalaryAdjust,
            canSalaryRuleManage,
            canSalaryDistribute,
            canSalaryImport,
            roleNameMap,
            roleBadgeMap
        }) %>
        <%- include('partials/salary_settings_modals', {
            csrfToken,
            adjustState,
            ruleState,
            distributeState,
            importState,
            errorMsg,
            month,
            roles,
            ruleRecords,
            distStatus
        }) %>
    </div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const hasImportPreview = <%= Boolean(importState.result || importState.previewToken) %>;
    const hasAdjustmentState = <%= Object.keys(adjustState).length > 0 %>;
    const hasRuleState = <%= Object.keys(ruleState).length > 0 %>;
    const hasDistributionState = <%= Object.keys(distributeState).length > 0 %>;
    const initialAdjustState = <%- JSON.stringify(adjustState || {}) %>;
    const distributionLocked = <%= Boolean(distStatus.locked) %>;

    function openModal(id) {
        const element = document.getElementById(id);
        if (element && window.bootstrap) bootstrap.Modal.getOrCreateInstance(element).show();
    }

    const salaryModalFocusRestore = new WeakMap();
    document.querySelectorAll('.salary-modal').forEach(modal => {
        modal.addEventListener('show.bs.modal', () => {
            const active = document.activeElement;
            salaryModalFocusRestore.set(modal, active instanceof HTMLElement ? active : null);
        });

        modal.addEventListener('shown.bs.modal', () => {
            const focusTarget = modal.querySelector('button:not([disabled]):not([tabindex="-1"]), [href], input:not([disabled]):not([type="hidden"]):not([tabindex="-1"]), select:not([disabled]):not([tabindex="-1"]), textarea:not([disabled]):not([tabindex="-1"]), [tabindex]:not([tabindex="-1"])');
            if (focusTarget instanceof HTMLElement) {
                focusTarget.focus();
            } else if (modal instanceof HTMLElement) {
                modal.focus();
            }
        });

        modal.addEventListener('hidden.bs.modal', () => {
            const restoreTarget = salaryModalFocusRestore.get(modal);
            if (restoreTarget instanceof HTMLElement && document.contains(restoreTarget)) {
                restoreTarget.focus();
            }
        });
    });

    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const openedModal = document.querySelector('.salary-modal.show');
        if (!openedModal || !window.bootstrap) return;
        event.preventDefault();
        const instance = window.bootstrap.Modal.getOrCreateInstance(openedModal);
        if (instance) instance.hide();
    }, true);

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    async function postJson(url, payload, signal) {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            },
            body: JSON.stringify(payload),
            signal
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.message || '操作失敗');
        return data;
    }

    async function getJson(url, signal) {
        const response = await fetch(url, {
            method: 'GET',
            headers: { Accept: 'application/json' },
            signal
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.message || '操作失敗');
        return data;
    }

    function toCurrency(value) {
        return Number(value || 0).toLocaleString();
    }

    function formatSignedAmount(value) {
        const numeric = Number(value || 0);
        const sign = numeric > 0 ? '+' : '';
        return `${sign}${numeric.toLocaleString()}`;
    }

    const adjustForm = document.getElementById('salaryAdjustForm');
    const adjustSearchInput = document.getElementById('adjustStaffSearch');
    const adjustUserIdInput = document.getElementById('adjustUserId');
    const adjustModeInput = document.getElementById('adjustMode');
    const adjustAmountInput = document.getElementById('adjustAmount');
    const adjustReasonInput = document.getElementById('adjustReason');
    const adjustPreviewButton = document.getElementById('previewAdjustButton');
    const adjustExecuteButton = document.getElementById('executeAdjustButton');
    const adjustPreview = document.getElementById('adjustPreview');
    const adjustPreviewToken = document.getElementById('adjustPreviewToken');
    const adjustRequestId = document.getElementById('adjustRequestId');
    const adjustStaffStatus = document.getElementById('adjustStaffStatus');
    const adjustStaffResults = document.getElementById('adjustStaffResults');
    const adjustSelectedCard = document.getElementById('adjustSelectedCard');
    const adjustSelectedAvatar = document.getElementById('adjustSelectedAvatar');
    const adjustSelectedName = document.getElementById('adjustSelectedName');
    const adjustSelectedSub = document.getElementById('adjustSelectedSub');
    const adjustSelectedSummary = document.getElementById('adjustSelectedSummary');
    const adjustClearSelectionButton = document.getElementById('adjustClearSelection');

    let adjustmentPreviewCurrent = false;
    let selectedStaff = null;
    let searchTimer = null;
    let searchRequestIndex = 0;
    let searchController = null;
    let snapshotRequestIndex = 0;
    let snapshotController = null;
    let searchResults = [];
    let activeSearchIndex = -1;

    function hideSearchResults() {
        searchResults = [];
        activeSearchIndex = -1;
        if (adjustStaffResults) {
            adjustStaffResults.hidden = true;
            adjustStaffResults.innerHTML = '';
        }
    }

    function invalidateAdjustmentPreview() {
        adjustmentPreviewCurrent = false;
        if (adjustPreviewToken) adjustPreviewToken.value = '';
        if (adjustRequestId) adjustRequestId.value = '';
        if (adjustPreview) {
            adjustPreview.hidden = true;
            adjustPreview.textContent = '';
        }
        syncAdjustmentSubmitState();
    }

    function hasValidAmountInput() {
        const value = String(adjustAmountInput && adjustAmountInput.value || '').trim();
        return /^[+-]?\d+(?:\.\d{1,2})?$/.test(value) && Number(value) !== 0;
    }

    function syncAdjustmentSubmitState() {
        if (!adjustPreviewButton || !adjustExecuteButton) return;
        const hasSelectedUser = Boolean(adjustUserIdInput && String(adjustUserIdInput.value || '').trim());
        const hasReason = Boolean(String(adjustReasonInput && adjustReasonInput.value || '').trim());
        const canPreview = hasSelectedUser && hasReason && hasValidAmountInput();
        adjustPreviewButton.disabled = !canPreview;
        adjustExecuteButton.disabled = !(canPreview && adjustmentPreviewCurrent && adjustPreviewToken && adjustPreviewToken.value);
    }

    function renderSelectedStaff(snapshot, fallbackMeta) {
        if (!adjustSelectedCard || !adjustUserIdInput) return;
        selectedStaff = {
            userId: snapshot.userId,
            displayName: snapshot.displayName,
            roleName: snapshot.roleName || (fallbackMeta && fallbackMeta.roleName) || String(snapshot.role || ''),
            roleBadgeClass: snapshot.roleBadgeClass || (fallbackMeta && fallbackMeta.roleBadgeClass) || 'role-badge role-badge-member',
            avatarUrl: snapshot.avatarUrl || (fallbackMeta && fallbackMeta.avatarUrl) || '/images/default-avatar.png',
            availableAmount: Number(snapshot.availableAmount || 0),
            totalEarned: Number(snapshot.totalEarned || 0),
            pendingAmount: Number(snapshot.pendingAmount || 0)
        };
        adjustUserIdInput.value = selectedStaff.userId;
        adjustSelectedCard.hidden = false;
        if (adjustSelectedAvatar) adjustSelectedAvatar.src = selectedStaff.avatarUrl;
        if (adjustSelectedName) adjustSelectedName.textContent = selectedStaff.displayName;
        if (adjustSelectedSub) {
            adjustSelectedSub.innerHTML = '';
            const idSpan = document.createElement('span');
            idSpan.textContent = selectedStaff.userId;
            const roleSpan = document.createElement('span');
            roleSpan.className = selectedStaff.roleBadgeClass;
            roleSpan.textContent = selectedStaff.roleName;
            adjustSelectedSub.append(idSpan, roleSpan);
        }
        if (adjustSelectedSummary) {
            adjustSelectedSummary.textContent = `可提領：$${toCurrency(selectedStaff.availableAmount)}｜歷史收入：$${toCurrency(selectedStaff.totalEarned)}｜待請款：$${toCurrency(selectedStaff.pendingAmount)}`;
        }
        if (adjustStaffStatus) adjustStaffStatus.textContent = '已選擇成員，可直接預覽調整。';
        syncAdjustmentSubmitState();
    }

    function clearSelectedStaff(shouldClearSearchInput) {
        selectedStaff = null;
        if (adjustUserIdInput) adjustUserIdInput.value = '';
        if (adjustSelectedCard) adjustSelectedCard.hidden = true;
        if (shouldClearSearchInput && adjustSearchInput) adjustSearchInput.value = '';
        if (adjustStaffStatus) adjustStaffStatus.textContent = '輸入至少 1 個字元開始搜尋。';
        invalidateAdjustmentPreview();
    }

    async function loadStaffSnapshot(userId, fallbackMeta) {
        const normalizedUserId = String(userId || '').trim();
        if (!normalizedUserId) return;
        const currentIndex = snapshotRequestIndex + 1;
        snapshotRequestIndex = currentIndex;
        if (snapshotController) snapshotController.abort();
        snapshotController = new AbortController();
        try {
            const response = await getJson(`/management/salary-settings/adjustments/staff/${encodeURIComponent(normalizedUserId)}/snapshot`, snapshotController.signal);
            if (currentIndex !== snapshotRequestIndex) return;
            renderSelectedStaff(response.snapshot, fallbackMeta);
        } catch (error) {
            if (error.name === 'AbortError') return;
            clearSelectedStaff(false);
            if (adjustStaffStatus) adjustStaffStatus.textContent = String(error.message || error);
        }
    }

    function selectSearchCandidate(candidate) {
        if (!candidate || !adjustSearchInput) return;
        adjustSearchInput.value = `${candidate.displayName} (${candidate.userId})`;
        hideSearchResults();
        invalidateAdjustmentPreview();
        loadStaffSnapshot(candidate.userId, candidate);
    }

    function renderSearchResults(results) {
        if (!adjustStaffResults) return;
        adjustStaffResults.innerHTML = '';
        searchResults = Array.isArray(results) ? results : [];
        activeSearchIndex = -1;

        if (!searchResults.length) {
            hideSearchResults();
            if (adjustStaffStatus) adjustStaffStatus.textContent = '找不到符合條件的成員。';
            return;
        }

        const fragment = document.createDocumentFragment();
        searchResults.forEach((item, index) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'salary-search-item';
            button.setAttribute('role', 'option');
            button.dataset.index = String(index);

            const avatar = document.createElement('img');
            avatar.className = 'salary-search-avatar';
            avatar.src = item.avatarUrl || '/images/default-avatar.png';
            avatar.alt = '頭像';

            const textWrap = document.createElement('div');
            textWrap.className = 'salary-search-item-text';

            const title = document.createElement('div');
            title.className = 'salary-search-item-title';
            title.textContent = item.displayName;

            const sub = document.createElement('div');
            sub.className = 'salary-search-item-sub';
            const idSpan = document.createElement('span');
            idSpan.textContent = item.userId;
            const roleSpan = document.createElement('span');
            roleSpan.className = item.roleBadgeClass || 'role-badge role-badge-member';
            roleSpan.textContent = item.roleName || item.roleKey || '未知身分';
            sub.append(idSpan, roleSpan);
            textWrap.append(title, sub);
            button.append(avatar, textWrap);

            button.addEventListener('click', () => selectSearchCandidate(item));
            fragment.appendChild(button);
        });

        adjustStaffResults.appendChild(fragment);
        adjustStaffResults.hidden = false;
        if (adjustStaffStatus) adjustStaffStatus.textContent = `找到 ${searchResults.length} 位可調整成員。`;
    }

    function highlightSearchResult(nextIndex) {
        if (!adjustStaffResults || !searchResults.length) return;
        const boundedIndex = ((nextIndex % searchResults.length) + searchResults.length) % searchResults.length;
        activeSearchIndex = boundedIndex;
        adjustStaffResults.querySelectorAll('.salary-search-item').forEach((item, index) => {
            item.classList.toggle('is-active', index === boundedIndex);
        });
    }

    async function queryStaffCandidates(query) {
        const normalizedQuery = String(query || '').trim();
        if (!normalizedQuery) {
            hideSearchResults();
            if (adjustStaffStatus) adjustStaffStatus.textContent = '輸入至少 1 個字元開始搜尋。';
            return;
        }
        const currentIndex = searchRequestIndex + 1;
        searchRequestIndex = currentIndex;
        if (searchController) searchController.abort();
        searchController = new AbortController();

        if (adjustStaffStatus) adjustStaffStatus.textContent = '搜尋中...';
        try {
            const response = await getJson(`/management/salary-settings/adjustments/staff-search?q=${encodeURIComponent(normalizedQuery)}`, searchController.signal);
            if (currentIndex !== searchRequestIndex) return;
            renderSearchResults(response.results || []);
        } catch (error) {
            if (error.name === 'AbortError') return;
            hideSearchResults();
            if (adjustStaffStatus) adjustStaffStatus.textContent = String(error.message || error);
        }
    }

    if (adjustForm) {
        adjustForm.addEventListener('submit', event => {
            if (!adjustmentPreviewCurrent || !adjustPreviewToken || !adjustPreviewToken.value || !window.confirm('請確認薪資調整預覽內容，確定執行？')) {
                event.preventDefault();
                return;
            }
            if (adjustExecuteButton) adjustExecuteButton.disabled = true;
        });
    }

    if (adjustSearchInput) {
        adjustSearchInput.addEventListener('input', () => {
            if (searchTimer) clearTimeout(searchTimer);
            clearSelectedStaff(false);
            const keyword = String(adjustSearchInput.value || '').trim();
            searchTimer = setTimeout(() => { queryStaffCandidates(keyword); }, 260);
        });

        adjustSearchInput.addEventListener('keydown', event => {
            if (!searchResults.length) {
                if (event.key === 'Escape') hideSearchResults();
                return;
            }
            if (event.key === 'ArrowDown') {
                event.preventDefault();
                highlightSearchResult(activeSearchIndex + 1);
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                highlightSearchResult(activeSearchIndex - 1);
            } else if (event.key === 'Enter') {
                if (activeSearchIndex >= 0 && activeSearchIndex < searchResults.length) {
                    event.preventDefault();
                    selectSearchCandidate(searchResults[activeSearchIndex]);
                }
            } else if (event.key === 'Escape') {
                hideSearchResults();
            }
        });

        adjustSearchInput.addEventListener('blur', () => {
            window.setTimeout(() => hideSearchResults(), 120);
        });
    }

    if (adjustModeInput) adjustModeInput.addEventListener('change', invalidateAdjustmentPreview);
    if (adjustAmountInput) adjustAmountInput.addEventListener('input', invalidateAdjustmentPreview);
    if (adjustReasonInput) adjustReasonInput.addEventListener('input', invalidateAdjustmentPreview);

    if (adjustClearSelectionButton) {
        adjustClearSelectionButton.addEventListener('click', () => clearSelectedStaff(true));
    }

    if (adjustPreviewButton && adjustPreview) {
        adjustPreviewButton.addEventListener('click', async () => {
            try {
                const payload = {
                    user_id: adjustUserIdInput && adjustUserIdInput.value,
                    amount: adjustAmountInput && adjustAmountInput.value,
                    reason: adjustReasonInput && adjustReasonInput.value,
                    adjustment_mode: adjustModeInput && adjustModeInput.value
                };
                const result = await postJson('/management/salary-settings/adjustments/preview', payload);
                adjustPreview.hidden = false;
                adjustPreview.textContent = JSON.stringify(result.preview, null, 2);
                if (adjustPreviewToken) adjustPreviewToken.value = result.preview.previewToken;
                if (adjustRequestId) adjustRequestId.value = `salary-manual:${result.preview.previewToken}`;
                adjustmentPreviewCurrent = true;
                syncAdjustmentSubmitState();
            } catch (error) {
                adjustPreview.hidden = false;
                adjustPreview.textContent = String(error.message || error);
                adjustmentPreviewCurrent = false;
                if (adjustPreviewToken) adjustPreviewToken.value = '';
                syncAdjustmentSubmitState();
            }
        });
    }

    document.querySelectorAll('.salary-row-adjust').forEach(button => {
        button.addEventListener('click', () => {
            const candidate = {
                userId: button.dataset.userId,
                displayName: button.dataset.displayName || button.dataset.userId,
                roleName: button.dataset.roleName || button.dataset.roleKey || '未知身分',
                roleBadgeClass: button.dataset.roleBadgeClass || 'role-badge role-badge-member',
                avatarUrl: '/images/default-avatar.png'
            };
            if (adjustSearchInput) adjustSearchInput.value = `${candidate.displayName} (${candidate.userId})`;
            selectSearchCandidate(candidate);
            openModal('adjustSalaryModal');
        });
    });

    if (initialAdjustState && initialAdjustState.user_id) {
        const prefilledUserId = String(initialAdjustState.user_id || '').trim();
        if (prefilledUserId) {
            if (adjustSearchInput && !adjustSearchInput.value) adjustSearchInput.value = prefilledUserId;
            loadStaffSnapshot(prefilledUserId, {
                userId: prefilledUserId,
                displayName: prefilledUserId,
                roleName: '成員',
                roleBadgeClass: 'role-badge role-badge-member',
                avatarUrl: '/images/default-avatar.png'
            });
        }
    }

    syncAdjustmentSubmitState();

    const adjustModalElement = document.getElementById('adjustSalaryModal');
    if (adjustModalElement) {
        adjustModalElement.addEventListener('hidden.bs.modal', () => {
            hideSearchResults();
        });
    }

    const ruleForm = document.getElementById('salaryRuleForm');
    const addRuleButton = document.getElementById('addSalaryRuleButton');
    if (addRuleButton && ruleForm) {
        addRuleButton.addEventListener('click', () => {
            ruleForm.reset();
            document.getElementById('ruleId').value = '';
            document.getElementById('ruleMonth').value = '<%= month %>';
            document.getElementById('ruleDay').value = '1';
            document.getElementById('ruleItem').value = '固定月薪';
            document.getElementById('monthlySalaryRulesModalTitle').textContent = '新增固定月薪規則';
        });
    }

    document.querySelectorAll('.salary-rule-edit').forEach(button => button.addEventListener('click', () => {
        document.getElementById('ruleId').value = button.dataset.id;
        document.getElementById('ruleRole').value = button.dataset.role;
        document.getElementById('ruleItem').value = button.dataset.item;
        document.getElementById('ruleAmount').value = button.dataset.amount;
        document.getElementById('ruleDay').value = button.dataset.day;
        document.getElementById('ruleMonth').value = button.dataset.month;
        document.getElementById('ruleNote').value = button.dataset.note;
        document.getElementById('monthlySalaryRulesModalTitle').textContent = '編輯固定月薪規則';
        openModal('monthlySalaryRulesModal');
    }));

    document.querySelectorAll('form').forEach(form => {
        const confirmation = form.querySelector('[data-confirm]');
        if (!confirmation) return;
        form.addEventListener('submit', event => {
            if (!window.confirm(confirmation.dataset.confirm)) event.preventDefault();
        });
    });

    const distributeButton = document.getElementById('previewDistributeButton');
    const distributePreview = document.getElementById('distributePreview');
    const distributeForm = document.getElementById('salaryDistributeForm');
    const executeDistributeButton = document.getElementById('executeDistributeButton');
    let distributionPreviewCurrent = false;

    if (distributeButton && distributePreview) {
        distributeButton.addEventListener('click', async () => {
            if (distributionLocked) return;
            try {
                const payload = { month: document.getElementById('distMonth').value };
                const result = await postJson('/management/salary-settings/distribute/preview', payload);
                distributePreview.hidden = false;
                distributePreview.textContent = JSON.stringify(result.preview, null, 2);
                distributionPreviewCurrent = true;
            } catch (error) {
                distributePreview.hidden = false;
                distributePreview.textContent = String(error.message || error);
                distributionPreviewCurrent = false;
            }
        });
    }

    if (distributeForm) {
        distributeForm.addEventListener('input', () => {
            distributionPreviewCurrent = false;
        });
        distributeForm.addEventListener('submit', event => {
            if (distributionLocked || !distributionPreviewCurrent || !window.confirm('確認依照預覽派發固定月薪？')) {
                event.preventDefault();
                return;
            }
            if (executeDistributeButton) executeDistributeButton.disabled = true;
        });
    }

    const importExecuteForm = document.getElementById('salaryImportExecuteForm');
    if (importExecuteForm) {
        importExecuteForm.addEventListener('submit', event => {
            if (!window.confirm('確認整批匯入預覽中的薪資調整？')) {
                event.preventDefault();
                return;
            }
            const button = importExecuteForm.querySelector('button[type="submit"]');
            if (button) button.disabled = true;
        });
    }

    const historyBody = document.getElementById('salaryHistoryBody');
    const historyStatus = document.getElementById('salaryHistoryStatus');
    const historyPageInfo = document.getElementById('historyPageInfo');
    const historyPrevButton = document.getElementById('historyPrevButton');
    const historyNextButton = document.getElementById('historyNextButton');
    const historySearchInput = document.getElementById('historySearchInput');
    const historySearchButton = document.getElementById('historySearchButton');
    const historyClearFilter = document.getElementById('historyClearFilter');
    const historyModalElement = document.getElementById('salaryHistoryModal');
    const openFullHistoryButton = document.getElementById('openFullSalaryHistoryButton');

    const historyState = {
        page: 1,
        totalPages: 1,
        totalCount: 0,
        userId: '',
        displayName: '',
        query: '',
        loaded: false
    };

    let historyController = null;
    let historyRequestIndex = 0;

    function adjustmentTypeLabel(type) {
        if (type === 'manual') return '手動';
        if (type === 'import') return '匯入';
        if (type === 'distribution') return '固定月薪派發';
        return type || '未知';
    }

    function renderHistoryRows(rows) {
        if (!historyBody) return;
        if (!Array.isArray(rows) || rows.length === 0) {
            historyBody.innerHTML = '<tr><td colspan="8" class="text-center text-secondary py-4">查無符合條件的調整紀錄</td></tr>';
            return;
        }
        historyBody.innerHTML = rows.map(row => {
            const availableDelta = Number(row.availableDelta || 0);
            const historyDelta = Number(row.historyDelta || 0);
            const amount = Number(row.amount || 0);
            return `
                <tr>
                    <td>${escapeHtml(row.createdAt)}</td>
                    <td>${escapeHtml(row.displayName)} <span class="text-secondary">(${escapeHtml(row.userId)})</span></td>
                    <td>${escapeHtml(adjustmentTypeLabel(row.adjustmentType))}</td>
                    <td class="text-end ${availableDelta >= 0 ? 'text-success' : 'text-danger'}">${escapeHtml(formatSignedAmount(availableDelta))}</td>
                    <td class="text-end ${historyDelta >= 0 ? 'text-success' : 'text-danger'}">${escapeHtml(formatSignedAmount(historyDelta))}</td>
                    <td class="text-end ${amount >= 0 ? 'text-success' : 'text-danger'}">${escapeHtml(formatSignedAmount(amount))}</td>
                    <td>${escapeHtml(row.reason)}</td>
                    <td>${escapeHtml(row.operatorDisplayName || row.createdBy || '-')}</td>
                </tr>
            `;
        }).join('');
    }

    function syncHistoryPager() {
        if (historyPageInfo) {
            historyPageInfo.textContent = `第 ${historyState.page} / ${historyState.totalPages} 頁`;
        }
        if (historyPrevButton) historyPrevButton.disabled = historyState.page <= 1;
        if (historyNextButton) historyNextButton.disabled = historyState.page >= historyState.totalPages;
    }

    function openAllHistoryFromSummary() {
        historyState.userId = '';
        historyState.displayName = '';
        historyState.query = '';
        if (historySearchInput) historySearchInput.value = '';
        openModal('salaryHistoryModal');
        loadHistory(1);
    }

    async function loadHistory(page) {
        if (!historyBody) return;
        const targetPage = Math.max(1, Number(page || 1));
        historyRequestIndex += 1;
        const currentIndex = historyRequestIndex;
        if (historyController) historyController.abort();
        historyController = new AbortController();

        historyBody.innerHTML = '<tr><td colspan="8" class="text-center text-secondary py-4">載入中...</td></tr>';
        if (historyStatus) historyStatus.textContent = '查詢調整紀錄中...';
        syncHistoryPager();

        const params = new URLSearchParams({
            page: String(targetPage),
            page_size: '15'
        });
        const query = String(historyState.query || '').trim();
        if (historyState.userId) params.set('user_id', historyState.userId);
        if (query) params.set('q', query);

        try {
            const result = await getJson(`/management/salary-settings/adjustments/history?${params.toString()}`, historyController.signal);
            if (currentIndex !== historyRequestIndex) return;

            historyState.page = Number(result.page || 1);
            historyState.totalPages = Number(result.totalPages || 1);
            historyState.totalCount = Number(result.totalCount || 0);
            historyState.loaded = true;
            renderHistoryRows(result.rows || []);
            syncHistoryPager();

            if (historyStatus) {
                const userText = historyState.userId ? `成員：${historyState.displayName || historyState.userId}` : '全員';
                const queryText = query ? `，關鍵字：${query}` : '';
                historyStatus.textContent = `${userText}${queryText}，共 ${historyState.totalCount} 筆。`;
            }
        } catch (error) {
            if (error.name === 'AbortError') return;
            historyBody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4">${escapeHtml(String(error.message || error))}</td></tr>`;
            if (historyStatus) historyStatus.textContent = '讀取調整紀錄失敗，請稍後再試。';
        }
    }

    if (historySearchButton) {
        historySearchButton.addEventListener('click', () => {
            historyState.query = historySearchInput ? String(historySearchInput.value || '').trim() : '';
            loadHistory(1);
        });
    }

    if (historySearchInput) {
        historySearchInput.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                historyState.query = String(historySearchInput.value || '').trim();
                loadHistory(1);
            }
        });
    }

    if (historyClearFilter) {
        historyClearFilter.addEventListener('click', () => {
            historyState.userId = '';
            historyState.displayName = '';
            historyState.query = '';
            if (historySearchInput) historySearchInput.value = '';
            loadHistory(1);
        });
    }

    if (openFullHistoryButton) {
        openFullHistoryButton.addEventListener('click', () => {
            openAllHistoryFromSummary();
        });
    }

    if (historyPrevButton) {
        historyPrevButton.addEventListener('click', () => {
            if (historyState.page > 1) loadHistory(historyState.page - 1);
        });
    }

    if (historyNextButton) {
        historyNextButton.addEventListener('click', () => {
            if (historyState.page < historyState.totalPages) loadHistory(historyState.page + 1);
        });
    }

    document.querySelectorAll('.salary-row-history').forEach(button => {
        button.addEventListener('click', () => {
            historyState.userId = String(button.dataset.userId || '').trim();
            historyState.displayName = String(button.dataset.displayName || historyState.userId);
            historyState.query = '';
            if (historySearchInput) historySearchInput.value = '';
            openModal('salaryHistoryModal');
            loadHistory(1);
        });
    });

    if (historyModalElement) {
        historyModalElement.addEventListener('shown.bs.modal', () => {
            if (!historyState.loaded) loadHistory(1);
        });
    }

    if (hasImportPreview) openModal('batchImportSalaryModal');
    if (hasAdjustmentState) openModal('adjustSalaryModal');
    if (hasRuleState) openModal('monthlySalaryRulesModal');
    if (hasDistributionState) openModal('distributeBaseSalaryModal');
})();
</script>
</body>
</html>
