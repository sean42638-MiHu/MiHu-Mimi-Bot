<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>首頁 · 米胡電競 MiHu Gaming</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0914;
            --sidebar-bg: #131021;
            --card-bg: rgba(23, 19, 38, 0.85);
            --card-border: rgba(168, 85, 247, 0.2);
            --text-light: #f3f4f6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
            min-width: 0;
        }

        .content-body { 
            padding: 24px 36px 32px; 
            flex-grow: 1; 
        }

        /* 🚀 移除右側空白，使左右卡片 1:1 彈性等寬並排 */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
            margin-top: 20px;
            width: 100%;
        }
    </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<div class="main-wrapper">
    <%- include('partials/navbar', { activePage: 'dashboard' }) %>

    <div class="content-body">
        <%- include('partials/dashboard_announcement', { announcement: typeof announcement !== 'undefined' ? announcement : null }) %>

        <div class="dashboard-grid">
            <%- include('partials/dashboard_wallet_card', { user: typeof user !== 'undefined' && user ? user : currentUser, vipInfo: vipInfo }) %>
            <%- include('partials/dashboard_user_info', { user: typeof user !== 'undefined' && user ? user : currentUser }) %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>