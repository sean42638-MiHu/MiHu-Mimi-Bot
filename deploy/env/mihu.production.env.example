# Copy to /etc/mihu/mihu.env only after Production owner approval.
# This shared file intentionally does not set MIHU_RUNTIME_ROLE; use per-service env files.
NODE_ENV=production
APP_ENV=production
PORT=3000
WEB_LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=<1-direct-or-2-cloudflare-plus-nginx>
SQLITE_BUSY_TIMEOUT_MS=5000

# Provision these directories/files on the persistent VPS volume before starting services.
DATABASE_PATH=/var/lib/mihu/database.sqlite
PRODUCTION_DATA_DIR=/var/lib/mihu/data
DATABASE_BACKUP_DIR=/var/backups/mihu

# Set the exact approved public origin and OAuth callback after domain selection.
PUBLIC_BASE_URL=https://<APPROVED_DOMAIN>
DISCORD_CALLBACK_URL=https://<APPROVED_DOMAIN>/auth/discord/callback

# Secret-provider placeholders; replace out-of-band, never commit real values.
SESSION_SECRET=<SECRET_FROM_SECRET_MANAGER_MIN_32_CHARS>
PAYROLL_DATA_ENCRYPTION_KEY=<32_BYTE_SECRET_FROM_SECRET_MANAGER>
PLATFORM_SUPERUSER_ID=<APPROVED_PLATFORM_USER_ID>
DISCORD_CLIENT_ID=<DISCORD_APPLICATION_ID>
DISCORD_CLIENT_SECRET=<SECRET_FROM_SECRET_MANAGER>
DISCORD_BOT_TOKEN=<SECRET_FROM_SECRET_MANAGER>

# Guild IDs are deployment configuration; use explicit values from the approved Discord environments.
GUILD_MAIN_ID=<PRODUCTION_MAIN_GUILD_ID>
GUILD_STAFF_ID=<PRODUCTION_STAFF_GUILD_ID>
GUILD_REVIEW_ID=<REVIEW_GUILD_ID_OR_EMPTY>
GUILD_DEV_ID=<DEVELOPMENT_GUILD_ID_OR_EMPTY>

DISCORD_ENABLED=false
DISCORD_COMMAND_REGISTRATION_ENABLED=false
DISCORD_COMMAND_CLEAR_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# One-shot operator confirmations are deliberately not preconfigured:
# PRODUCTION_IDENTITY_VERIFIED
# PRODUCTION_STORAGE_VERIFIED
# PRODUCTION_PREFLIGHT_CONFIRM
# PRODUCTION_WRITES_DISABLED
# BACKUP_CONFIRM / BACKUP_STORAGE_VERIFIED
# MIGRATION_CONFIRM / MIGRATION_BACKUP_MANIFEST
# RESTORE_CONFIRM / RESTORE_BACKUP_MANIFEST / PRE_RESTORE_BACKUP_MANIFEST
