# Template only. Replace the TLS file paths and select the real domain after owner approval.
# This does not request certificates or change DNS.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    client_max_body_size 10m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/acme-challenge;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Enable only after a certificate is provisioned through the approved process.
# Set server_name to the confirmed Production domain; do not leave the catch-all for public use.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name _;

    ssl_certificate /etc/nginx/tls/mihu/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/mihu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
}
